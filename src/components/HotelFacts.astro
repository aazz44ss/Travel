---
import type { HotelFact } from '~/data/hotel-schema';

interface Props {
  facts: HotelFact[];
}

const { facts } = Astro.props;
---

<dl class="not-prose my-8 grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-line bg-line lg:grid-cols-3">
  {
    facts.map((fact) => (
      <div class="bg-card px-4 py-5 sm:px-5">
        <dt class="text-2xs font-medium tracking-[0.12em] text-ink-faint uppercase">
          {fact.label}
        </dt>
        <dd class="mt-1.5 font-serif text-lg font-bold text-brand-deep sm:text-xl">{fact.value}</dd>
        <dd class="mt-1 text-xs leading-relaxed text-ink-faint">{fact.sub}</dd>
      </div>
    ))
  }
</dl>
