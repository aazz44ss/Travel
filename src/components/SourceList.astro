---
interface Source {
  label: string;
  url: string;
  kind: 'official' | 'blog' | 'social' | 'media';
}

interface Props {
  sources: Source[];
}

const { sources } = Astro.props;

const kindLabel: Record<Source['kind'], string> = {
  official: '官方',
  blog: '部落格',
  social: '社群',
  media: '媒體',
};

const kindStyle: Record<Source['kind'], string> = {
  official: 'bg-brand text-white',
  blog: 'bg-paper-deep text-ink-soft',
  social: 'bg-berry-soft text-berry',
  media: 'bg-gold-soft text-gold',
};

const order: Source['kind'][] = ['official', 'media', 'blog', 'social'];
const sorted = [...sources].sort((a, b) => order.indexOf(a.kind) - order.indexOf(b.kind));
---

{
  sorted.length > 0 && (
    <section class="mt-16 rounded-2xl border border-line bg-paper-deep/40 p-6 sm:p-8">
      <h2 class="font-serif text-lg font-bold text-ink">資料來源</h2>
      <p class="mt-1.5 text-sm text-ink-soft">
        本文交叉查證下列資料。規格與價格請以出發前的官方公告為準。
      </p>
      <ul class="mt-5 space-y-2.5">
        {sorted.map((source) => (
          <li class="flex flex-wrap items-baseline gap-2.5">
            <span
              class:list={[
                'shrink-0 rounded-full px-2 py-0.5 text-2xs font-bold',
                kindStyle[source.kind],
              ]}
            >
              {kindLabel[source.kind]}
            </span>
            <a
              href={source.url}
              rel="noopener nofollow"
              target="_blank"
              class="text-sm text-brand underline decoration-brand/30 underline-offset-4 transition-colors hover:text-gold hover:decoration-gold"
            >
              {source.label}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
