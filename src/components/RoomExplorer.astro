---
import { CATEGORIES, ROOMS, VIEWS, formatYen, type Room } from '~/data/tokyo-disneyland-hotel';
import { DEFAULT_LOCALE, type Locale } from '~/i18n/config';
import { explorer } from '~/i18n/explorer';
import {
  CATEGORY_LABELS,
  VIEW_LABELS,
  bedSummary,
  fieldSeparator,
  floorRange,
  roomName,
  roomNameSecondary,
} from '~/i18n/rooms';
import { annualRange } from '~/data/tdh-rates';
import { ROOM_NUMBERS } from '~/data/tdh-room-numbers';
import RoomLayout from '~/components/RoomLayout.astro';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const ex = explorer(locale);
const categoryLabel = CATEGORY_LABELS[locale];
const viewLabel = VIEW_LABELS[locale];

const viewStyle: Record<string, string> = {
  grand: 'bg-brand text-white',
  park: 'bg-brand-soft text-brand-deep',
  none: 'bg-paper-deep text-ink-faint',
};

const categoryStyle: Record<string, string> = {
  standard: 'border-line text-ink-soft',
  character: 'border-berry/30 text-berry',
  concierge: 'border-gold/40 text-gold',
  suite: 'border-brand/30 text-brand',
};

const capacityOptions = ex.capacityOptions;

/** Counted rather than written down so the figure cannot drift from the data. */
const numbered = Object.values(ROOM_NUMBERS).reduce((sum, entry) => sum + entry.numbers.length, 0);

/**
 * Grouped in the same order as the category filter, cheapest first inside each
 * group, so reading straight down keeps all the character rooms together. The
 * order is fixed: filtering hides cards but never reshuffles them.
 */
const grouped = CATEGORIES.map((category) => ({
  ...category,
  rooms: ROOMS.filter((room) => room.category === category.key).sort(
    (a, b) => a.priceFrom - b.priceFrom,
  ),
})).filter((group) => group.rooms.length > 0);

function features(room: Room): string[] {
  const list: string[] = [];
  if (room.alcove) list.push(ex.features.alcove);
  if (room.balcony) list.push(ex.features.balcony);
  if (room.lounge) list.push(ex.features.lounge);
  if (room.breakfast) list.push(ex.features.breakfast);
  if (room.accessible) list.push(ex.features.accessible);
  return list;
}
---

<section
  id="room-explorer"
  class="not-prose scroll-mt-24"
  data-room-explorer
  data-type-count={ex.typeCount(0).replace('0', '{n}')}
>
  <div class="rounded-2xl border border-line bg-card p-5 sm:p-7">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 class="font-serif text-xl font-bold text-ink sm:text-2xl">{ex.heading}</h2>
        <p class="mt-1.5 text-sm text-ink-soft">
          {ex.intro(ROOMS.length)}
        </p>
        <p class="mt-2 max-w-2xl text-xs leading-relaxed text-ink-faint">
          {ex.naming(numbered)}
        </p>
      </div>
      <p
        class="rounded-full bg-brand-soft px-3.5 py-1.5 text-sm font-medium text-brand-deep"
        data-result-count
        aria-live="polite"
      >
        {ex.typeCount(ROOMS.length)}
      </p>
    </div>

    <div class="mt-6 space-y-5 border-t border-line-soft pt-6">
      <fieldset>
        <legend class="text-2xs font-bold tracking-[0.15em] text-ink-faint uppercase">{ex.filters.category}</legend>
        <div class="mt-2.5 flex flex-wrap gap-2">
          {
            [{ key: 'all', label: ex.filters.all }, ...CATEGORIES.map((c) => ({ key: c.key, label: categoryLabel[c.key]! }))].map(
              (option, index) => (
                <label class="cursor-pointer">
                  <input
                    type="radio"
                    name="filter-category"
                    value={option.key}
                    checked={index === 0}
                    class="peer sr-only"
                  />
                  <span class="block rounded-full border border-line px-3.5 py-1.5 text-sm text-ink-soft transition-colors peer-checked:border-brand peer-checked:bg-brand peer-checked:text-white peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-brand hover:bg-paper-deep">
                    {option.label}
                  </span>
                </label>
              ),
            )
          }
        </div>
      </fieldset>

      <fieldset>
        <legend class="text-2xs font-bold tracking-[0.15em] text-ink-faint uppercase">{ex.filters.view}</legend>
        <div class="mt-2.5 flex flex-wrap gap-2">
          {
            [{ key: 'all', label: ex.filters.all }, ...VIEWS.map((v) => ({ key: v.key, label: viewLabel[v.key]! }))].map(
              (option, index) => (
                <label class="cursor-pointer">
                  <input
                    type="radio"
                    name="filter-view"
                    value={option.key}
                    checked={index === 0}
                    class="peer sr-only"
                  />
                  <span class="block rounded-full border border-line px-3.5 py-1.5 text-sm text-ink-soft transition-colors peer-checked:border-brand peer-checked:bg-brand peer-checked:text-white peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-brand hover:bg-paper-deep">
                    {option.label}
                  </span>
                </label>
              ),
            )
          }
        </div>
      </fieldset>

      <div class="grid gap-5 sm:grid-cols-2">
        <fieldset>
          <legend class="text-2xs font-bold tracking-[0.15em] text-ink-faint uppercase">
            {ex.filters.capacity}
          </legend>
          <div class="mt-2.5 flex flex-wrap gap-2">
            {
              capacityOptions.map((option, index) => (
                <label class="cursor-pointer">
                  <input
                    type="radio"
                    name="filter-capacity"
                    value={option.value}
                    checked={index === 0}
                    class="peer sr-only"
                  />
                  <span class="block rounded-full border border-line px-3 py-1.5 text-sm text-ink-soft transition-colors peer-checked:border-brand peer-checked:bg-brand peer-checked:text-white peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-brand hover:bg-paper-deep">
                    {option.label}
                  </span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <fieldset>
          <legend class="text-2xs font-bold tracking-[0.15em] text-ink-faint uppercase">
            {ex.filters.features}
          </legend>
          <div class="mt-2.5 flex flex-wrap gap-2">
            {
              [
                { key: 'alcove', label: ex.features.alcove },
                { key: 'balcony', label: ex.features.balcony },
                { key: 'breakfast', label: ex.features.breakfast },
              ].map((option) => (
                <label class="cursor-pointer">
                  <input type="checkbox" name="filter-flag" value={option.key} class="peer sr-only" />
                  <span class="block rounded-full border border-line px-3 py-1.5 text-sm text-ink-soft transition-colors peer-checked:border-gold peer-checked:bg-gold peer-checked:text-white peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-gold hover:bg-paper-deep">
                    {option.label}
                  </span>
                </label>
              ))
            }
          </div>
        </fieldset>
      </div>

      <div class="flex flex-wrap items-center gap-3 border-t border-line-soft pt-5">
        <p class="text-sm text-ink-soft">{ex.order}</p>
        <button
          type="button"
          data-reset
          class="ml-auto rounded-full border border-line px-3.5 py-1.5 text-sm text-ink-soft transition-colors hover:bg-paper-deep hover:text-ink"
        >
          {ex.reset}
        </button>
      </div>
    </div>
  </div>

  <ul class="mt-6 grid gap-4 md:grid-cols-2" data-room-list>
    {
      grouped.flatMap((group) => [
        <li class="md:col-span-2" data-group={group.key}>
          <h3 class="flex flex-wrap items-baseline gap-x-2.5 gap-y-1 border-b border-line pb-2 font-serif text-base font-bold text-ink">
            {group.label}
            <span class="text-xs font-normal text-ink-faint" data-group-count>
              {ex.typeCount(group.rooms.length)}
            </span>
          </h3>
        </li>,
        ...group.rooms.map((room) => (
        <li
          class="group flex h-full flex-col rounded-xl border border-line bg-card p-5 transition-shadow duration-300 hover:shadow-lg hover:shadow-ink/5"
          data-room
          data-category={room.category}
          data-view={room.view}
          data-capacity={room.capacity}
          data-alcove={String(room.alcove)}
          data-balcony={String(room.balcony)}
          data-breakfast={String(room.breakfast)}
        >
          <div class="flex flex-wrap items-center gap-1.5">
            <span
              class:list={[
                'rounded-full px-2.5 py-1 text-2xs font-bold',
                viewStyle[room.view],
              ]}
            >
              {viewLabel[room.view]}
            </span>
            <span
              class:list={[
                'rounded-full border px-2.5 py-1 text-2xs font-medium',
                categoryStyle[room.category],
              ]}
            >
              {categoryLabel[room.category]}
            </span>
            {features(room).map((feature) => (
              <span class="rounded-full bg-paper-deep px-2.5 py-1 text-2xs text-ink-soft">
                {feature}
              </span>
            ))}
          </div>

          <h3 class="mt-3 font-serif text-[1.0625rem] leading-snug font-bold text-ink">
            {roomName(room, locale)}
          </h3>
          <p class="mt-1 text-xs text-ink-faint">{roomNameSecondary(room, locale)}</p>

          <RoomLayout room={room} locale={locale} />

          <dl class="mt-4 grid grid-cols-3 gap-3 border-y border-line-soft py-3 text-center">
            <div>
              <dt class="text-2xs text-ink-faint">{ex.fields.area}</dt>
              <dd class="mt-0.5 text-sm font-bold text-ink">
                {room.size}
                <span class="text-xs font-normal"> m²</span>
              </dd>
            </div>
            <div class="border-x border-line-soft">
              <dt class="text-2xs text-ink-faint">{ex.fields.capacity}</dt>
              <dd class="mt-0.5 text-sm font-bold text-ink">
                {room.capacity}
                <span class="text-xs font-normal">{ex.guests}</span>
              </dd>
            </div>
            <div>
              <dt class="text-2xs text-ink-faint">{ex.fields.priceRange}</dt>
              <dd class="mt-0.5 text-sm font-bold text-brand">
                {annualRange(room.id)
                  ? `${formatYen(annualRange(room.id)![0])}–${formatYen(annualRange(room.id)![1])}`
                  : ex.from(formatYen(room.priceFrom))}
              </dd>
            </div>
          </dl>

          <p class="mt-3 text-[0.8125rem] leading-relaxed text-ink-soft">
            <span class="font-medium text-ink">{ex.fields.beds}{fieldSeparator(locale)}</span>
            {bedSummary(room, locale)}
          </p>
          {room.floors && (
            <p class="mt-1 text-[0.8125rem] leading-relaxed text-ink-soft">
              <span class="font-medium text-ink">{ex.fields.floors}{fieldSeparator(locale)}</span>
              {floorRange(room.floors, locale)}
            </p>
          )}

          {locale === 'zh-hant' && (
            <p class="mt-3 border-l-2 border-gold pl-3 text-[0.8125rem] leading-relaxed text-ink">{room.verdict}</p>
          )}

          {locale === 'zh-hant' && room.note && (
            <p class="mt-3 rounded-lg bg-paper-deep/70 px-3 py-2 text-xs leading-relaxed text-ink-soft">
              {room.note}
            </p>
          )}

          {ROOM_NUMBERS[room.id] && (
            <details class="group/numbers mt-3 rounded-lg border border-line-soft">
              <summary class="flex cursor-pointer list-none items-center gap-2 px-3 py-2 text-xs text-ink-soft transition-colors hover:bg-paper-deep/50">
                <svg
                  width="10"
                  height="10"
                  viewBox="0 0 10 10"
                  fill="none"
                  class="shrink-0 transition-transform duration-200 group-open/numbers:rotate-45"
                  aria-hidden="true"
                >
                  <path d="M5 1v8M1 5h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                </svg>
                {ex.roomNumbers}
                {ROOM_NUMBERS[room.id]!.numbers.length > 0 ? (
                  <span class="font-medium text-ink">
                    {ex.roomCount(ROOM_NUMBERS[room.id]!.numbers.length)}
                  </span>
                ) : (
                  <span class="text-ink-faint">{ex.notListed}</span>
                )}
                {!ROOM_NUMBERS[room.id]!.complete && (
                  <span class="rounded-full bg-paper-deep px-1.5 py-0.5 text-2xs text-ink-faint">
                    {ex.incomplete}
                  </span>
                )}
              </summary>
              <div class="border-t border-line-soft px-3 py-2.5">
                {ROOM_NUMBERS[room.id]!.numbers.length > 0 && (
                  <ul class="flex flex-wrap gap-1">
                    {ROOM_NUMBERS[room.id]!.numbers.map((number) => (
                      <li
                        class:list={[
                          'rounded px-1.5 py-0.5 text-2xs tabular-nums',
                          ROOM_NUMBERS[room.id]!.balcony.includes(number)
                            ? 'bg-gold-soft font-bold text-gold'
                            : 'bg-paper-deep text-ink-soft',
                        ]}
                        title={
                          ROOM_NUMBERS[room.id]!.balcony.includes(number)
                            ? ex.balconyTitle
                            : undefined
                        }
                      >
                        {number}
                      </li>
                    ))}
                  </ul>
                )}
                {ROOM_NUMBERS[room.id]!.balcony.length > 0 && (
                  <p class="mt-2 text-2xs text-gold">{ex.balconyNumbers}</p>
                )}
                {locale === 'zh-hant' && ROOM_NUMBERS[room.id]!.note && (
                  <p class="mt-2 text-2xs leading-relaxed text-ink-faint">
                    {ROOM_NUMBERS[room.id]!.note}
                  </p>
                )}
              </div>
            </details>
          )}


        </li>
        )),
      ])
    }
  </ul>

  <p
    class="hidden rounded-xl border border-dashed border-line bg-paper-deep/40 px-5 py-10 text-center text-sm text-ink-soft"
    data-empty
  >
    {ex.empty}
  </p>
</section>

<script>
  type Flag = 'alcove' | 'balcony' | 'breakfast';

  function initRoomExplorer(root: HTMLElement) {
    const list = root.querySelector<HTMLElement>('[data-room-list]');
    const empty = root.querySelector<HTMLElement>('[data-empty]');
    const count = root.querySelector<HTMLElement>('[data-result-count]');
    const resetButton = root.querySelector<HTMLButtonElement>('[data-reset]');
    if (!list || !empty || !count || !resetButton) return;

    const roomList = list;
    const emptyState = empty;
    const resultCount = count;
    const cards = Array.from(roomList.querySelectorAll<HTMLElement>('[data-room]'));
    const groups = Array.from(roomList.querySelectorAll<HTMLElement>('[data-group]'));

    function selected(name: string): string {
      const input = root.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`);
      return input?.value ?? 'all';
    }

    function activeFlags(): Flag[] {
      return Array.from(
        root.querySelectorAll<HTMLInputElement>('input[name="filter-flag"]:checked'),
      ).map((input) => input.value as Flag);
    }

    function apply() {
      const category = selected('filter-category');
      const view = selected('filter-view');
      const capacity = Number(selected('filter-capacity')) || 0;
      const flags = activeFlags();

      let visible = 0;
      for (const card of cards) {
        const matches =
          (category === 'all' || card.dataset.category === category) &&
          (view === 'all' || card.dataset.view === view) &&
          Number(card.dataset.capacity) >= capacity &&
          flags.every((flag) => card.dataset[flag] === 'true');

        card.hidden = !matches;
        if (matches) visible += 1;
      }

      resultCount.textContent = (root.dataset.typeCount ?? '{n}').replace('{n}', String(visible));
      emptyState.classList.toggle('hidden', visible > 0);
      roomList.classList.toggle('hidden', visible === 0);

      // A heading is only useful while its group still has something under it.
      for (const group of groups) {
        const shown = cards.filter(
          (card) => card.dataset.category === group.dataset.group && !card.hidden,
        ).length;
        group.hidden = shown === 0;
        const tally = group.querySelector('[data-group-count]');
        if (tally) tally.textContent = (root.dataset.typeCount ?? '{n}').replace('{n}', String(shown));
      }
    }

    root.addEventListener('change', apply);

    resetButton.addEventListener('click', () => {
      root
        .querySelectorAll<HTMLInputElement>('input[type="radio"][value="all"], input[value="0"]')
        .forEach((input) => (input.checked = true));
      root
        .querySelectorAll<HTMLInputElement>('input[name="filter-flag"]')
        .forEach((input) => (input.checked = false));
      apply();
    });

    apply();
  }

  document
    .querySelectorAll<HTMLElement>('[data-room-explorer]')
    .forEach((root) => initRoomExplorer(root));
</script>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>
