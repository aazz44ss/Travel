---
import type { Room, RoomCategory, RoomView } from '~/data/hotel-schema';
import { formatYen, toTwd } from '~/data/hotel-schema';
import RoomLayout from '~/components/RoomLayout.astro';

/** The hotel's own plan drawing for one room type, hotlinked from the resort CDN. */
export interface LayoutRef {
  src: string;
  href: string;
  width: number;
  height: number;
  /** True when the official page's drawing covers more than one of our variants. */
  shared: boolean;
}

/** Known room numbers for one room type. */
export interface NumbersRef {
  numbers: string[];
  /** Numbers worth calling out, e.g. the ones with balcony access. */
  highlight?: string[];
  highlightNote?: string;
  /** False when the source could not enumerate every room in the category. */
  complete: boolean;
  note?: string;
}

interface Props {
  rooms: Room[];
  categories: RoomCategory[];
  views: RoomView[];
  /** Tailwind classes for the view badge, keyed by view key. */
  viewStyle: Record<string, string>;
  /** Tailwind classes for the category badge, keyed by category key. */
  categoryStyle: Record<string, string>;
  intro: string;
  footnote: string;
  /** Cheapest-to-dearest published range for a room type, when one exists. */
  priceRange?: (id: string) => readonly [number, number] | undefined;
  layout?: (id: string) => LayoutRef | undefined;
  numbers?: (id: string) => NumbersRef | undefined;
}

const {
  rooms,
  categories,
  views,
  viewStyle,
  categoryStyle,
  intro,
  footnote,
  priceRange,
  layout,
  numbers,
} = Astro.props;

const categoryLabel = Object.fromEntries(categories.map((c) => [c.key, c.label]));
const viewLabel = Object.fromEntries(views.map((v) => [v.key, v.label]));

/**
 * Derived from the data so the filter can never offer a threshold that matches
 * nothing, or miss one that would.
 */
const capacities = [...new Set(rooms.map((room) => room.capacity))].sort((a, b) => a - b);
const capacityOptions = [
  { value: '0', label: '不限' },
  ...capacities.map((n) => ({
    value: String(n),
    label: n === capacities.at(-1) ? `${n} 人` : `${n} 人以上`,
  })),
];

const FLAGS = [
  { key: 'alcove', label: '凹室床' },
  { key: 'balcony', label: '陽台' },
  { key: 'breakfast', label: '含早餐' },
] as const;
const flags = FLAGS.filter((flag) => rooms.some((room) => room[flag.key]));

/**
 * Grouped in the same order as the category filter, cheapest first inside each
 * group, so reading straight down keeps all of one category together. The order
 * is fixed: filtering hides cards but never reshuffles them.
 */
const grouped = categories
  .map((category) => ({
    ...category,
    entries: rooms
      .filter((room) => room.category === category.key)
      .sort((a, b) => a.priceFrom - b.priceFrom)
      .map((room) => ({
        room,
        layout: layout?.(room.id),
        numbers: numbers?.(room.id),
        range: priceRange?.(room.id),
      })),
  }))
  .filter((group) => group.entries.length > 0);

function features(room: Room): string[] {
  const list: string[] = [];
  if (room.alcove) list.push('凹室床');
  if (room.balcony) list.push('陽台');
  if (room.lounge) list.push('貴賓室');
  if (room.breakfast) list.push('含早餐');
  if (room.accessible) list.push('無障礙');
  return list;
}
---

<section id="room-explorer" class="not-prose scroll-mt-24" data-room-explorer>
  <div class="rounded-2xl border border-line bg-card p-5 sm:p-7">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 class="font-serif text-xl font-bold text-ink sm:text-2xl">房型探索器</h2>
        <p class="mt-1.5 max-w-2xl text-sm leading-relaxed text-ink-soft">{intro}</p>
        <p class="mt-2 max-w-2xl text-xs leading-relaxed text-ink-faint">{footnote}</p>
      </div>
      <p
        class="rounded-full bg-brand-soft px-3.5 py-1.5 text-sm font-medium text-brand-deep"
        data-result-count
        aria-live="polite"
      >
        {rooms.length} 種房型
      </p>
    </div>

    <div class="mt-6 space-y-5 border-t border-line-soft pt-6">
      <fieldset>
        <legend class="text-2xs font-bold tracking-[0.15em] text-ink-faint uppercase">分類</legend>
        <div class="mt-2.5 flex flex-wrap gap-2">
          {
            [{ key: 'all', label: '全部' }, ...categories.map((c) => ({ key: c.key, label: c.label }))].map(
              (option, index) => (
                <label class="cursor-pointer">
                  <input
                    type="radio"
                    name="filter-category"
                    value={option.key}
                    checked={index === 0}
                    class="peer sr-only"
                  />
                  <span class="block rounded-full border border-line px-3.5 py-1.5 text-sm text-ink-soft transition-colors peer-checked:border-brand peer-checked:bg-brand peer-checked:text-white peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-brand hover:bg-paper-deep">
                    {option.label}
                  </span>
                </label>
              ),
            )
          }
        </div>
      </fieldset>

      <fieldset>
        <legend class="text-2xs font-bold tracking-[0.15em] text-ink-faint uppercase">景觀</legend>
        <div class="mt-2.5 flex flex-wrap gap-2">
          {
            [{ key: 'all', label: '全部' }, ...views.map((v) => ({ key: v.key, label: v.label }))].map(
              (option, index) => (
                <label class="cursor-pointer">
                  <input
                    type="radio"
                    name="filter-view"
                    value={option.key}
                    checked={index === 0}
                    class="peer sr-only"
                  />
                  <span class="block rounded-full border border-line px-3.5 py-1.5 text-sm text-ink-soft transition-colors peer-checked:border-brand peer-checked:bg-brand peer-checked:text-white peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-brand hover:bg-paper-deep">
                    {option.label}
                  </span>
                </label>
              ),
            )
          }
        </div>
      </fieldset>

      <div class="grid gap-5 sm:grid-cols-2">
        <fieldset>
          <legend class="text-2xs font-bold tracking-[0.15em] text-ink-faint uppercase">
            入住人數
          </legend>
          <div class="mt-2.5 flex flex-wrap gap-2">
            {
              capacityOptions.map((option, index) => (
                <label class="cursor-pointer">
                  <input
                    type="radio"
                    name="filter-capacity"
                    value={option.value}
                    checked={index === 0}
                    class="peer sr-only"
                  />
                  <span class="block rounded-full border border-line px-3 py-1.5 text-sm text-ink-soft transition-colors peer-checked:border-brand peer-checked:bg-brand peer-checked:text-white peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-brand hover:bg-paper-deep">
                    {option.label}
                  </span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <fieldset>
          <legend class="text-2xs font-bold tracking-[0.15em] text-ink-faint uppercase">
            必要條件
          </legend>
          <div class="mt-2.5 flex flex-wrap gap-2">
            {
              flags.map((option) => (
                <label class="cursor-pointer">
                  <input type="checkbox" name="filter-flag" value={option.key} class="peer sr-only" />
                  <span class="block rounded-full border border-line px-3 py-1.5 text-sm text-ink-soft transition-colors peer-checked:border-gold peer-checked:bg-gold peer-checked:text-white peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-gold hover:bg-paper-deep">
                    {option.label}
                  </span>
                </label>
              ))
            }
          </div>
        </fieldset>
      </div>

      <div class="flex flex-wrap items-center gap-3 border-t border-line-soft pt-5">
        <p class="text-sm text-ink-soft">依分類排列，每一類裡由便宜到貴</p>
        <button
          type="button"
          data-reset
          class="ml-auto rounded-full border border-line px-3.5 py-1.5 text-sm text-ink-soft transition-colors hover:bg-paper-deep hover:text-ink"
        >
          清除條件
        </button>
      </div>
    </div>
  </div>

  <ul class="mt-6 grid gap-4 md:grid-cols-2" data-room-list>
    {
      grouped.flatMap((group) => [
        <li class="md:col-span-2" data-group={group.key}>
          <h3 class="flex flex-wrap items-baseline gap-x-2.5 gap-y-1 border-b border-line pb-2 font-serif text-base font-bold text-ink">
            {group.label}
            <span class="text-xs font-normal text-ink-faint" data-group-count>
              {group.entries.length} 種
            </span>
          </h3>
        </li>,
        ...group.entries.map(({ room, layout: plan, numbers: rooming, range }) => (
        <li
          class="group flex h-full flex-col rounded-xl border border-line bg-card p-5 transition-shadow duration-300 hover:shadow-lg hover:shadow-ink/5"
          data-room
          data-category={room.category}
          data-view={room.view}
          data-capacity={room.capacity}
          data-alcove={String(room.alcove)}
          data-balcony={String(room.balcony)}
          data-breakfast={String(room.breakfast)}
        >
          <div class="flex flex-wrap items-center gap-1.5">
            <span
              class:list={[
                'rounded-full px-2.5 py-1 text-2xs font-bold',
                viewStyle[room.view],
              ]}
            >
              {viewLabel[room.view]}
            </span>
            <span
              class:list={[
                'rounded-full border px-2.5 py-1 text-2xs font-medium',
                categoryStyle[room.category],
              ]}
            >
              {categoryLabel[room.category]}
            </span>
            {features(room).map((feature) => (
              <span class="rounded-full bg-paper-deep px-2.5 py-1 text-2xs text-ink-soft">
                {feature}
              </span>
            ))}
          </div>

          <h3 class="mt-3 font-serif text-[1.0625rem] leading-snug font-bold text-ink">
            {room.name}
          </h3>
          <p class="mt-1 text-xs text-ink-faint">{room.nameJa}</p>

          {plan && <RoomLayout room={room} {...plan} />}

          <dl class="mt-4 grid grid-cols-3 gap-3 border-y border-line-soft py-3 text-center">
            <div>
              <dt class="text-2xs text-ink-faint">面積</dt>
              <dd class="mt-0.5 text-sm font-bold text-ink">
                {room.size}
                <span class="text-xs font-normal"> m²</span>
              </dd>
            </div>
            <div class="border-x border-line-soft">
              <dt class="text-2xs text-ink-faint">人數上限</dt>
              <dd class="mt-0.5 text-sm font-bold text-ink">
                {room.capacity}
                <span class="text-xs font-normal"> 位</span>
              </dd>
            </div>
            <div>
              <dt class="text-2xs text-ink-faint">價格區間</dt>
              <dd class="mt-0.5 text-sm font-bold text-brand">
                {range ? `${formatYen(range[0])}–${formatYen(range[1])}` : `${formatYen(room.priceFrom)} 起`}
              </dd>
            </div>
          </dl>

          <p class="mt-3 text-[0.8125rem] leading-relaxed text-ink-soft">
            <span class="font-medium text-ink">床型：</span>
            {room.beds}
          </p>
          {room.floors && (
            <p class="mt-1 text-[0.8125rem] leading-relaxed text-ink-soft">
              <span class="font-medium text-ink">分佈樓層：</span>
              {room.floors}
            </p>
          )}

          <p class="mt-3 border-l-2 border-gold pl-3 text-[0.8125rem] leading-relaxed text-ink">
            {room.verdict}
          </p>

          {room.note && (
            <p class="mt-3 rounded-lg bg-paper-deep/70 px-3 py-2 text-xs leading-relaxed text-ink-soft">
              {room.note}
            </p>
          )}

          {rooming && (
            <details class="group/numbers mt-3 rounded-lg border border-line-soft">
              <summary class="flex cursor-pointer list-none items-center gap-2 px-3 py-2 text-xs text-ink-soft transition-colors hover:bg-paper-deep/50">
                <svg
                  width="10"
                  height="10"
                  viewBox="0 0 10 10"
                  fill="none"
                  class="shrink-0 transition-transform duration-200 group-open/numbers:rotate-45"
                  aria-hidden="true"
                >
                  <path d="M5 1v8M1 5h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                </svg>
                房號
                {rooming.numbers.length > 0 ? (
                  <span class="font-medium text-ink">{rooming.numbers.length} 間</span>
                ) : (
                  <span class="text-ink-faint">未逐間公布</span>
                )}
                {!rooming.complete && (
                  <span class="rounded-full bg-paper-deep px-1.5 py-0.5 text-2xs text-ink-faint">
                    不完整
                  </span>
                )}
              </summary>
              <div class="border-t border-line-soft px-3 py-2.5">
                {rooming.numbers.length > 0 && (
                  <ul class="flex flex-wrap gap-1">
                    {rooming.numbers.map((number) => (
                      <li
                        class:list={[
                          'rounded px-1.5 py-0.5 text-2xs tabular-nums',
                          rooming.highlight?.includes(number)
                            ? 'bg-gold-soft font-bold text-gold'
                            : 'bg-paper-deep text-ink-soft',
                        ]}
                        title={rooming.highlight?.includes(number) ? rooming.highlightNote : undefined}
                      >
                        {number}
                      </li>
                    ))}
                  </ul>
                )}
                {rooming.highlight?.length && rooming.highlightNote && (
                  <p class="mt-2 text-2xs text-gold">{rooming.highlightNote}</p>
                )}
                {rooming.note && (
                  <p class="mt-2 text-2xs leading-relaxed text-ink-faint">{rooming.note}</p>
                )}
              </div>
            </details>
          )}

          <p class="mt-auto pt-4 text-2xs text-ink-faint">
            最低約新台幣 {toTwd(room.priceFrom).toLocaleString('en-US')} 元／每室每晚
          </p>
        </li>
        )),
      ])
    }
  </ul>

  <p
    class="hidden rounded-xl border border-dashed border-line bg-paper-deep/40 px-5 py-10 text-center text-sm text-ink-soft"
    data-empty
  >
    沒有符合條件的房型。試著放寬景觀或必要條件。
  </p>
</section>

<script>
  type Flag = 'alcove' | 'balcony' | 'breakfast';

  function initRoomExplorer(root: HTMLElement) {
    const list = root.querySelector<HTMLElement>('[data-room-list]');
    const empty = root.querySelector<HTMLElement>('[data-empty]');
    const count = root.querySelector<HTMLElement>('[data-result-count]');
    const resetButton = root.querySelector<HTMLButtonElement>('[data-reset]');
    if (!list || !empty || !count || !resetButton) return;

    const roomList = list;
    const emptyState = empty;
    const resultCount = count;
    const cards = Array.from(roomList.querySelectorAll<HTMLElement>('[data-room]'));
    const groups = Array.from(roomList.querySelectorAll<HTMLElement>('[data-group]'));

    function selected(name: string): string {
      const input = root.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`);
      return input?.value ?? 'all';
    }

    function activeFlags(): Flag[] {
      return Array.from(
        root.querySelectorAll<HTMLInputElement>('input[name="filter-flag"]:checked'),
      ).map((input) => input.value as Flag);
    }

    function apply() {
      const category = selected('filter-category');
      const view = selected('filter-view');
      const capacity = Number(selected('filter-capacity')) || 0;
      const flags = activeFlags();

      let visible = 0;
      for (const card of cards) {
        const matches =
          (category === 'all' || card.dataset.category === category) &&
          (view === 'all' || card.dataset.view === view) &&
          Number(card.dataset.capacity) >= capacity &&
          flags.every((flag) => card.dataset[flag] === 'true');

        card.hidden = !matches;
        if (matches) visible += 1;
      }

      resultCount.textContent = `${visible} 種房型`;
      emptyState.classList.toggle('hidden', visible > 0);
      roomList.classList.toggle('hidden', visible === 0);

      // A heading is only useful while its group still has something under it.
      for (const group of groups) {
        const shown = cards.filter(
          (card) => card.dataset.category === group.dataset.group && !card.hidden,
        ).length;
        group.hidden = shown === 0;
        const tally = group.querySelector('[data-group-count]');
        if (tally) tally.textContent = `${shown} 種`;
      }
    }

    root.addEventListener('change', apply);

    resetButton.addEventListener('click', () => {
      root
        .querySelectorAll<HTMLInputElement>('input[type="radio"][value="all"], input[value="0"]')
        .forEach((input) => (input.checked = true));
      root
        .querySelectorAll<HTMLInputElement>('input[name="filter-flag"]')
        .forEach((input) => (input.checked = false));
      apply();
    });

    apply();
  }

  document
    .querySelectorAll<HTMLElement>('[data-room-explorer]')
    .forEach((root) => initRoomExplorer(root));
</script>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>
