---
import { ROOMS, CATEGORIES } from '~/data/tokyo-disneyland-hotel';
import { COLUMNS, KNOWN_ROOM_NUMBERS, ZONES, type ZoneKey } from '~/data/tdh-room-numbers';

const roomById = Object.fromEntries(ROOMS.map((room) => [room.id, room]));
const categoryLabel = Object.fromEntries(CATEGORIES.map((c) => [c.key, c.label]));

const FLOORS = [9, 8, 7, 6, 5, 4, 3, 2, 1];

type Cell = {
  number: string;
  /** View class, except character rooms get their own key since the hotel
   * states they face the main entrance rather than merely lacking a label. */
  tone: 'grand' | 'park' | 'entrance' | 'none';
  balcony: boolean;
  title: string;
};

const cells = new Map<string, Cell>();
for (const hit of KNOWN_ROOM_NUMBERS) {
  const room = roomById[hit.roomId];
  if (!room) continue;
  cells.set(hit.number, {
    number: hit.number,
    tone: room.category === 'character' ? 'entrance' : room.view,
    balcony: hit.balcony || room.balcony,
    title: `${hit.number}｜${hit.floor} 樓｜${categoryLabel[room.category]} ${room.name}`,
  });
}

/** Zone boundaries, so the header band can span the right number of columns. */
const bands: { zone: ZoneKey; label: string; span: number }[] = [];
for (const column of COLUMNS) {
  const last = bands.at(-1);
  if (last && last.zone === column.zone) last.span += 1;
  else
    bands.push({
      zone: column.zone,
      label: ZONES.find((z) => z.key === column.zone)?.label ?? '',
      span: 1,
    });
}

const cellClass: Record<Cell['tone'], string> = {
  grand: 'bg-brand text-white',
  park: 'bg-[color-mix(in_srgb,var(--color-brand)_42%,white)] text-white',
  none: 'bg-[#cdc2ae] text-white',
  entrance: 'bg-[#d8a9b7] text-white',
};

const bandClass: Record<ZoneKey, string> = {
  front: 'bg-brand text-white',
  'park-side': 'bg-[color-mix(in_srgb,var(--color-brand)_42%,white)] text-white',
  turret: 'bg-gold text-white',
  inner: 'bg-[#cdc2ae] text-white',
  entrance: 'bg-[#d8a9b7] text-white',
};

const counts = Object.fromEntries(
  ZONES.map((zone) => [
    zone.key,
    KNOWN_ROOM_NUMBERS.filter((hit) => COLUMNS.find((c) => c.code === hit.number.slice(1))?.zone === zone.key)
      .length,
  ]),
);
---

<section id="floor-matrix" class="not-prose scroll-mt-32">
  <div class="rounded-2xl border border-line bg-card p-5 sm:p-7">
    <h2 class="font-serif text-xl font-bold text-ink sm:text-2xl">整棟樓的立面圖</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-ink-soft">
      橫軸是位置，縱軸是樓層。房號的後三碼是位置代號，同一個代號在不同樓層就是同一面窗戶往上疊一層——所以這張表等於把整棟飯店攤平來看。
      深色是樂園全景觀，中間色是樂園景觀，粉色是面向飯店正門的迪士尼明星房，米色是沒有景觀分類，空白代表原始調查沒有列出那個房號。
    </p>

    <div class="mt-5 flex items-center gap-3 rounded-lg border border-line bg-paper-deep/40 px-4 py-2.5 text-xs text-ink-soft">
      <span class="font-bold text-brand-deep">← 面向東京迪士尼樂園</span>
      <span class="h-px flex-1 bg-line"></span>
      <span class="font-bold text-berry">面向飯店正門 →</span>
    </div>

    <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-xs">
      {
        ZONES.map((zone) => (
          <span class="flex items-center gap-1.5 text-ink-soft">
            <span class:list={['h-3 w-3 rounded-sm', bandClass[zone.key]]} aria-hidden="true" />
            {zone.label}
            <span class="text-ink-faint">{counts[zone.key]} 個房號</span>
          </span>
        ))
      }
    </div>

    <div class="mt-5 table-scroll rounded-xl border border-line">
      <table class="border-separate border-spacing-0 text-center" data-floor-matrix>
        <caption class="sr-only">
          東京迪士尼樂園大飯店已知房號的樓層與位置分佈
        </caption>
        <thead>
          <tr>
            <th class="sticky left-0 z-10 bg-card px-2 py-1.5 text-2xs font-medium text-ink-faint">
              樓層
            </th>
            {
              bands.map((band) => (
                <th
                  colspan={band.span}
                  class:list={[
                    'px-1 py-1 text-2xs font-bold whitespace-nowrap',
                    bandClass[band.zone],
                  ]}
                >
                  {band.label}
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            FLOORS.map((floor) => (
              <tr>
                <th
                  scope="row"
                  class="sticky left-0 z-10 bg-card px-2 py-0.5 text-2xs font-bold text-ink-soft tabular-nums"
                >
                  {floor}F
                </th>
                {COLUMNS.map((column) => {
                  const cell = cells.get(`${floor}${column.code}`);
                  if (!cell) {
                    return <td class="h-6 w-[19px] border border-line-soft/50 bg-paper/50" />;
                  }
                  return (
                    <td class="h-6 w-[19px] border border-white/50 p-0">
                      <button
                        type="button"
                        data-matrix-cell={cell.number}
                        title={cell.title}
                        class:list={[
                          'flex h-full w-full cursor-pointer items-center justify-center text-[9px] leading-none transition-opacity hover:opacity-60',
                          cellClass[cell.tone],
                        ]}
                      >
                        <span class="sr-only">{cell.title}</span>
                        {cell.balcony && <span aria-hidden="true">◆</span>}
                      </button>
                    </td>
                  );
                })}
              </tr>
            ))
          }
        </tbody>
        <tfoot>
          <tr>
            <td class="sticky left-0 z-10 bg-card"></td>
            {
              COLUMNS.map((column) => (
                <td class="px-0 py-1 align-top">
                  <span class="block pt-1 text-[9px] leading-none text-ink-faint tabular-nums [writing-mode:vertical-rl]">
                    {column.code}
                  </span>
                </td>
              ))
            }
          </tr>
        </tfoot>
      </table>
    </div>

    <p class="mt-3 text-xs text-ink-faint">
      ◆ 代表可以走到戶外陽台。點任一格會把房號帶進上方的查詢欄。手機請左右滑動表格。
    </p>

    <ul class="mt-6 grid gap-3 border-t border-line-soft pt-5 sm:grid-cols-2">
      {
        ZONES.map((zone) => (
          <li class="flex gap-2.5">
            <span
              class:list={['mt-1 h-3 w-3 shrink-0 rounded-sm', bandClass[zone.key]]}
              aria-hidden="true"
            />
            <p class="text-[0.8125rem] leading-relaxed text-ink-soft">
              <span class="font-bold text-ink">{zone.label}</span>
              ：{zone.description}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-matrix-cell]').forEach((cell) => {
    cell.addEventListener('click', () => {
      const input = document.querySelector<HTMLInputElement>('[data-lookup-input]');
      if (!input) return;
      input.value = cell.dataset.matrixCell ?? '';
      input.dispatchEvent(new Event('input', { bubbles: true }));
      input.scrollIntoView({ block: 'center', behavior: 'smooth' });
    });
  });
</script>
