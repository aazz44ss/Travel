---
import { ROOMS } from '~/data/tokyo-disneyland-hotel';
import { KNOWN_ROOM_NUMBERS } from '~/data/tdh-room-numbers';

/**
 * Bird's-eye schematic of Tokyo Disneyland Hotel.
 *
 * Drawn as a squashed plan with each block extruded downward, so the building
 * reads as a solid mass seen from above rather than an abstract diagram. The
 * massing follows the published floor plans and the resort's aerial map: a
 * courtyard on the main-entrance side, two wings, and two legs reaching toward
 * the park with a turret and an end block each, plus a high bridge that exists
 * only on the top two floors.
 *
 * Individual rooms are not placed. Each block covers the position codes that
 * belong to it, which is as precise as the underlying data supports.
 */

const roomById = Object.fromEntries(ROOMS.map((room) => [room.id, room]));

type Tone = 'grand' | 'park' | 'entrance' | 'inner' | 'turret';

interface Part {
  key: string;
  label: string;
  /** Shown on the drawing itself. */
  short: string;
  codes: string[];
  tone: Tone;
  blurb: string;
}

const PARTS: Part[] = [
  {
    key: 'ring',
    label: '中庭環',
    short: '明星房 3xx',
    codes: ['301', '302', '303', '304', '305', '306', '307', '308', '309', '310', '311', '312', '313'],
    tone: 'entrance',
    blurb: '圍著中庭的一圈，幾乎全是迪士尼明星房。仙履奇緣、愛麗絲、小仙子、美女與野獸都在這裡，窗外是飯店正門那一側。',
  },
  {
    key: 'wing-west',
    label: '西翼',
    short: '明星房 6xx',
    codes: ['602', '603', '604', '606', '608', '610', '612', '614', '616', '617', '619', '622', '624', '626', '628', '630', '632'],
    tone: 'entrance',
    blurb: '全飯店最長的一支，房號 6 開頭。愛麗絲房與小仙子房大量集中在這裡。末端的 617 從 4 樓起是樂園景觀。',
  },
  {
    key: 'wing-east',
    label: '東翼',
    short: '樂園景觀 1xx',
    codes: ['103', '105', '106', '107', '121'],
    tone: 'park',
    blurb: '房號 1 開頭。105 到 107 是禮賓房與景隅客房的樂園景觀，121 是一層一間的塔樓客房。',
  },
  {
    key: 'leg-top-w',
    label: '西腳・上段',
    short: '明星房',
    codes: ['201', '202'],
    tone: 'entrance',
    blurb: '靠中庭的一段，美女與野獸客房（三床）。',
  },
  {
    key: 'leg-mid-w',
    label: '西腳・中段',
    short: '無景觀 2xx',
    codes: ['209', '211', '213'],
    tone: 'inner',
    blurb: '精緻凹室客房與尊爵客房。官方沒有給這一段景觀分類。',
  },
  {
    key: 'turret-w',
    label: '西角塔',
    short: '215',
    codes: ['215'],
    tone: 'turret',
    blurb: '3 樓景隅客房、4–7 樓塔樓客房、8–9 樓套房。同一座塔越高等級越高。',
  },
  {
    key: 'end-w',
    label: '西端・正面客房',
    short: '樂園全景觀 216–224',
    codes: ['216', '217', '218', '220', '221', '222', '224', '324'],
    tone: 'grand',
    blurb: '往樂園方向突出的一塊。5 樓以上是樂園全景觀，3、4 樓被車站站體擋住就沒有景觀分類。93 平方公尺的家庭客房也在這一端。',
  },
  {
    key: 'leg-top-e',
    label: '東腳・上段',
    short: '明星房',
    codes: ['501', '502'],
    tone: 'entrance',
    blurb: '靠中庭的一段，美女與野獸客房（三床）。',
  },
  {
    key: 'leg-mid-e',
    label: '東腳・中段',
    short: '無景觀 5xx',
    codes: ['503', '505', '507', '509', '511', '513'],
    tone: 'inner',
    blurb: '精緻凹室客房與尊爵客房。官方沒有給這一段景觀分類。',
  },
  {
    key: 'turret-e',
    label: '東角塔',
    short: '515',
    codes: ['515'],
    tone: 'turret',
    blurb: '與西角塔對稱。華特・迪士尼套房與迪士尼魔法王國套房都在這兩座塔的頂端。',
  },
  {
    key: 'end-e',
    label: '東端・正面客房',
    short: '樂園全景觀 516–522',
    codes: ['516', '517', '518', '520', '521', '522'],
    tone: 'grand',
    blurb: '與西端對稱，同樣是 5 樓以上才掛上樂園全景觀。',
  },
  {
    key: 'bridge',
    label: '空橋（8–9 樓）',
    short: '樂園全景觀 401–407',
    codes: ['401', '402', '403', '404', '405', '406', '407'],
    tone: 'grand',
    blurb: '只存在於 8 樓與 9 樓，橫跨兩腳之間、正對樂園。8 樓那一排就是全飯店唯一有陽台的禮賓房。',
  },
];

const codeToPart = new Map<string, string>();
for (const part of PARTS) for (const code of part.codes) codeToPart.set(code, part.key);

const stats: Record<string, { total: number; byFloor: Record<number, number> }> = {};
for (const part of PARTS) stats[part.key] = { total: 0, byFloor: {} };
for (const hit of KNOWN_ROOM_NUMBERS) {
  const key = codeToPart.get(hit.number.slice(1));
  if (!key) continue;
  const bucket = stats[key]!;
  bucket.total += 1;
  bucket.byFloor[hit.floor] = (bucket.byFloor[hit.floor] ?? 0) + 1;
}

const samples: Record<string, string[]> = {};
for (const part of PARTS) {
  const names = new Set<string>();
  for (const hit of KNOWN_ROOM_NUMBERS) {
    if (codeToPart.get(hit.number.slice(1)) !== part.key) continue;
    const room = roomById[hit.roomId];
    if (room) names.add(room.name);
  }
  samples[part.key] = [...names];
}

/** Roof colour and the darker face used for the extruded side. */
const TONE: Record<Tone, { top: string; side: string; label: string; note: string }> = {
  grand: { top: '#0f4c5c', side: '#082e38', label: '樂園全景觀', note: '正面看得到城堡' },
  park: { top: '#5b93a1', side: '#3b6d79', label: '樂園景觀', note: '斜角看得到樂園' },
  entrance: { top: '#d8a9b7', side: '#a97485', label: '迪士尼明星房', note: '面向飯店正門，看不到樂園' },
  inner: { top: '#cdc2ae', side: '#a2977f', label: '無景觀分類', note: '中庭、側面或停車場方向' },
  turret: { top: '#b4832c', side: '#7c5817', label: '角塔', note: '景隅、塔樓客房與套房' },
};

const LEGEND: Tone[] = ['grand', 'park', 'entrance', 'inner', 'turret'];

/** Plan geometry. y is squashed by the group transform to fake the viewing angle. */
const SHAPES: Record<string, string> = {
  ring: 'M320 52 h260 v130 h-260 Z M372 88 h156 v58 h-156 Z',
  'wing-west': 'M320 108 L92 40 L60 104 L286 186 Z',
  'wing-east': 'M580 122 L816 174 L802 244 L596 196 Z',
  'leg-top-w': 'M286 182 L352 222 L352 286 L286 286 Z',
  'leg-mid-w': 'M286 286 h66 v124 h-66 Z',
  'end-w': 'M228 470 h180 v66 h-180 Z',
  'leg-top-e': 'M614 196 L548 226 L548 286 L614 286 Z',
  'leg-mid-e': 'M548 286 h66 v124 h-66 Z',
  'end-e': 'M492 470 h180 v66 h-180 Z',
  bridge: 'M370 296 h160 v56 h-160 Z',
};

/** Back-to-front, so the extruded faces overlap correctly. */
const DRAW_ORDER = [
  'ring',
  'wing-west',
  'wing-east',
  'leg-top-w',
  'leg-top-e',
  'leg-mid-w',
  'leg-mid-e',
  'bridge',
  'turret-w',
  'turret-e',
  'end-w',
  'end-e',
];

const partByKey = Object.fromEntries(PARTS.map((part) => [part.key, part]));
const EXTRUDE = 30;
/** The bridge only exists on the top two floors, so it floats above the rest. */
const BRIDGE_LIFT = 34;

const FLOORS = [9, 8, 7, 6, 5, 4, 3, 2, 1];
const payload = PARTS.map((part) => ({
  key: part.key,
  label: part.label,
  blurb: part.blurb,
  tone: part.tone,
  toneLabel: TONE[part.tone].label,
  codes: part.codes,
  total: stats[part.key]!.total,
  byFloor: stats[part.key]!.byFloor,
  samples: samples[part.key]!,
}));
---

<section id="floor-plan" class="not-prose scroll-mt-32">
  <div class="rounded-2xl border border-line bg-card p-5 sm:p-7">
    <h2 class="font-serif text-xl font-bold text-ink sm:text-2xl">飯店俯瞰示意圖</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-ink-soft">
      把房號的位置代號放回建築上。飯店大致是一個開口朝向樂園的形狀：中庭在飯店正門那一側，兩隻腳往樂園方向伸出去，末端各有一座角塔和一塊正面客房，8 樓與 9 樓還多一道橫跨兩腳之間的空橋。點任一塊看它是什麼。
    </p>

    <ul class="mt-5 flex flex-wrap gap-x-5 gap-y-2">
      {
        LEGEND.map((tone) => (
          <li class="flex items-center gap-2 text-xs">
            <span
              class="h-3.5 w-3.5 shrink-0 rounded-sm"
              style={`background:${TONE[tone].top}`}
              aria-hidden="true"
            />
            <span class="font-bold text-ink">{TONE[tone].label}</span>
            <span class="text-ink-faint">{TONE[tone].note}</span>
          </li>
        ))
      }
    </ul>

    <div class="mt-5 flex flex-wrap items-center gap-2">
      <span class="text-2xs font-bold tracking-[0.15em] text-ink-faint uppercase">樓層</span>
      <label class="cursor-pointer">
        <input type="radio" name="plan-floor" value="all" checked class="peer sr-only" />
        <span class="block rounded-full border border-line px-3 py-1 text-sm text-ink-soft transition-colors peer-checked:border-brand peer-checked:bg-brand peer-checked:text-white peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-brand hover:bg-paper-deep">
          全部
        </span>
      </label>
      {
        FLOORS.map((floor) => (
          <label class="cursor-pointer">
            <input type="radio" name="plan-floor" value={floor} class="peer sr-only" />
            <span class="block rounded-full border border-line px-3 py-1 text-sm text-ink-soft tabular-nums transition-colors peer-checked:border-brand peer-checked:bg-brand peer-checked:text-white peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-brand hover:bg-paper-deep">
              {floor}F
            </span>
          </label>
        ))
      }
    </div>

    <div class="mt-5 grid gap-6 lg:grid-cols-[1.85fr_1fr]">
      <div class="overflow-hidden rounded-xl border border-line bg-[#f4f1ea] p-2">
        <svg
          viewBox="30 10 840 460"
          class="h-auto w-full"
          role="img"
          aria-labelledby="plan-title plan-desc"
        >
          <title id="plan-title">東京迪士尼樂園大飯店俯瞰示意圖</title>
          <desc id="plan-desc">
            示意圖。上方是飯店正門側的中庭，左右是西翼與東翼，中央兩隻腳往下（樂園方向）延伸，末端各有角塔與正面客房，8 至 9 樓另有橫跨兩腳的空橋。
          </desc>

          <text x="450" y="30" text-anchor="middle" font-size="14" font-weight="700" fill="#8b8f99">
            飯店正門側・幻想曲廣場
          </text>

          <g transform="translate(0, 22) scale(1, 0.62)" data-plan-parts>
            {
              DRAW_ORDER.map((key) => {
                const part = partByKey[key]!;
                const tone = TONE[part.tone];
                const lift = key === 'bridge' ? BRIDGE_LIFT : 0;
                const isTurret = key.startsWith('turret');
                const cx = key === 'turret-w' ? 319 : 581;
                return (
                  <g data-part={key} class="cursor-pointer transition-opacity hover:opacity-80">
                    {isTurret ? (
                      <>
                        <ellipse cx={cx} cy={440 + EXTRUDE} rx="30" ry="30" fill={tone.side} />
                        <rect x={cx - 30} y="440" width="60" height={EXTRUDE} fill={tone.side} />
                        <ellipse cx={cx} cy="440" rx="30" ry="30" fill={tone.top} stroke="#fff" stroke-width="2.5" />
                      </>
                    ) : (
                      <>
                        <path
                          d={SHAPES[key]}
                          fill={tone.side}
                          transform={`translate(0, ${EXTRUDE - lift})`}
                          fill-rule="evenodd"
                        />
                        <path
                          d={SHAPES[key]}
                          fill={tone.top}
                          stroke="#ffffff"
                          stroke-width="2.5"
                          fill-rule="evenodd"
                          transform={lift ? `translate(0, ${-lift})` : undefined}
                        />
                      </>
                    )}
                  </g>
                );
              })
            }
          </g>

          <g font-size="11.5" font-weight="700" text-anchor="middle" pointer-events="none">
            <text x="450" y="60" fill="#7a4658">明星房 3xx</text>
            <text x="450" y="105" fill="#a89a86" font-size="10.5" font-weight="400">中庭</text>
            <text x="176" y="98" fill="#ffffff">明星房 6xx</text>
            <text x="700" y="145" fill="#ffffff">樂園景觀 1xx</text>
            <text x="319" y="238" fill="#6b6255">無景觀 2xx</text>
            <text x="581" y="238" fill="#6b6255">無景觀 5xx</text>
            <text x="450" y="200" fill="#ffffff">樂園全景觀 401–407</text>
            <text x="319" y="299" fill="#ffffff" font-size="10.5">215</text>
            <text x="581" y="299" fill="#ffffff" font-size="10.5">515</text>
            <text x="319" y="331" fill="#ffffff">樂園全景觀</text>
            <text x="319" y="345" fill="#ffffff" font-size="10">216–224</text>
            <text x="581" y="331" fill="#ffffff">樂園全景觀</text>
            <text x="581" y="345" fill="#ffffff" font-size="10">516–522</text>
          </g>

          <line
            x1="140"
            y1="418"
            x2="760"
            y2="418"
            stroke="#0f4c5c"
            stroke-width="2"
            stroke-dasharray="9 7"></line>
          <text x="450" y="444" text-anchor="middle" font-size="14" font-weight="700" fill="#0f4c5c">
            東京迪士尼樂園
          </text>
        </svg>
      </div>

      <div>
        <div class="rounded-xl border border-line bg-paper-deep/40 p-5">
          <p class="text-2xs font-bold tracking-[0.15em] text-ink-faint uppercase" data-plan-hint>
            點圖上任一塊
          </p>
          <h3 class="mt-2 font-serif text-lg font-bold text-ink" data-plan-label>整棟建築</h3>
          <p
            class="mt-1 hidden w-fit rounded-full px-2.5 py-1 text-2xs font-bold text-white"
            data-plan-tone
          >
          </p>
          <p class="mt-2 text-[0.875rem] leading-[1.9] text-ink-soft" data-plan-blurb>
            上方是飯店正門與幻想曲廣場那一側，下方是東京迪士尼樂園。中庭與兩翼的明星房面向正門，兩隻腳末端的正面客房面向樂園。
          </p>
          <dl class="mt-4 grid grid-cols-2 gap-3 border-t border-line pt-4">
            <div>
              <dt class="text-2xs text-ink-faint">已知房號</dt>
              <dd class="mt-0.5 font-serif text-xl font-bold text-brand-deep" data-plan-count>
                {KNOWN_ROOM_NUMBERS.length}
              </dd>
            </div>
            <div>
              <dt class="text-2xs text-ink-faint">位置代號</dt>
              <dd class="mt-0.5 font-serif text-xl font-bold text-brand-deep" data-plan-codes>71</dd>
            </div>
          </dl>
          <p class="mt-4 text-xs leading-relaxed text-ink-faint" data-plan-samples></p>
        </div>

        <p class="mt-4 text-xs leading-relaxed text-ink-faint">
          示意圖，非等比例，也沒有畫出每一間房。量體依照原始資料的樓層平面圖與度假區鳥瞰圖描繪，各區塊的歸屬則由房號與官方景觀分類推得。想看逐間精確位置，請看文末資料來源裡的原始平面圖。
        </p>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ payload, TONE }}>
  (() => {
    const root = document.querySelector('#floor-plan');
    if (!root) return;

    const parts = new Map(payload.map((p) => [p.key, p]));
    const label = root.querySelector('[data-plan-label]');
    const blurb = root.querySelector('[data-plan-blurb]');
    const count = root.querySelector('[data-plan-count]');
    const codes = root.querySelector('[data-plan-codes]');
    const hint = root.querySelector('[data-plan-hint]');
    const samples = root.querySelector('[data-plan-samples]');
    const toneBadge = root.querySelector('[data-plan-tone]');

    const DEFAULT_BLURB =
      '上方是飯店正門與幻想曲廣場那一側，下方是東京迪士尼樂園。中庭與兩翼的明星房面向正門，兩隻腳末端的正面客房面向樂園。';

    let activeKey = null;

    const floor = () => {
      const checked = root.querySelector('input[name="plan-floor"]:checked');
      return checked && checked.value !== 'all' ? Number(checked.value) : null;
    };
    const countFor = (part, f) => (f === null ? part.total : (part.byFloor[f] ?? 0));

    function paint() {
      const f = floor();
      root.querySelectorAll('[data-part]').forEach((node) => {
        const part = parts.get(node.dataset.part);
        if (!part) return;
        node.setAttribute('opacity', countFor(part, f) === 0 ? '0.2' : '1');
        node.querySelectorAll('[stroke]').forEach((shape) => {
          const on = activeKey === node.dataset.part;
          shape.setAttribute('stroke', on ? '#15181d' : '#ffffff');
          shape.setAttribute('stroke-width', on ? '4' : '2.5');
        });
      });

      if (activeKey) {
        const part = parts.get(activeKey);
        const n = countFor(part, f);
        if (hint) hint.textContent = f === null ? '全部樓層' : `${f} 樓`;
        if (label) label.textContent = part.label;
        if (blurb) blurb.textContent = part.blurb;
        if (count) count.textContent = String(n);
        if (codes) codes.textContent = String(part.codes.length);
        if (toneBadge) {
          toneBadge.textContent = part.toneLabel;
          toneBadge.style.background = TONE[part.tone].top;
          toneBadge.style.color = part.tone === 'entrance' || part.tone === 'inner' ? '#4a3f33' : '#fff';
          toneBadge.classList.remove('hidden');
        }
        if (samples)
          samples.textContent =
            n === 0
              ? '這一層沒有這一塊，或原始調查沒有列出這裡的房號。'
              : `房型：${part.samples.slice(0, 4).join('、')}${part.samples.length > 4 ? ' 等' : ''}`;
      } else {
        const total = payload.reduce((sum, p) => sum + countFor(p, f), 0);
        const live = payload.filter((p) => countFor(p, f) > 0);
        if (hint) hint.textContent = f === null ? '點圖上任一塊' : `${f} 樓`;
        if (label) label.textContent = '整棟建築';
        if (blurb) blurb.textContent = DEFAULT_BLURB;
        if (count) count.textContent = String(total);
        if (codes) codes.textContent = String(live.reduce((s, p) => s + p.codes.length, 0));
        if (samples) samples.textContent = '';
        if (toneBadge) toneBadge.classList.add('hidden');
      }
    }

    root.querySelectorAll('[data-part]').forEach((node) => {
      node.addEventListener('click', () => {
        activeKey = activeKey === node.dataset.part ? null : node.dataset.part;
        paint();
      });
    });

    root.addEventListener('change', paint);
    paint();
  })();
</script>
