---
import { ROOMS } from '~/data/tokyo-disneyland-hotel';
import { KNOWN_ROOM_NUMBERS } from '~/data/tdh-room-numbers';
import { BARS, CELL_H, CELL_W, CORRIDOR, type Slot } from '~/data/tdh-layout';

/**
 * Room-level plan of Tokyo Disneyland Hotel.
 *
 * Each cell is one guest room, placed along the corridor it belongs to, so the
 * two sides of a double-loaded arm read as facing opposite ways. Cells whose
 * room number the survey did not publish are still drawn, hatched, because
 * leaving them out would make the corridors look half empty and hide the fact
 * that a character-room wing has park-facing rooms on its other side.
 */

const roomById = Object.fromEntries(ROOMS.map((room) => [room.id, room]));

/** code -> floors on which a room with that code is recorded. */
const floorsByCode = new Map<string, Map<number, string>>();
for (const hit of KNOWN_ROOM_NUMBERS) {
  const code = hit.number.slice(1);
  if (!floorsByCode.has(code)) floorsByCode.set(code, new Map());
  floorsByCode.get(code)!.set(hit.floor, hit.roomId);
}

const TONE = {
  grand: { fill: '#0f4c5c', text: '#ffffff', label: '樂園全景觀', note: '正面看得到城堡' },
  park: { fill: '#5b93a1', text: '#ffffff', label: '樂園景觀', note: '斜角看得到樂園' },
  entrance: { fill: '#d8a9b7', text: '#5c3140', label: '迪士尼明星房', note: '面向飯店正門' },
  inner: { fill: '#cdc2ae', text: '#4f4739', label: '無景觀分類', note: '中庭或側面' },
  turret: { fill: '#b4832c', text: '#ffffff', label: '角塔', note: '景隅／塔樓／套房' },
} as const;

/** Sales category, using the same pink / yellow / blue as the published plans. */
const CATEGORY = {
  standard: { fill: '#f3c9dc', text: '#7a4658', label: '標準房' },
  character: { fill: '#f7e491', text: '#6b5a12', label: '迪士尼明星房' },
  concierge: { fill: '#b6dcec', text: '#1d5468', label: '禮賓房與套房' },
} as const;

type CategoryKey = keyof typeof CATEGORY;

function categoryOf(type: string): CategoryKey {
  if (type.startsWith('禮賓房') || type.includes('套房') || type.includes('塔樓')) return 'concierge';
  if (type.startsWith('迪士尼')) return 'character';
  return 'standard';
}

interface Cell {
  x: number;
  y: number;
  angle: number;
  code?: string;
  tone: string;
  type: string;
  bed?: string;
  facing: string;
  bar: string;
  category: CategoryKey;
  /** Floors on which this position is a recorded room. Empty = never listed. */
  floors: number[];
  /** Room name from the main dataset, when the number is known. */
  roomName?: string;
}

const cells: Cell[] = [];
for (const bar of BARS) {
  const rad = (bar.angle * Math.PI) / 180;
  const cos = Math.cos(rad);
  const sin = Math.sin(rad);
  bar.rows.forEach((row, rowIndex) => {
    const localY = rowIndex * (CELL_H + CORRIDOR);
    row.slots.forEach((slot: Slot, i) => {
      const localX = i * CELL_W;
      cells.push({
        x: bar.x + localX * cos - localY * sin,
        y: bar.y + localX * sin + localY * cos,
        angle: bar.angle,
        code: slot.code,
        tone: slot.tone,
        type: slot.type,
        bed: slot.bed,
        facing: row.facing,
        bar: bar.label,
        category: categoryOf(slot.type),
        floors: slot.code ? [...(floorsByCode.get(slot.code)?.keys() ?? [])].sort((a, b) => a - b) : [],
        roomName: slot.code
          ? roomById[[...(floorsByCode.get(slot.code)?.values() ?? [])][0] ?? '']?.name
          : undefined,
      });
    });
  });
}

const placedCodes = new Set(cells.map((cell) => cell.code).filter(Boolean));
const recordedInPlan = KNOWN_ROOM_NUMBERS.filter((hit) => placedCodes.has(hit.number.slice(1))).length;

const LEGEND = ['grand', 'park', 'entrance', 'inner', 'turret'] as const;
const CAT_LEGEND = ['standard', 'character', 'concierge'] as const;
const FLOORS = [9, 8, 7, 6, 5, 4, 3, 2, 1];

const payload = cells.map((cell, index) => ({
  i: index,
  code: cell.code ?? null,
  tone: cell.tone,
  type: cell.type,
  bed: cell.bed ?? null,
  facing: cell.facing,
  bar: cell.bar,
  category: cell.category,
  catFill: CATEGORY[cell.category].fill,
  catText: CATEGORY[cell.category].text,
  catLabel: CATEGORY[cell.category].label,
  toneFill: TONE[cell.tone as keyof typeof TONE].fill,
  toneText: TONE[cell.tone as keyof typeof TONE].text,
  toneLabel: TONE[cell.tone as keyof typeof TONE].label,
  floors: cell.floors,
  roomName: cell.roomName ?? null,
}));
---

<section id="floor-plan" class="not-prose scroll-mt-32">
  <div class="rounded-2xl border border-line bg-card p-5 sm:p-7">
    <h2 class="font-serif text-xl font-bold text-ink sm:text-2xl">逐間客房平面圖</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-ink-soft">
      一格就是一間房。飯店大部分的走廊兩側都有房間，所以同一棟裡會出現「一邊是明星房、另一邊面對樂園」的情況——西翼就是最典型的例子。
      選樓層可以看那一層有哪些房間，點任一格看它是什麼房型、幾號房、什麼床型。
    </p>

    <div class="mt-5 flex flex-wrap items-center gap-2">
      <span class="text-2xs font-bold tracking-[0.15em] text-ink-faint uppercase">上色依據</span>
      {
        [
          { value: 'view', label: '看得到什麼' },
          { value: 'category', label: '房型分類' },
        ].map((option, index) => (
          <label class="cursor-pointer">
            <input
              type="radio"
              name="plan-colour"
              value={option.value}
              checked={index === 0}
              class="peer sr-only"
            />
            <span class="block rounded-full border border-line px-3 py-1 text-sm text-ink-soft transition-colors peer-checked:border-brand peer-checked:bg-brand peer-checked:text-white peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-brand hover:bg-paper-deep">
              {option.label}
            </span>
          </label>
        ))
      }
    </div>

    <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-2" data-legend="view">
      {
        LEGEND.map((tone) => (
          <li class="flex items-center gap-2 text-xs">
            <span
              class="h-3.5 w-3.5 shrink-0 rounded-sm"
              style={`background:${TONE[tone].fill}`}
              aria-hidden="true"
            />
            <span class="font-bold text-ink">{TONE[tone].label}</span>
            <span class="text-ink-faint">{TONE[tone].note}</span>
          </li>
        ))
      }
    </ul>

    <ul class="mt-3 hidden flex-wrap gap-x-5 gap-y-2" data-legend="category">
      {
        CAT_LEGEND.map((cat) => (
          <li class="flex items-center gap-2 text-xs">
            <span
              class="h-3.5 w-3.5 shrink-0 rounded-sm"
              style={`background:${CATEGORY[cat].fill}`}
              aria-hidden="true"
            />
            <span class="font-bold text-ink">{CATEGORY[cat].label}</span>
          </li>
        ))
      }
      <li class="text-xs text-ink-faint">與原始平面圖的粉／黃／藍配色一致</li>
    </ul>

    <p class="mt-3 flex items-center gap-2 text-xs text-ink-faint">
      <span
        class="h-3.5 w-3.5 shrink-0 rounded-sm border-2 border-dashed border-white bg-[#cdc2ae]"
        aria-hidden="true"></span>
      虛線格的房間確實存在，只是原始調查沒有公布房號，所以格子裡沒有號碼。
    </p>

    <div class="mt-5 flex flex-wrap items-center gap-2">
      <span class="text-2xs font-bold tracking-[0.15em] text-ink-faint uppercase">樓層</span>
      <label class="cursor-pointer">
        <input type="radio" name="plan-floor" value="all" checked class="peer sr-only" />
        <span class="block rounded-full border border-line px-3 py-1 text-sm text-ink-soft transition-colors peer-checked:border-brand peer-checked:bg-brand peer-checked:text-white peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-brand hover:bg-paper-deep">
          全部
        </span>
      </label>
      {
        FLOORS.map((floor) => (
          <label class="cursor-pointer">
            <input type="radio" name="plan-floor" value={floor} class="peer sr-only" />
            <span class="block rounded-full border border-line px-3 py-1 text-sm text-ink-soft tabular-nums transition-colors peer-checked:border-brand peer-checked:bg-brand peer-checked:text-white peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-brand hover:bg-paper-deep">
              {floor}F
            </span>
          </label>
        ))
      }
    </div>

    <div class="mt-5 space-y-5">
      <div class="table-scroll rounded-xl border border-line bg-[#f6f3ec] p-2">
        <svg
          viewBox="118 44 1252 600"
          class="h-auto w-full min-w-[54rem]"
          role="img"
          aria-labelledby="plan-title plan-desc"
        >
          <title id="plan-title">東京迪士尼樂園大飯店逐間客房平面圖</title>
          <desc id="plan-desc">
            平面圖。上方是飯店正門側的中庭環，左右是西翼與東翼，中央兩隻腳往下（樂園方向）延伸，末端是正面客房與角塔。每一格代表一間客房。
          </desc>

          <text x="760" y="64" text-anchor="middle" font-size="15" font-weight="700" fill="#8b8f99">
            飯店正門側・幻想曲廣場
          </text>
          <text x="800" y="168" text-anchor="middle" font-size="12" fill="#b3aa9a">中庭</text>

          {
            cells.map((cell, index) => (
              <g
                transform={`translate(${cell.x} ${cell.y}) rotate(${cell.angle})`}
                data-cell={index}
                data-code={cell.code ?? ''}
                data-floors={cell.floors.join(',')}
                class="cursor-pointer"
              >
                <rect
                  width={CELL_W}
                  height={CELL_H}
                  rx="1.5"
                  fill={TONE[cell.tone as keyof typeof TONE].fill}
                  stroke="#ffffff"
                  stroke-width={cell.code ? 1.6 : 2.2}
                  stroke-dasharray={cell.code ? undefined : '4 3'}
                  data-shape
                />
                {cell.code && (
                  <text
                    x={CELL_W / 2}
                    y={CELL_H / 2 + 3.6}
                    text-anchor="middle"
                    font-size="11"
                    font-weight="700"
                    fill={TONE[cell.tone as keyof typeof TONE].text}
                    pointer-events="none"
                  >
                    {cell.code}
                  </text>
                )}
              </g>
            ))
          }

          <line
            x1="300"
            y1="586"
            x2="1200"
            y2="586"
            stroke="#0f4c5c"
            stroke-width="2"
            stroke-dasharray="9 7"></line>
          <text x="750" y="616" text-anchor="middle" font-size="15" font-weight="700" fill="#0f4c5c">
            東京迪士尼樂園
          </text>
        </svg>
      </div>

      <div class="grid gap-5 rounded-xl border border-line bg-paper-deep/40 p-5 sm:grid-cols-[1.4fr_1fr] sm:p-6">
        <div>
          <p class="text-2xs font-bold tracking-[0.15em] text-ink-faint uppercase" data-plan-hint>
            點圖上任一格
          </p>
          <h3 class="mt-2 font-serif text-lg font-bold text-ink" data-plan-label>整層平面</h3>
          <p class="mt-1 hidden w-fit rounded-full px-2.5 py-1 text-2xs font-bold" data-plan-tone />
          <p class="mt-2 text-[0.875rem] leading-[1.9] text-ink-soft" data-plan-blurb>
            上方是飯店正門與幻想曲廣場，下方是東京迪士尼樂園。虛線格的房間確實存在，只是原始調查沒有公布房號。
          </p>
        </div>
        <dl class="space-y-2.5 border-t border-line pt-4 text-sm sm:border-t-0 sm:border-l sm:pt-0 sm:pl-5" data-plan-facts />
      </div>

      <p class="text-xs leading-relaxed text-ink-faint">
        房間位置與房型轉錄自原始資料的樓層平面圖，並與房號資料交叉驗證過：9 樓空橋那七間讀出來是 41-42-42-41-42-42-41，正好對上
        9401 到 9407 的禮賓房精緻客房與凹室客房交錯。圖形為示意，不代表實際尺寸與角度；手機請左右滑動圖面。
      </p>
    </div>
  </div>
</section>

<script is:inline define:vars={{ payload, recordedInPlan }}>
  (() => {
    const root = document.querySelector('#floor-plan');
    if (!root) return;

    const label = root.querySelector('[data-plan-label]');
    const blurb = root.querySelector('[data-plan-blurb]');
    const hint = root.querySelector('[data-plan-hint]');
    const facts = root.querySelector('[data-plan-facts]');
    const toneBadge = root.querySelector('[data-plan-tone]');
    const nodes = Array.from(root.querySelectorAll('[data-cell]'));


    const DEFAULT_BLURB =
      '上方是飯店正門與幻想曲廣場，下方是東京迪士尼樂園。虛線格的房間確實存在，只是原始調查沒有公布房號。';

    let active = null;

    const floor = () => {
      const checked = root.querySelector('input[name="plan-floor"]:checked');
      return checked && checked.value !== 'all' ? Number(checked.value) : null;
    };

    const onFloor = (cell, f) => f === null || cell.floors.includes(f) || cell.floors.length === 0;

    const mode = () => {
      const checked = root.querySelector('input[name="plan-colour"]:checked');
      return checked ? checked.value : 'view';
    };

    function paint() {
      const f = floor();
      const byCategory = mode() === 'category';

      root.querySelectorAll('[data-legend]').forEach((list) => {
        const show = list.dataset.legend === (byCategory ? 'category' : 'view');
        list.classList.toggle('hidden', !show);
        list.classList.toggle('flex', show);
      });

      nodes.forEach((node, i) => {
        const cell = payload[i];
        const present = onFloor(cell, f);
        node.setAttribute('opacity', present ? '1' : '0.14');
        const shape = node.querySelector('[data-shape]');
        if (shape) {
          const on = active === i;
          shape.setAttribute('fill', byCategory ? cell.catFill : cell.toneFill);
          shape.setAttribute('stroke', on ? '#15181d' : '#ffffff');
          shape.setAttribute('stroke-width', on ? '3' : cell.code ? '1.6' : '2.2');
        }
        const text = node.querySelector('text');
        if (text) text.setAttribute('fill', byCategory ? cell.catText : cell.toneText);
      });

      if (active === null) {
        const shown = payload.filter((c) => c.code && onFloor(c, f)).length;
        if (hint) hint.textContent = f === null ? '點圖上任一格' : `${f} 樓`;
        if (label) label.textContent = '整層平面';
        if (blurb) blurb.textContent = DEFAULT_BLURB;
        if (toneBadge) toneBadge.classList.add('hidden');
        if (facts)
          facts.innerHTML =
            `<div class="flex justify-between gap-3"><dt class="text-ink-faint">圖上已標號的房間</dt><dd class="font-bold text-ink">${shown} 間</dd></div>` +
            `<div class="flex justify-between gap-3"><dt class="text-ink-faint">收錄房號總數</dt><dd class="font-bold text-ink">${recordedInPlan} 個</dd></div>`;
        return;
      }

      const cell = payload[active];
      const fill = byCategory ? cell.catFill : cell.toneFill;
      const text = byCategory ? cell.catText : cell.toneText;
      const badge = byCategory ? cell.catLabel : cell.toneLabel;
      const roomNumbers = cell.code ? cell.floors.map((fl) => `${fl}${cell.code}`) : [];
      const visible = f === null ? roomNumbers : roomNumbers.filter((n) => Number(n[0]) === f);

      if (hint) hint.textContent = cell.bar;
      if (label) label.textContent = cell.code ? `位置 ${cell.code}` : '房號未公布的位置';
      if (toneBadge) {
        toneBadge.textContent = badge;
        toneBadge.style.background = fill;
        toneBadge.style.color = text;
        toneBadge.classList.remove('hidden');
      }
      if (blurb)
        blurb.textContent = cell.code
          ? `${cell.type}。${cell.facing === 'park' ? '這一側面向東京迪士尼樂園。' : cell.facing === 'entrance' ? '這一側面向飯店正門。' : '這一側面向建築側面或中庭。'}`
          : `${cell.type}。${cell.facing === 'park' ? '這一側面向東京迪士尼樂園。' : cell.facing === 'entrance' ? '這一側面向飯店正門。' : '這一側面向建築側面或中庭。'}房間確實存在，但原始調查沒有公布房號——這幾個類別各有數十間，只用平面圖標了範圍。`;

      if (facts) {
        const rows = [];
        if (cell.bed) rows.push(['床型', cell.bed]);
        if (cell.roomName) rows.push(['官方房型名稱', cell.roomName]);
        if (visible.length)
          rows.push([f === null ? '各樓層房號' : `${f} 樓房號`, visible.join('、')]);
        else if (cell.code) rows.push([`${f} 樓`, '這一層沒有這個房號']);
        facts.innerHTML = rows
          .map(
            ([k, v]) =>
              `<div class="flex justify-between gap-3"><dt class="shrink-0 text-ink-faint">${k}</dt><dd class="text-right font-bold text-ink">${v}</dd></div>`,
          )
          .join('');
      }
    }

    nodes.forEach((node, i) => {
      node.addEventListener('click', () => {
        active = active === i ? null : i;
        paint();
      });
    });

    root.addEventListener('change', paint);
    paint();
  })();
</script>
