---
import { ROOMS } from '~/data/tokyo-disneyland-hotel';
import { KNOWN_ROOM_NUMBERS } from '~/data/tdh-room-numbers';
import { PLAN_HEIGHT, PLAN_ROOMS, PLAN_WIDTH, type Tone } from '~/data/tdh-plan';

/**
 * True-geometry floor plan. Every room is drawn at its traced position, size and
 * angle, so the family rooms really are three times a standard room and the
 * corridors really do run at the angles the building runs at.
 */

const roomById = Object.fromEntries(ROOMS.map((room) => [room.id, room]));

/** code -> floor -> room type id, from the published room numbers. */
const byCode = new Map<string, Map<number, string>>();
for (const hit of KNOWN_ROOM_NUMBERS) {
  const code = hit.number.slice(1);
  if (!byCode.has(code)) byCode.set(code, new Map());
  byCode.get(code)!.set(hit.floor, hit.roomId);
}

const TONE: Record<Tone, { fill: string; text: string; label: string; note: string }> = {
  grand: { fill: '#0f4c5c', text: '#ffffff', label: '樂園全景觀', note: '正面看得到城堡' },
  park: { fill: '#5b93a1', text: '#ffffff', label: '樂園景觀', note: '斜角看得到樂園' },
  entrance: { fill: '#d8a9b7', text: '#5c3140', label: '迪士尼明星房', note: '面向飯店正門' },
  inner: { fill: '#cdc2ae', text: '#4f4739', label: '無景觀分類', note: '中庭或側面' },
  turret: { fill: '#b4832c', text: '#ffffff', label: '角塔', note: '景隅／塔樓／套房' },
};

/** Sales category, using the same pink / yellow / blue as the published plans. */
const CATEGORY = {
  standard: { fill: '#f3c9dc', text: '#7a4658', label: '標準房' },
  character: { fill: '#f7e491', text: '#6b5a12', label: '迪士尼明星房' },
  concierge: { fill: '#b6dcec', text: '#1d5468', label: '禮賓房與套房' },
} as const;

type CategoryKey = keyof typeof CATEGORY;

function categoryOf(type: string): CategoryKey {
  if (type.startsWith('禮賓房') || type.includes('套房') || type.includes('塔樓')) return 'concierge';
  if (type.startsWith('迪士尼')) return 'character';
  return 'standard';
}

const shoelace = (poly: number[]): number => {
  let a = 0;
  for (let i = 0; i < poly.length; i += 2) {
    const j = (i + 2) % poly.length;
    a += poly[i]! * poly[j + 1]! - poly[j]! * poly[i + 1]!;
  }
  return Math.abs(a) / 2;
};

const centroidOf = (poly: number[]): [number, number] => {
  let x = 0;
  let y = 0;
  const n = poly.length / 2;
  for (let i = 0; i < poly.length; i += 2) {
    x += poly[i]!;
    y += poly[i + 1]!;
  }
  return [x / n, y / n];
};

const cells = PLAN_ROOMS.map((room) => {
  const floors = [...(byCode.get(room.code)?.keys() ?? [])].sort((a, b) => a - b);
  const [cx, cy] = centroidOf(room.poly);
  const category = categoryOf(room.type);
  return {
    ...room,
    cx: Math.round(cx * 10) / 10,
    cy: Math.round(cy * 10) / 10,
    /** Plan-unit area; used only to decide whether a label fits. */
    area: Math.round(shoelace(room.poly)),
    floors,
    category,
    points: room.poly.reduce<string[]>((acc, value, i) => {
      if (i % 2 === 0) acc.push(`${value},${room.poly[i + 1]}`);
      return acc;
    }, []).join(' '),
    /** Floor -> official room name, so the panel can be floor-specific. */
    names: Object.fromEntries(
      [...(byCode.get(room.code)?.entries() ?? [])].map(([floor, id]) => [
        floor,
        roomById[id]?.name ?? '',
      ]),
    ),
  };
});

/** Rooms in this corridor share a floor range when a number was not published. */
const floorFallback = new Map<string, number[]>();
for (const cell of cells) {
  const group = cell.code[0]!;
  const set = floorFallback.get(group) ?? [];
  floorFallback.set(group, [...new Set([...set, ...cell.floors])].sort((a, b) => a - b));
}

const LEGEND: Tone[] = ['grand', 'park', 'entrance', 'inner', 'turret'];
const CAT_LEGEND = ['standard', 'character', 'concierge'] as const;
const FLOORS = [9, 8, 7, 6, 5, 4, 3, 2, 1];

const payload = cells.map((cell, i) => ({
  i,
  code: cell.code,
  type: cell.type,
  bed: cell.bed ?? null,
  facing: cell.facing,
  area: cell.area,
  floors: cell.floors.length > 0 ? cell.floors : (floorFallback.get(cell.code[0]!) ?? []),
  names: cell.names,
  toneFill: TONE[cell.tone].fill,
  toneText: TONE[cell.tone].text,
  toneLabel: TONE[cell.tone].label,
  catFill: CATEGORY[cell.category].fill,
  catText: CATEGORY[cell.category].text,
  catLabel: CATEGORY[cell.category].label,
}));

const median = [...cells.map((c) => c.area)].sort((a, b) => a - b)[Math.floor(cells.length / 2)]!;
const biggest = Math.max(...cells.map((c) => c.area));
---

<section id="floor-plan" class="not-prose scroll-mt-32">
  <div class="rounded-2xl border border-line bg-card p-5 sm:p-7">
    <h2 class="font-serif text-xl font-bold text-ink sm:text-2xl">逐間客房平面圖</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-ink-soft">
      這張圖是從原始平面圖描出來的，{cells.length}
      間客房的位置、大小和角度都照實際比例畫——所以家庭客房看起來就是標準房的三倍大，走廊的轉角也是真的轉角。
      飯店大部分的走廊兩側都有房間，同一棟裡因此會出現「一邊是明星房、另一邊面對樂園」的情況。
    </p>

    <div class="mt-5 flex flex-wrap items-center gap-2">
      <span class="text-2xs font-bold tracking-[0.15em] text-ink-faint uppercase">上色依據</span>
      {
        [
          { value: 'view', label: '看得到什麼' },
          { value: 'category', label: '房型分類' },
        ].map((option, index) => (
          <label class="cursor-pointer">
            <input
              type="radio"
              name="plan-colour"
              value={option.value}
              checked={index === 0}
              class="peer sr-only"
            />
            <span class="block rounded-full border border-line px-3 py-1 text-sm text-ink-soft transition-colors peer-checked:border-brand peer-checked:bg-brand peer-checked:text-white peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-brand hover:bg-paper-deep">
              {option.label}
            </span>
          </label>
        ))
      }
    </div>

    <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-2" data-legend="view">
      {
        LEGEND.map((tone) => (
          <li class="flex items-center gap-2 text-xs">
            <span
              class="h-3.5 w-3.5 shrink-0 rounded-sm"
              style={`background:${TONE[tone].fill}`}
              aria-hidden="true"
            />
            <span class="font-bold text-ink">{TONE[tone].label}</span>
            <span class="text-ink-faint">{TONE[tone].note}</span>
          </li>
        ))
      }
    </ul>

    <ul class="mt-3 hidden flex-wrap gap-x-5 gap-y-2" data-legend="category">
      {
        CAT_LEGEND.map((cat) => (
          <li class="flex items-center gap-2 text-xs">
            <span
              class="h-3.5 w-3.5 shrink-0 rounded-sm"
              style={`background:${CATEGORY[cat].fill}`}
              aria-hidden="true"
            />
            <span class="font-bold text-ink">{CATEGORY[cat].label}</span>
          </li>
        ))
      }
      <li class="text-xs text-ink-faint">與原始平面圖的粉／黃／藍配色一致</li>
    </ul>

    <div class="mt-5 flex flex-wrap items-center gap-2">
      <span class="text-2xs font-bold tracking-[0.15em] text-ink-faint uppercase">樓層</span>
      <label class="cursor-pointer">
        <input type="radio" name="plan-floor" value="all" checked class="peer sr-only" />
        <span class="block rounded-full border border-line px-3 py-1 text-sm text-ink-soft transition-colors peer-checked:border-brand peer-checked:bg-brand peer-checked:text-white peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-brand hover:bg-paper-deep">
          全部
        </span>
      </label>
      {
        FLOORS.map((floor) => (
          <label class="cursor-pointer">
            <input type="radio" name="plan-floor" value={floor} class="peer sr-only" />
            <span class="block rounded-full border border-line px-3 py-1 text-sm text-ink-soft tabular-nums transition-colors peer-checked:border-brand peer-checked:bg-brand peer-checked:text-white peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-brand hover:bg-paper-deep">
              {floor}F
            </span>
          </label>
        ))
      }
    </div>

    <div class="mt-5 space-y-5">
      <div class="table-scroll rounded-xl border border-line bg-[#f7f4ee] p-2">
        <svg
          viewBox={`0 0 ${PLAN_WIDTH} ${PLAN_HEIGHT + 46}`}
          class="h-auto w-full min-w-[52rem]"
          role="img"
          aria-labelledby="plan-title plan-desc"
        >
          <title id="plan-title">東京迪士尼樂園大飯店逐間客房平面圖</title>
          <desc id="plan-desc">
            依實際比例描繪的平面圖。上方是飯店正門側的中庭，左右是西翼與東翼，中央兩隻腳往下（樂園方向）延伸，末端是正面客房與角塔。每一個多邊形是一間客房。
          </desc>

          <text
            x={PLAN_WIDTH / 2}
            y="14"
            text-anchor="middle"
            font-size="13"
            font-weight="700"
            fill="#8b8f99">飯店正門側・幻想曲廣場</text
          >

          {
            cells.map((cell, index) => (
              <g data-cell={index} data-code={cell.code} class="cursor-pointer">
                <polygon
                  points={cell.points}
                  fill={TONE[cell.tone].fill}
                  stroke="#ffffff"
                  stroke-width="1.1"
                  data-shape
                />
                <text
                  x={cell.cx}
                  y={cell.cy + 3}
                  text-anchor="middle"
                  font-size={cell.area > median * 1.6 ? 9.5 : 8}
                  font-weight="700"
                  fill={TONE[cell.tone].text}
                  pointer-events="none">{cell.code}</text
                >
              </g>
            ))
          }

          <line
            x1={PLAN_WIDTH * 0.18}
            y1={PLAN_HEIGHT + 20}
            x2={PLAN_WIDTH * 0.82}
            y2={PLAN_HEIGHT + 20}
            stroke="#0f4c5c"
            stroke-width="1.6"
            stroke-dasharray="8 6"></line>
          <text
            x={PLAN_WIDTH / 2}
            y={PLAN_HEIGHT + 40}
            text-anchor="middle"
            font-size="13"
            font-weight="700"
            fill="#0f4c5c">東京迪士尼樂園</text
          >
        </svg>
      </div>

      <div
        class="grid gap-5 rounded-xl border border-line bg-paper-deep/40 p-5 sm:grid-cols-[1.4fr_1fr] sm:p-6"
      >
        <div>
          <p class="text-2xs font-bold tracking-[0.15em] text-ink-faint uppercase" data-plan-hint>
            點圖上任一間房
          </p>
          <h3 class="mt-2 font-serif text-lg font-bold text-ink" data-plan-label>整層平面</h3>
          <p class="mt-1 hidden w-fit rounded-full px-2.5 py-1 text-2xs font-bold" data-plan-tone />
          <p class="mt-2 text-[0.875rem] leading-[1.9] text-ink-soft" data-plan-blurb>
            上方是飯店正門與幻想曲廣場，下方是東京迪士尼樂園。格子裡的三位數是房號的後三碼，前面加上樓層就是完整房號。
          </p>
        </div>
        <dl
          class="space-y-2.5 border-t border-line pt-4 text-sm sm:border-t-0 sm:border-l sm:pt-0 sm:pl-5"
          data-plan-facts
        />
      </div>

      <p class="text-xs leading-relaxed text-ink-faint">
        位置與大小是把原始平面圖切割成區域後逐間描出來的，房號則由各條走廊從一間已知的房間往下推；房型取自原始圖與官方資料，原圖未逐間標註房型的位置則依同一段走廊的標示推得。驗證方式：中庭環由左到右是
        313 到 301，其仙履奇緣／愛麗絲／美女與野獸／小仙子的排列與房號資料完全吻合；8 樓空橋（401–407）取自 8
        樓平面圖，套疊誤差在 2 像素以內。最大的家庭客房面積約是最小客房的 {Math.round((biggest / (median || 1)) * 10) / 10} 倍。手機請左右滑動圖面。
      </p>
    </div>
  </div>
</section>

<script is:inline define:vars={{ payload }}>
  (() => {
    const root = document.querySelector('#floor-plan');
    if (!root) return;

    const label = root.querySelector('[data-plan-label]');
    const blurb = root.querySelector('[data-plan-blurb]');
    const hint = root.querySelector('[data-plan-hint]');
    const facts = root.querySelector('[data-plan-facts]');
    const toneBadge = root.querySelector('[data-plan-tone]');
    const nodes = Array.from(root.querySelectorAll('[data-cell]'));

    const DEFAULT_BLURB =
      '上方是飯店正門與幻想曲廣場，下方是東京迪士尼樂園。格子裡的三位數是房號的後三碼，前面加上樓層就是完整房號。';

    let active = null;

    const floor = () => {
      const checked = root.querySelector('input[name="plan-floor"]:checked');
      return checked && checked.value !== 'all' ? Number(checked.value) : null;
    };
    const mode = () => {
      const checked = root.querySelector('input[name="plan-colour"]:checked');
      return checked ? checked.value : 'view';
    };
    const onFloor = (cell, f) => f === null || cell.floors.includes(f);

    function paint() {
      const f = floor();
      const byCategory = mode() === 'category';

      root.querySelectorAll('[data-legend]').forEach((list) => {
        const show = list.dataset.legend === (byCategory ? 'category' : 'view');
        list.classList.toggle('hidden', !show);
        list.classList.toggle('flex', show);
      });

      nodes.forEach((node, i) => {
        const cell = payload[i];
        node.setAttribute('opacity', onFloor(cell, f) ? '1' : '0.13');
        const shape = node.querySelector('[data-shape]');
        if (shape) {
          const on = active === i;
          shape.setAttribute('fill', byCategory ? cell.catFill : cell.toneFill);
          shape.setAttribute('stroke', on ? '#15181d' : '#ffffff');
          shape.setAttribute('stroke-width', on ? '2.6' : '1.1');
        }
        const text = node.querySelector('text');
        if (text) text.setAttribute('fill', byCategory ? cell.catText : cell.toneText);
      });

      if (active === null) {
        const shown = payload.filter((c) => onFloor(c, f)).length;
        if (hint) hint.textContent = f === null ? '點圖上任一間房' : `${f} 樓`;
        if (label) label.textContent = '整層平面';
        if (blurb) blurb.textContent = DEFAULT_BLURB;
        if (toneBadge) toneBadge.classList.add('hidden');
        if (facts)
          facts.innerHTML =
            `<div class="flex justify-between gap-3"><dt class="text-ink-faint">${f === null ? '圖上客房' : `${f} 樓客房`}</dt><dd class="font-bold text-ink">${shown} 間</dd></div>` +
            `<div class="flex justify-between gap-3"><dt class="text-ink-faint">全館客房</dt><dd class="font-bold text-ink">706 間</dd></div>`;
        return;
      }

      const cell = payload[active];
      const fill = byCategory ? cell.catFill : cell.toneFill;
      const text = byCategory ? cell.catText : cell.toneText;
      const badge = byCategory ? cell.catLabel : cell.toneLabel;
      const where =
        cell.facing === 'park'
          ? '窗戶在面向東京迪士尼樂園的那一側。'
          : cell.facing === 'entrance'
            ? '窗戶在面向飯店正門的那一側。'
            : '窗戶在建築側面。';

      if (hint) hint.textContent = f === null ? '全部樓層' : `${f} 樓`;
      if (label) label.textContent = `位置 ${cell.code}`;
      if (toneBadge) {
        toneBadge.textContent = badge;
        toneBadge.style.background = fill;
        toneBadge.style.color = text;
        toneBadge.classList.remove('hidden');
      }
      if (blurb) blurb.textContent = `${cell.type}。${where}`;

      if (facts) {
        const rows = [];
        if (cell.bed) rows.push(['床型', cell.bed]);
        const nameForFloor = f !== null ? cell.names[String(f)] : null;
        if (nameForFloor) rows.push([`${f} 樓官方房型`, nameForFloor]);
        else if (f === null) {
          const names = [...new Set(Object.values(cell.names))].filter(Boolean);
          if (names.length) rows.push(['官方房型名稱', names.join('、')]);
        }
        const numbers = cell.floors.map((fl) => `${fl}${cell.code}`);
        const visible = f === null ? numbers : numbers.filter((n) => Number(n[0]) === f);
        rows.push([
          f === null ? '房號' : `${f} 樓房號`,
          visible.length ? visible.join('、') : '這一層沒有這個位置',
        ]);
        facts.innerHTML = rows
          .map(
            ([k, v]) =>
              `<div class="flex justify-between gap-3"><dt class="shrink-0 text-ink-faint">${k}</dt><dd class="text-right font-bold text-ink">${v}</dd></div>`,
          )
          .join('');
      }
    }

    nodes.forEach((node, i) => {
      node.addEventListener('click', () => {
        active = active === i ? null : i;
        paint();
      });
    });

    root.addEventListener('change', paint);
    paint();
  })();
</script>
