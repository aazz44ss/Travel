---
import { FACILITIES } from '~/data/tokyo-disneyland-hotel';
import { DEFAULT_LOCALE, type Locale } from '~/i18n/config';
import { FACILITY_COPY, pick } from '~/i18n/hotel-content';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;

const GUEST_ONLY: Record<Locale, string> = {
  'zh-hant': '住客限定',
  ja: '宿泊者限定',
  en: 'Guests only',
};

const items = FACILITIES.map((facility) => {
  const copy = FACILITY_COPY[facility.nameEn];
  return {
    ...facility,
    name: pick(copy?.name, facility.name, locale),
    location: pick(copy?.location, facility.location, locale),
    description: pick(copy?.description, facility.description, locale),
    photoTip: facility.photoTip ? pick(copy?.photoTip, facility.photoTip, locale) : undefined,
  };
});
---

<div class="not-prose my-8 grid gap-4 sm:grid-cols-2">
  {
    items.map((facility) => (
      <article class="flex flex-col rounded-xl border border-line bg-card p-5">
        <div class="flex flex-wrap items-center gap-2">
          <h4 class="font-serif text-base font-bold text-ink">{facility.name}</h4>
          {facility.guestOnly && (
            <span class="rounded-full bg-gold px-2 py-0.5 text-2xs font-bold text-white">
              {GUEST_ONLY[locale]}
            </span>
          )}
        </div>
        <p class="mt-0.5 text-2xs tracking-wide text-ink-faint uppercase">{facility.nameEn}</p>
        <p class="mt-2 text-xs text-brand">{facility.location}</p>
        <p class="mt-2.5 text-[0.875rem] leading-[1.85] text-ink-soft">{facility.description}</p>
        {facility.photoTip && (
          <p class="mt-auto flex gap-2 pt-4 text-[0.8125rem] leading-relaxed text-ink">
            <svg
              width="14"
              height="14"
              viewBox="0 0 16 16"
              fill="none"
              class="mt-[0.35em] shrink-0 text-gold"
              aria-hidden="true"
            >
              <path
                d="M2 5.2h2.6L5.8 3.4h4.4l1.2 1.8H14v7.4H2V5.2Z M8 11a2.4 2.4 0 1 0 0-4.8A2.4 2.4 0 0 0 8 11Z"
                stroke="currentColor"
                stroke-width="1.3"
                stroke-linejoin="round"
              />
            </svg>
            <span>{facility.photoTip}</span>
          </p>
        )}
      </article>
    ))
  }
</div>
