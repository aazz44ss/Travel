---
import type { Facility } from '~/data/hotel';

interface Props {
  facilities: Facility[];
}

const { facilities } = Astro.props;
---

<div class="not-prose my-8 grid gap-4 sm:grid-cols-2">
  {
    facilities.map((facility) => (
      <article class="flex flex-col rounded-xl border border-line bg-card p-5">
        <div class="flex flex-wrap items-center gap-2">
          <h4 class="font-serif text-base font-bold text-ink">{facility.name}</h4>
          {facility.guestOnly && (
            <span class="rounded-full bg-gold px-2 py-0.5 text-2xs font-bold text-white">
              住客限定
            </span>
          )}
        </div>
        <p class="mt-0.5 text-2xs tracking-wide text-ink-faint uppercase">{facility.nameEn}</p>
        <p class="mt-2 text-xs text-brand">{facility.location}</p>
        <p class="mt-2.5 text-[0.875rem] leading-[1.85] text-ink-soft">{facility.description}</p>
        {facility.photoTip && (
          <p class="mt-auto flex gap-2 pt-4 text-[0.8125rem] leading-relaxed text-ink">
            <svg
              width="14"
              height="14"
              viewBox="0 0 16 16"
              fill="none"
              class="mt-[0.35em] shrink-0 text-gold"
              aria-hidden="true"
            >
              <path
                d="M2 5.2h2.6L5.8 3.4h4.4l1.2 1.8H14v7.4H2V5.2Z M8 11a2.4 2.4 0 1 0 0-4.8A2.4 2.4 0 0 0 8 11Z"
                stroke="currentColor"
                stroke-width="1.3"
                stroke-linejoin="round"
              />
            </svg>
            <span>{facility.photoTip}</span>
          </p>
        )}
      </article>
    ))
  }
</div>
