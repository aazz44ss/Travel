---
import { withBase } from '~/consts';
import { DEFAULT_LOCALE, LOCALES, LOCALE_META, localePath, type Locale } from '~/i18n/config';
import { t } from '~/i18n/ui';
import '~/styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Structured data injected as JSON-LD. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
  publishedAt?: Date;
  updatedAt?: Date;
  type?: 'website' | 'article';
  locale?: Locale;
  /** Path written as if the site were single-language, used for hreflang. */
  path?: string;
}

const {
  title,
  description,
  schema,
  publishedAt,
  updatedAt,
  type = 'website',
  locale = DEFAULT_LOCALE,
  path = '/',
} = Astro.props;

const site = t(locale).site;
const pageTitle = title === site.name ? `${site.name}｜${site.tagline}` : `${title}｜${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://example.com');
const origin = Astro.site ?? new URL('https://example.com');
/** Every locale of this same page, so search engines can pair them up. */
const alternates = LOCALES.map((code) => ({
  code,
  hreflang: LOCALE_META[code].htmlLang,
  href: new URL(localePath(code, path), origin).href,
}));
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical.href} />
<meta name="generator" content={Astro.generator} />

<link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
<link rel="alternate" type="application/rss+xml" title={site.name} href={withBase('/rss.xml')} />

{alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
<link
  rel="alternate"
  hreflang="x-default"
  href={alternates.find((alt) => alt.code === DEFAULT_LOCALE)!.href}
/>

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={LOCALE_META[locale].ogLocale} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical.href} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />

{publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
{updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&family=Noto+Serif+TC:wght@500;700;900&display=swap"
/>

{
  schema && (
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(Array.isArray(schema) ? schema : [schema])}
    />
  )
}
