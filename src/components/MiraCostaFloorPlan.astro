---
import type { ConnectingPair, Room, RoomNumbers, RoomView } from '~/data/hotel';
import {
  PARTIAL_VIEW_FROM_PLAN,
  PLAN_FLOORS,
  PLAN_RUNS,
  layout,
  MEASURED_FACES,
  SKETCH_PARENT,
  corridorFromFace,
  slotsOf,
  spansOf,
  type Facing,
} from '~/data/dhm-plan';
import { DEFAULT_LOCALE, type Locale } from '~/i18n/config';
import { explorer } from '~/i18n/explorer';
import { roomName, viewLabel } from '~/i18n/rooms';
import { SITE_SCALE_BAR, interiorSide } from '~/data/dhm-site';
import { PHOTO } from '~/data/dhm-photo';

interface Props {
  rooms: Room[];
  views: RoomView[];
  roomNumbers: RoomNumbers;
  connecting: ConnectingPair[];
  sourceUrl: string;
  locale?: Locale;
}

const { rooms, roomNumbers, connecting, sourceUrl, locale = DEFAULT_LOCALE } = Astro.props;

const copy = explorer(locale).harbourPlan;
const siteCopy = explorer(locale).site;
const roomById = Object.fromEntries(rooms.map((room) => [room.id, room]));

/** Room number -> the type it is sold as, from the enumerated per-type lists. */
const typeOf = new Map<string, { room: Room; balcony: boolean; ambiguous: boolean }>();
for (const [roomId, entry] of Object.entries(roomNumbers)) {
  const room = roomById[roomId];
  if (!room) continue;
  for (const number of entry.numbers) {
    typeOf.set(number, {
      room,
      balcony: entry.balcony.includes(number),
      ambiguous: (entry.ambiguousWith ?? []).length > 0,
    });
  }
}

/**
 * What a window actually looks at. The view grade the hotel sells decides it
 * wherever a room number is enumerated; elsewhere the corridor's own side does,
 * which is how the inland half of every corridor gets described at all.
 */
const seenFrom = (number: string, facing: Facing): string => {
  const sold = typeOf.get(number)?.room.view;
  if (sold) return sold;
  if (PARTIAL_VIEW_FROM_PLAN.includes(number)) return 'partial';
  return facing === 'harbour' || facing === 'piazza' ? 'unknown' : facing;
};

/** Warm for what sees the water, cool and flat for what does not. */
const TONE: Record<string, { fill: string; text: string }> = {
  'harbour-grand': { fill: '#0a353f', text: '#ffffff' },
  harbour: { fill: '#0f4c5c', text: '#ffffff' },
  'piazza-grand': { fill: '#5b93a1', text: '#ffffff' },
  piazza: { fill: '#b4832c', text: '#ffffff' },
  canal: { fill: '#8c2f4a', text: '#ffffff' },
  entrance: { fill: '#a9b8bd', text: '#22333a' },
  partial: { fill: '#cdc2ae', text: '#4f4739' },
  inland: { fill: '#e6dfd3', text: '#6b6152' },
  unknown: { fill: '#e6dfd3', text: '#6b6152' },
};

/**
 * Everything is drawn in metres about the hotel, so the drawing carries no frame
 * of its own: a room's position is either a measured wall or a sketch hung off
 * one, and the scale bar measures both.
 */
const ROOM_PITCH_M = 4.37;
const STRETCH_LIMIT_M = 5.5;
/** How deep a room is drawn. */
const ROOM_DEPTH_M = 6.7;

/** The similarity that carries a measured run's sketch onto its wall. */
const frameOf = (key: string) => {
  const face = MEASURED_FACES[key]!;
  const path = PLAN_RUNS.find((run) => run.key === key)!.path;
  const [sA, sB] = [path[0]!, path[path.length - 1]!];
  const [mA, mB] = [face[0]!, face[face.length - 1]!];
  const k =
    Math.hypot(mB[0] - mA[0], mB[1] - mA[1]) / Math.hypot(sB[0] - sA[0], sB[1] - sA[1]);
  const turn =
    Math.atan2(mB[1] - mA[1], mB[0] - mA[0]) - Math.atan2(sB[1] - sA[1], sB[0] - sA[0]);
  const cos = Math.cos(turn) * k;
  const sin = Math.sin(turn) * k;
  return ([x, y]: readonly [number, number]): [number, number] => [
    mA[0] + (x - sA[0]) * cos - (y - sA[1]) * sin,
    mA[1] + (x - sA[0]) * sin + (y - sA[1]) * cos,
  ];
};

const mpp = PHOTO.metresPerPixel;
/**
 * Absolute tile pixels run to about 60 million here, which is past the precision
 * browsers keep for path coordinates — enough to make the whole figure vanish. So
 * the window's own corner is the origin and everything is expressed relative to
 * it, leaving numbers in the hundreds.
 */
const originX = PHOTO.originX + PHOTO.window.x0 / mpp;
const originY = PHOTO.originY + PHOTO.window.y0 / mpp;
const view = {
  width: Math.round((PHOTO.window.x1 - PHOTO.window.x0) / mpp),
  height: Math.round((PHOTO.window.y1 - PHOTO.window.y0) / mpp),
};
/**
 * The photograph is a lazy layer of plain images under a transparent drawing, not
 * pixels inside it: at this zoom it is 54 tiles, and a reader who never scrolls
 * this far should not pay for them. Positions are percentages so the two layers
 * stay locked together at any width.
 */
const tiles = [];
for (let tx = PHOTO.tiles.x0; tx <= PHOTO.tiles.x1; tx += 1) {
  for (let ty = PHOTO.tiles.y0; ty <= PHOTO.tiles.y1; ty += 1) {
    tiles.push({
      href: PHOTO.url(tx, ty, PHOTO.zoom),
      left: ((tx * PHOTO.size - originX) / view.width) * 100,
      top: ((ty * PHOTO.size - originY) / view.height) * 100,
    });
  }
}
/** Sizes are tuned on a 1000-unit-wide drawing; scaling keeps them constant on screen. */
const ui = view.width / 1000;

/** Metres about the hotel to pixels in the window. North is up in both. */
const planToPhoto = {
  a: 1 / mpp,
  b: 0,
  c: 0,
  d: 1 / mpp,
  e: PHOTO.originX - originX,
  f: PHOTO.originY - originY,
};
const matrix = `matrix(${planToPhoto.a} ${planToPhoto.b} ${planToPhoto.c} ${planToPhoto.d} ${planToPhoto.e} ${planToPhoto.f})`;

const scaleBar = {
  x: 30 * ui,
  y: view.height - 26 * ui,
  length: Math.round(SITE_SCALE_BAR / mpp),
};

const metres = (line: readonly [number, number][]): number =>
  line.slice(1).reduce((sum, p, i) => sum + Math.hypot(p[0] - line[i]![0], p[1] - line[i]![1]), 0);

/**
 * Where a run's rooms sit: the line they are measured from, and how far in from
 * it each side of the corridor is.
 *
 * A wing is a slab with a corridor down it and rooms against both faces. The side
 * the survey matched sits on the wall itself. The other sits directly behind it,
 * one room deep plus a corridor, rather than against the far wall. Casting across
 * the block for that wall gives 25 to 38 m, but the outline carries the
 * courtyards as building rather than as holes, so a cast crosses a garden as
 * readily as a corridor; and swinging a bent wall out that far makes the cells fan
 * apart and cross at every bend. A row behind the first is right for the shape of
 * the wing, and a few metres short of its back wall.
 */
const placementOf = (run: (typeof PLAN_RUNS)[number]) => {
  const rooms = Math.max(...(['left', 'right'] as const).map((s) => slotsOf(run, s).length));
  const matched = MEASURED_FACES[run.key];
  const inland = ROOM_DEPTH_M + 2;
  if (matched) {
    /** Cut a wall that carries more than rooms back to what the rooms need. */
    const fits = metres(matched) / rooms <= STRETCH_LIMIT_M;
    const wall = fits
      ? [...matched]
      : corridorFromFace(matched, interiorSide(matched), 0, rooms * ROOM_PITCH_M);
    const faceSide: 'left' | 'right' = run.left.facing === 'inland' ? 'right' : 'left';
    return {
      line: wall,
      inward: interiorSide(wall),
      inset: { [faceSide]: 0, [faceSide === 'right' ? 'left' : 'right']: inland } as Record<
        'left' | 'right',
        number
      >,
      measured: true,
    };
  }
  /** No wall matched: the sketched corridor, hung off a neighbour's measured one. */
  const line = run.path.map(frameOf(SKETCH_PARENT[run.key]!));
  const faceSide: 'left' | 'right' = run.left.facing === 'inland' ? 'right' : 'left';
  return {
    line,
    inward: interiorSide(line),
    inset: { [faceSide]: 0, [faceSide === 'right' ? 'left' : 'right']: inland } as Record<
      'left' | 'right',
      number
    >,
    measured: false,
  };
};

/** Every cell on the plan, per floor, ready to draw. */
const cells = PLAN_RUNS.flatMap((run) => {
  const at = placementOf(run);
  return (['left', 'right'] as const).flatMap((side) =>
    PLAN_FLOORS.flatMap((floor) => {
      const spans = spansOf(run, side, floor);
      return layout(
        at.line,
        slotsOf(run, side).length,
        spans,
        at.inward,
        ROOM_DEPTH_M,
        at.inset[side],
      ).map((cell, i) => {
        const number = spans[i]!.number;
        const sold = typeOf.get(number);
        const grade = seenFrom(number, run[side].facing);
        /** Four digits need about 19 px and a room front is 17: write it across. */
        const across = cell.width < ROOM_PITCH_M * 1.6;
        /** Whatever direction the run is walked, the number reads upright. */
        const upright = (deg: number) => (deg > 90 ? deg - 180 : deg <= -90 ? deg + 180 : deg);
        return {
          across,
          labelAngle: upright(across ? cell.angle + 90 : cell.angle),
          number,
          floor,
          run: run.key,
          facing: run[side].facing,
          grade,
          ...cell,
          /** Centre in photo pixels, for a callout drawn at readable size. */
          vx: planToPhoto.a * cell.cx + planToPhoto.c * cell.cy + planToPhoto.e,
          vy: planToPhoto.b * cell.cx + planToPhoto.d * cell.cy + planToPhoto.f,
          roomId: sold?.room.id ?? null,
          balcony: sold?.balcony ?? false,
          ambiguous: sold?.ambiguous ?? false,
        };
      });
    }),
  );
});

const byFloor = Object.fromEntries(
  PLAN_FLOORS.map((floor) => [floor, cells.filter((cell) => cell.floor === floor)]),
);

/** Cells whose number the source's per-type lists actually enumerate. */
const enumerated = cells.filter((cell) => cell.roomId).length;

/** The legend only lists what the plan actually contains. */
const legend = (
  ['harbour', 'piazza-grand', 'piazza', 'partial', 'canal', 'entrance', 'inland'] as const
).filter((grade) => cells.some((cell) => cell.grade === grade));

const gradeLabel = (grade: string): string =>
  grade === 'inland' || grade === 'unknown' || grade === 'entrance' || grade === 'canal'
    ? copy.facing[grade === 'unknown' ? 'inland' : (grade as 'inland' | 'entrance' | 'canal')]
    : viewLabel('dhm', locale, grade);

const showAnswer = (grade: string): string =>
  grade === 'harbour' || grade === 'harbour-grand'
    ? copy.shows.full
    : grade === 'piazza-grand'
      ? copy.shows.partial
      : grade === 'piazza'
        ? copy.shows.piazza
        : copy.shows.none;

const connectingPairs = connecting
  .map((pair) => ({
    rooms: pair.types.map((id) => roomById[id]).filter((room): room is Room => Boolean(room)),
    note: pair.note,
  }))
  .filter((pair) => pair.rooms.length === 2);

/** Handed to the browser so a click can describe a room without another request. */
const payload = Object.fromEntries(
  cells.map((cell) => [
    `${cell.floor}:${cell.number}`,
    {
      number: cell.number,
      floor: cell.floor,
      name: cell.roomId ? roomName(roomById[cell.roomId]!, 'dhm', locale) : copy.unlisted,
      grade: gradeLabel(cell.grade),
      shows: showAnswer(cell.grade),
      size: cell.roomId ? `${roomById[cell.roomId]!.size} m²` : '',
      capacity: cell.roomId ? String(roomById[cell.roomId]!.capacity) : '',
      balcony: cell.balcony,
      ambiguous: cell.ambiguous,
      fromPlan: !cell.roomId && PARTIAL_VIEW_FROM_PLAN.includes(cell.number),
      vx: Math.round(cell.vx * 10) / 10,
      vy: Math.round(cell.vy * 10) / 10,
    },
  ]),
);

const totalOnPlan = cells.length;
const harbourRooms = cells.filter((cell) => cell.facing === 'harbour').length;
---

<section id="floor-plan" class="not-prose scroll-mt-32" data-miracosta-plan>
  <div class="rounded-2xl border border-line bg-card p-5 sm:p-7">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 class="font-serif text-xl font-bold text-ink sm:text-2xl">{copy.heading}</h2>
        <p class="mt-2 max-w-3xl text-sm leading-relaxed text-ink-soft">
          {copy.intro(totalOnPlan, harbourRooms)}
        </p>
      </div>
      <p
        class="rounded-full bg-brand-soft px-3.5 py-1.5 text-sm font-medium text-brand-deep"
        data-plan-floor-label
      >
        {copy.floorLabel(PLAN_FLOORS[0])}
      </p>
    </div>

    <div class="mt-5 flex flex-wrap items-center gap-2">
      <span class="text-2xs font-bold tracking-[0.15em] text-ink-faint uppercase">{copy.floors}</span>
      {
        PLAN_FLOORS.map((floor, index) => (
          <label class="cursor-pointer">
            <input
              type="radio"
              name="plan-floor"
              value={floor}
              checked={index === 0}
              class="peer sr-only"
            />
            <span class="block rounded-full border border-line px-3 py-1 text-sm text-ink-soft tabular-nums transition-colors peer-checked:border-brand peer-checked:bg-brand peer-checked:text-white peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-brand hover:bg-paper-deep">
              {floor}F
            </span>
          </label>
        ))
      }
    </div>

    <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-2">
      {
        legend.map((grade) => (
          <li class="flex items-center gap-2 text-xs">
            <span
              class="h-3.5 w-3.5 shrink-0 rounded-sm"
              style={`background:${TONE[grade]!.fill}`}
              aria-hidden="true"
            />
            <span class="font-bold text-ink">{gradeLabel(grade)}</span>
            <span class="text-ink-faint">{showAnswer(grade)}</span>
          </li>
        ))
      }
    </ul>

    <div class="mt-5 space-y-5">
      <div class="table-scroll rounded-xl border border-line bg-[#f7f4ee] p-2">
        <div
          class="relative min-w-[68rem] overflow-hidden bg-[#25303a]"
          style={`aspect-ratio:${view.width}/${view.height}`}
        >
          {
            tiles.map((tile) => (
              <img
                src={tile.href}
                alt=""
                loading="lazy"
                decoding="async"
                aria-hidden="true"
                class="absolute select-none"
                style={`left:${tile.left}%;top:${tile.top}%;width:${(PHOTO.size / view.width) * 100}%;height:${(PHOTO.size / view.height) * 100}%`}
              />
            ))
          }
          <svg
            viewBox={`0 0 ${view.width} ${view.height}`}
            preserveAspectRatio="none"
            class="absolute inset-0 h-full w-full"
            role="img"
            aria-labelledby="dhm-plan-title dhm-plan-desc"
          >
            <title id="dhm-plan-title">{copy.svgTitle}</title>
            <desc id="dhm-plan-desc">{copy.svgDesc}</desc>

            <g stroke="#f4efe4" stroke-width={2.5 * ui} stroke-linecap="round">
              <line x1={scaleBar.x} y1={scaleBar.y} x2={scaleBar.x + scaleBar.length} y2={scaleBar.y} />
              <line x1={scaleBar.x} y1={scaleBar.y - 6 * ui} x2={scaleBar.x} y2={scaleBar.y + 6 * ui} />
              <line
                x1={scaleBar.x + scaleBar.length}
                y1={scaleBar.y - 6 * ui}
                x2={scaleBar.x + scaleBar.length}
                y2={scaleBar.y + 6 * ui}
              />
            </g>
            <text
              x={scaleBar.x + scaleBar.length / 2}
              y={scaleBar.y - 11 * ui}
              font-size={15 * ui}
              font-weight="700"
              fill="#f4efe4"
              text-anchor="middle"
              style="paint-order:stroke"
              stroke="#00000055"
              stroke-width={3 * ui}
            >
              {siteCopy.scaleBar(SITE_SCALE_BAR)}
            </text>

            <g transform={matrix}>
              {
                PLAN_FLOORS.map((floor) => (
                  <g
                    data-floor-layer={floor}
                    style={floor === PLAN_FLOORS[0] ? undefined : 'display:none'}
                  >
                    {byFloor[floor]!.map((cell) => (
                      <g data-cell={`${cell.floor}:${cell.number}`} class="cursor-pointer">
                        <polygon
                          points={cell.points}
                          fill={TONE[cell.grade]!.fill}
                          fill-opacity="0.88"
                          stroke="#ffffff"
                          stroke-width="0.3"
                          data-shape
                        />
                        <text
                          x={cell.cx}
                          y={cell.cy}
                          text-anchor="middle"
                          dominant-baseline="central"
                          font-size="2.1"
                          font-weight="700"
                          fill={TONE[cell.grade]!.text}
                          transform={`rotate(${cell.labelAngle} ${cell.cx} ${cell.cy})`}
                          pointer-events="none"
                        >
                          {cell.number}
                        </text>
                      </g>
                    ))}
                  </g>
                ))
              }
            </g>

            <g data-plan-pin style="display:none" pointer-events="none">
              <line data-pin-leader stroke="#15181d" stroke-width={1.6 * ui} />
              <circle data-pin-dot r={4.5 * ui} fill="none" stroke="#15181d" stroke-width={2 * ui} />
              <rect data-pin-box rx={5 * ui} height={24 * ui} fill="#15181d" />
              <text
                data-pin-text
                font-size={15 * ui}
                font-weight="700"
                fill="#ffffff"
                text-anchor="middle"
                dominant-baseline="central"
              />
            </g>
          </svg>
        </div>
      </div>

      <div
        class="grid gap-5 rounded-xl border border-line bg-paper-deep/40 p-5 sm:grid-cols-[1.3fr_1fr] sm:p-6"
      >
        <div>
          <p class="text-2xs font-bold tracking-[0.15em] text-ink-faint uppercase" data-plan-kicker>
            {copy.tapHint}
          </p>
          <h3 class="mt-2 font-serif text-lg leading-snug font-bold text-ink" data-plan-name>
            {copy.readTitle}
          </h3>
          <p class="mt-2 text-[0.8125rem] leading-relaxed text-ink-soft" data-plan-blurb>
            {copy.readBody}
          </p>
        </div>
        <dl
          class="hidden space-y-2.5 border-t border-line pt-4 text-[0.8125rem] sm:border-t-0 sm:border-l sm:pt-0 sm:pl-5"
          data-plan-facts
        >
        </dl>
      </div>

      <p class="text-xs leading-relaxed text-ink-faint">
        {copy.note(totalOnPlan, enumerated)}
        <a
          href={PHOTO.creditUrl}
          rel="noopener nofollow"
          target="_blank"
          class="text-brand underline decoration-brand/30 underline-offset-2 hover:text-gold"
        >
          {siteCopy.credit}{PHOTO.credit}
        </a>
      </p>
    </div>

    <section class="mt-8 rounded-xl border border-line bg-paper-deep/25 p-5 sm:p-6">
      <h3 class="font-serif text-base font-bold text-ink">{copy.connectingHeading}</h3>
      <p class="mt-1.5 text-[0.8125rem] leading-relaxed text-ink-soft">
        {copy.connectingIntro(connectingPairs.length)}<strong class="font-bold text-ink"
          >{copy.connectingEmphasis}</strong
        >{copy.connectingTail}
      </p>
      <ul class="mt-4 space-y-2.5">
        {
          connectingPairs.map((pair) => (
            <li class="rounded-lg border border-line-soft bg-card px-4 py-3">
              <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-[0.8125rem] text-ink">
                <span class="font-medium">{roomName(pair.rooms[0]!, 'dhm', locale)}</span>
                <span class="text-ink-faint" aria-hidden="true">
                  ●―●
                </span>
                <span class="font-medium">{roomName(pair.rooms[1]!, 'dhm', locale)}</span>
              </p>
              {locale === 'zh-hant' && pair.note && (
                <p class="mt-1.5 text-2xs leading-relaxed text-ink-faint">{pair.note}</p>
              )}
            </li>
          ))
        }
      </ul>
    </section>

    <div
      class="mt-6 flex flex-wrap gap-x-5 gap-y-2 border-t border-line-soft pt-5 text-xs text-ink-faint"
    >
      <span>{copy.balconyLegend}</span>
      <a
        href={sourceUrl}
        rel="noopener nofollow"
        target="_blank"
        class="ml-auto text-brand underline decoration-brand/30 underline-offset-2 hover:text-gold"
      >
        {copy.sourceLabel}
      </a>
    </div>
  </div>
</section>

<script
  is:inline
  define:vars={{
    payload,
    ui,
    text: {
      floorLabel: copy.floorLabel(0),
      tapHint: copy.tapHint,
      readTitle: copy.readTitle,
      readBody: copy.readBody,
      balcony: copy.detail.balcony,
      ambiguous: copy.detail.ambiguous,
      fromPlan: copy.detail.fromPlan,
      plain: copy.detail.plain,
      fields: copy.fields,
    },
  }}
>
  (() => {
    const root = document.querySelector('[data-miracosta-plan]');
    if (!root) return;

    const layers = Array.from(root.querySelectorAll('[data-floor-layer]'));
    const facts = root.querySelector('[data-plan-facts]');
    let active = null;

    const set = (selector, value) => {
      const node = root.querySelector(selector);
      if (node) node.textContent = value;
    };

    const floor = () => {
      const checked = root.querySelector('input[name="plan-floor"]:checked');
      return checked ? Number(checked.value) : 0;
    };

    function paintFloor() {
      const current = floor();
      layers.forEach((layer) => {
        layer.style.display = Number(layer.dataset.floorLayer) === current ? '' : 'none';
      });
      set('[data-plan-floor-label]', text.floorLabel.replace('0', String(current)));
    }

    const pin = root.querySelector('[data-plan-pin]');

    function clearActive() {
      root.querySelectorAll('[data-cell] [data-shape]').forEach((shape) => {
        shape.setAttribute('stroke', '#ffffff');
        shape.setAttribute('stroke-width', '1.2');
      });
      if (pin) pin.style.display = 'none';
    }

    /** A room is 18 px wide on the photo, so the number is called out instead. */
    function drawPin(room) {
      if (!pin) return;
      const width = (22 + String(room.number).length * 10) * ui;
      const up = room.vy > 180 * ui;
      const y = up ? room.vy - 34 * ui : room.vy + 34 * ui;
      pin.querySelector('[data-pin-dot]').setAttribute('cx', room.vx);
      pin.querySelector('[data-pin-dot]').setAttribute('cy', room.vy);
      const leader = pin.querySelector('[data-pin-leader]');
      leader.setAttribute('x1', room.vx);
      leader.setAttribute('y1', room.vy + (up ? -6 : 6) * ui);
      leader.setAttribute('x2', room.vx);
      leader.setAttribute('y2', up ? y + 12 * ui : y - 12 * ui);
      const box = pin.querySelector('[data-pin-box]');
      box.setAttribute('x', room.vx - width / 2);
      box.setAttribute('y', y - 12 * ui);
      box.setAttribute('width', width);
      const label = pin.querySelector('[data-pin-text]');
      label.setAttribute('x', room.vx);
      label.setAttribute('y', y);
      label.textContent = room.number;
      pin.style.display = '';
    }

    function select(key) {
      const room = payload[key];
      if (!room) return false;
      active = key;
      clearActive();
      const shape = root.querySelector(`[data-cell="${key}"] [data-shape]`);
      if (shape) {
        shape.setAttribute('stroke', '#15181d');
        shape.setAttribute('stroke-width', '2.6');
      }
      drawPin(room);

      set('[data-plan-kicker]', `${room.floor}F · ${room.number}`);
      set('[data-plan-name]', room.name);
      set(
        '[data-plan-blurb]',
        room.ambiguous
          ? text.ambiguous
          : room.fromPlan
            ? text.fromPlan
            : room.balcony
              ? text.balcony
              : text.plain,
      );

      if (facts) {
        const rows = [[text.fields.sees, room.grade], [text.fields.shows, room.shows]];
        if (room.size) rows.push([text.fields.area, room.size]);
        if (room.capacity) rows.push([text.fields.capacity, room.capacity]);
        facts.innerHTML = rows
          .map(
            ([term, value]) =>
              `<div class="flex justify-between gap-3"><dt class="shrink-0 text-ink-faint">${term}</dt><dd class="text-right font-bold text-ink">${value}</dd></div>`,
          )
          .join('');
        facts.classList.remove('hidden');
      }
      return true;
    }

    root.querySelectorAll('[data-cell]').forEach((node) => {
      node.addEventListener('click', () => select(node.dataset.cell));
    });

    root.addEventListener('change', (event) => {
      if (event.target && event.target.name === 'plan-floor') {
        paintFloor();
        if (active && !payload[`${floor()}:${active.split(':')[1]}`]) {
          active = null;
          clearActive();
          set('[data-plan-kicker]', text.tapHint);
          set('[data-plan-name]', text.readTitle);
          set('[data-plan-blurb]', text.readBody);
          if (facts) facts.classList.add('hidden');
        } else if (active) {
          select(`${floor()}:${active.split(':')[1]}`);
        }
      }
    });

    paintFloor();
  })();
</script>
