---
import type { MonthlyRates, Room, RoomCategory } from '~/data/hotel';
import { annualRangeOf } from '~/data/hotel';

interface Props {
  rooms: Room[];
  categories: RoomCategory[];
  rates: MonthlyRates;
  /** Months carrying `years.current` rates; the rest carry `years.carried`. */
  currentYearMonths: readonly number[];
  years: { current: string; carried: string };
  /** Room type the chart opens on. */
  defaultRoomId: string;
  source: { label: string; url: string };
  /** Why the cheap-floor months are not actually a low season. */
  bargainNote: string;
}

const {
  rooms,
  categories,
  rates,
  currentYearMonths,
  years,
  defaultRoomId,
  source,
  bargainNote,
} = Astro.props;

/** Months the source could only fill from the previous year's prices. */
const carriedOver = Array.from({ length: 12 }, (_, i) => i + 1).filter(
  (month) => !currentYearMonths.includes(month),
);

/**
 * Month-by-month rate ranges. Each bar spans that month's lowest to highest
 * rate, so its position shows the season and its width shows how much the date
 * matters. The source has no day-of-week breakdown, so the spread cannot be
 * attributed to weekends specifically.
 */

const categoryLabel = Object.fromEntries(categories.map((c) => [c.key, c.label]));

const priced = rooms.filter((room) => rates[room.id]).map((room) => {
  const months = rates[room.id]!;
  const range = annualRangeOf(rates, room.id)!;
  const entries = Object.entries(months)
    .map(([month, value]) => ({ month: Number(month), low: value![0], high: value![1] }))
    .sort((a, b) => a.month - b.month);
  const cheapest = entries.reduce((min, e) => (e.low < min.low ? e : min));
  const dearest = entries.reduce((max, e) => (e.high > max.high ? e : max));
  return {
    id: room.id,
    name: room.name,
    category: categoryLabel[room.category] ?? '',
    low: range[0],
    high: range[1],
    ratio: Math.round((range[1] / range[0]) * 100) / 100,
    months: entries,
    cheapest: cheapest.month,
    dearest: dearest.month,
    /** True when the source does not publish all twelve months. */
    partial: entries.length < 12,
  };
});

const unpriced = rooms.filter((room) => !rates[room.id]);

/** Shared scale so bars are comparable when switching room type. */
const scaleFor = (low: number, high: number) => {
  const pad = (high - low) * 0.12 || 1;
  return { min: low - pad, max: high + pad };
};

const defaultRoom = priced.find((room) => room.id === defaultRoomId) ?? priced[0]!;
const payload = priced.map((room) => ({ ...room, scale: scaleFor(room.low, room.high) }));

/**
 * Seasonality across room types. Both ends of each month are indexed against the
 * same reference — the cheapest date of that room's whole year — so the floor and
 * the ceiling sit on one comparable scale and room types at very different price
 * points can be averaged together.
 *
 * Reading only the floor is misleading: July and August hold the year's cheapest
 * dates while also carrying a ceiling well above June's, which is what a school
 * holiday looks like in this data.
 */
const twelve = priced.filter((room) => room.months.length === 12 && room.low !== room.high);
const mean = (values: number[]) => values.reduce((a, b) => a + b, 0) / values.length;
const season = Array.from({ length: 12 }, (_, i) => {
  const month = i + 1;
  const samples = twelve.map((room) => {
    const entry = room.months.find((m) => m.month === month)!;
    return { floor: entry.low / room.low, ceiling: entry.high / room.low };
  });
  const floor = mean(samples.map((s) => s.floor));
  const ceiling = mean(samples.map((s) => s.ceiling));
  return { month, floor, ceiling, spread: ceiling - floor };
});
const axisMax = Math.max(...season.map((s) => s.ceiling));
const pct = (value: number) => Math.round((value - 1) * 100);

const byCeiling = [...season].sort((a, b) => a.ceiling - b.ceiling);
const bySpread = [...season].sort((a, b) => a.spread - b.spread);
const byFloor = [...season].sort((a, b) => a.floor - b.floor);
const safestMonth = byCeiling[0]!;
const worstMonth = byCeiling[byCeiling.length - 1]!;
const flattestMonth = bySpread[0]!;
const swingiestMonth = bySpread[bySpread.length - 1]!;
/** Months whose floor is at the very bottom but whose ceiling is not. */
const bargainMonths = season.filter(
  (m) => m.floor <= byFloor[0]!.floor + 0.04 && m.ceiling > safestMonth.ceiling,
);
const monthLabel = (m: number) => `${m} 月`;
---

<section id="price-seasons" class="not-prose scroll-mt-32">
  <div class="rounded-2xl border border-line bg-card p-5 sm:p-7">
    <h2 class="font-serif text-xl font-bold text-ink sm:text-2xl">逐月價格區間</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-ink-soft">
      每一條橫棒是那個月「最便宜的日期」到「最貴的日期」。棒子的位置看淡旺季，棒子的長度看同一個月裡日期的影響有多大。選一個房型看它整年的樣子。
    </p>

    <div class="mt-6 rounded-xl border border-line bg-paper-deep/40 p-5">
      <h3 class="font-serif text-base font-bold text-ink">淡旺季：光看底價會看錯</h3>
      <p class="mt-1.5 text-[0.8125rem] leading-relaxed text-ink-soft">
        {twelve.length} 種有完整十二個月資料的房型，各自以「自己全年最便宜的那一天」為 100
        對齊後平均。每條棒子的左端是那個月最便宜的日期、右端是最貴的日期。棒子的高度看貴不貴，長度看挑日子有多重要。
      </p>

      <ul class="mt-4 space-y-1">
        {
          season.map((entry) => (
            <li class="flex items-center gap-2">
              <span class="w-9 shrink-0 text-right text-2xs text-ink-faint tabular-nums">
                {monthLabel(entry.month)}
              </span>
              <span class="relative h-4 flex-1 rounded bg-paper">
                <span
                  class="absolute inset-y-0 rounded"
                  style={`left:${((entry.floor - 1) / (axisMax - 1)) * 100}%;right:${
                    100 - ((entry.ceiling - 1) / (axisMax - 1)) * 100
                  }%;background:${
                    entry.ceiling === worstMonth.ceiling
                      ? '#8c2f4a'
                      : entry.ceiling === safestMonth.ceiling
                        ? '#0f4c5c'
                        : '#5b93a1'
                  }`}
                />
              </span>
              <span class="w-20 shrink-0 text-2xs text-ink-soft tabular-nums">
                +{pct(entry.floor)}~{pct(entry.ceiling)}%
              </span>
            </li>
          ))
        }
      </ul>

      <ul class="mt-4 space-y-2 border-t border-line pt-4 text-[0.8125rem] leading-relaxed text-ink-soft">
        <li>
          <span class="font-bold text-ink">
            {bargainMonths.map((m) => monthLabel(m.month)).join('、')}有全年最便宜的日期，但不是淡季。
          </span>
          它們的底價是全年最低，天花板卻比 {monthLabel(safestMonth.month)} 高出不少——{bargainNote}
        </li>
        <li>
          <span class="font-bold text-ink">真正整月都便宜的是 {monthLabel(safestMonth.month)}</span>
          ，天花板全年最低（+{pct(safestMonth.ceiling)}%），也就是不太需要挑日子。最該避開的是
          {monthLabel(worstMonth.month)}，最貴的日期到 +{pct(worstMonth.ceiling)}%。
        </li>
        <li>
          <span class="font-bold text-ink">{monthLabel(flattestMonth.month)}是「怎麼選都一樣」的月份</span>
          ，月內落差全年最小，底價卻已經是 +{pct(flattestMonth.floor)}%，等於沒有便宜的日子可挑；{
            monthLabel(swingiestMonth.month)
          }相反，落差全年最大，值得為了日期調整行程。
        </li>
      </ul>
    </div>

    <div class="mt-6">
      <label class="flex flex-wrap items-center gap-2 text-sm text-ink-soft">
        房型
        <select
          data-rate-room
          class="max-w-full rounded-lg border border-line bg-paper px-3 py-2 text-sm text-ink transition-colors hover:bg-paper-deep focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
        >
          {
            categories.map((category) => (
              <optgroup label={category.label}>
                {priced
                  .filter((room) => room.category === category.label)
                  .map((room) => (
                    <option value={room.id} selected={room.id === defaultRoom.id}>
                      {room.name}
                    </option>
                  ))}
              </optgroup>
            ))
          }
        </select>
      </label>
    </div>

    <dl class="mt-5 grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-4">
      {
        [
          { key: 'low', label: '全年最低', sub: '最便宜的日期' },
          { key: 'high', label: '全年最高', sub: '最貴的日期' },
          { key: 'ratio', label: '最高／最低', sub: '同一間房的倍數' },
          { key: 'season', label: '最便宜／最貴', sub: '以月份看' },
        ].map((item) => (
          <div class="bg-card px-4 py-4">
            <dt class="text-2xs tracking-[0.12em] text-ink-faint uppercase">{item.label}</dt>
            <dd
              class="mt-1 font-serif text-lg font-bold text-brand-deep sm:text-xl"
              data-rate-stat={item.key}
            />
            <dd class="mt-0.5 text-xs text-ink-faint">{item.sub}</dd>
          </div>
        ))
      }
    </dl>

    <div class="mt-6">
      <div class="flex items-baseline justify-between text-2xs text-ink-faint tabular-nums">
        <span data-rate-axis-min></span>
        <span data-rate-axis-max></span>
      </div>
      <ul class="mt-2 space-y-1.5" data-rate-chart></ul>
      <p class="mt-3 text-xs text-ink-faint" data-rate-note></p>
    </div>

    <div class="mt-6 border-t border-line-soft pt-5 text-xs leading-relaxed text-ink-faint">
      <p>
        每室每晚、2 位大人。整理自
        <a
          href={source.url}
          rel="noopener nofollow"
          target="_blank"
          class="text-brand underline decoration-brand/30 underline-offset-2 hover:text-gold"
          >{source.label}</a
        >，是二手來源；官方只逐日標價，沒有發布月費率。{carriedOver.length > 0 && `${carriedOver.join('、')} 月為前一年價格。`}{
          unpriced.length > 0 && `另有 ${unpriced.length} 種房型只公布起價。`
        }
      </p>
    </div>
  </div>
</section>

<script
  is:inline
  define:vars={{
    payload,
    currentYearMonths,
    labelCurrent: years.current,
    labelCarried: years.carried,
  }}
>
  (() => {
    const root = document.querySelector('#price-seasons');
    if (!root) return;
    const select = root.querySelector('[data-rate-room]');
    const chart = root.querySelector('[data-rate-chart]');
    const note = root.querySelector('[data-rate-note]');
    if (!select || !chart || !note) return;

    const rooms = new Map(payload.map((room) => [room.id, room]));
    const yen = (n) => `¥${n.toLocaleString('en-US')}`;
    const currentYear = new Set(currentYearMonths);

    function render() {
      const room = rooms.get(select.value);
      if (!room) return;
      const { min, max } = room.scale;
      const span = max - min || 1;

      const stat = (key, value) => {
        const node = root.querySelector(`[data-rate-stat="${key}"]`);
        if (node) node.textContent = value;
      };
      stat('low', yen(room.low));
      stat('high', yen(room.high));
      const flat = room.low === room.high;
      stat('ratio', flat ? '全年同價' : `${room.ratio.toFixed(2)} 倍`);
      stat('season', flat ? '全年一價' : `${room.cheapest} 月／${room.dearest} 月`);

      const axisMin = root.querySelector('[data-rate-axis-min]');
      const axisMax = root.querySelector('[data-rate-axis-max]');
      if (axisMin) axisMin.textContent = yen(Math.round(min / 1000) * 1000);
      if (axisMax) axisMax.textContent = yen(Math.round(max / 1000) * 1000);

      chart.innerHTML = room.months
        .map((m) => {
          const left = ((m.low - min) / span) * 100;
          const width = Math.max(((m.high - m.low) / span) * 100, 1.5);
          const cheapest = m.month === room.cheapest;
          const dearest = m.month === room.dearest;
          const tone = dearest ? '#8c2f4a' : cheapest ? '#0f4c5c' : '#5b93a1';
          const year = currentYear.has(m.month) ? labelCurrent : labelCarried;
          return `<li class="flex items-center gap-2">
            <span class="w-9 shrink-0 text-right text-2xs text-ink-faint tabular-nums">${m.month} 月</span>
            <span class="relative h-5 flex-1 rounded bg-paper-deep/70">
              <span class="absolute inset-y-0 rounded" style="left:${left}%;width:${width}%;background:${tone}"
                title="${year} 年 ${m.month} 月：${yen(m.low)} – ${yen(m.high)}"></span>
            </span>
            <span class="w-40 shrink-0 text-2xs text-ink-soft tabular-nums">${yen(m.low)} – ${yen(m.high)}</span>
          </li>`;
        })
        .join('');

      const coverage = room.partial
        ? `這個房型的來源只公布 ${room.months[0].month} 到 ${room.months[room.months.length - 1].month} 月。`
        : '';
      note.textContent = flat
        ? `${coverage}這個房型全年一價，不分日期與季節。`
        : `${coverage}深色是最便宜的月份，紅色是最貴的。`;
    }

    select.addEventListener('change', render);
    render();
  })();
</script>
