---
import { FAQS } from '~/data/tokyo-disneyland-hotel';
---

<div class="not-prose my-8 divide-y divide-line overflow-hidden rounded-xl border border-line bg-card">
  {
    FAQS.map((faq, index) => (
      <details class="group" open={index === 0}>
        <summary class="flex cursor-pointer list-none items-start gap-3 px-5 py-4 transition-colors hover:bg-paper-deep/50">
          <span
            class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-line text-ink-faint transition-transform duration-300 group-open:rotate-45"
            aria-hidden="true"
          >
            <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
              <path d="M5 1v8M1 5h8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
            </svg>
          </span>
          <span class="font-serif text-[0.9375rem] leading-snug font-bold text-ink">
            {faq.question}
          </span>
        </summary>
        <p class="px-5 pb-5 pl-13 text-[0.875rem] leading-[1.95] text-ink-soft">{faq.answer}</p>
      </details>
    ))
  }
</div>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>
