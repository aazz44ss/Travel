---
import type { BedSpec } from '~/data/hotel-schema';

interface Props {
  specs: BedSpec[];
  /** Screen-reader caption; name the hotel so the table stands alone. */
  caption: string;
}

const { specs, caption } = Astro.props;
---

<div class="not-prose my-8">
  <div class="table-scroll overflow-hidden rounded-xl border border-line bg-card">
    <table class="w-full min-w-[42rem] text-sm">
      <caption class="sr-only">{caption}</caption>
      <thead>
        <tr class="bg-paper-deep text-left">
          <th scope="col" class="px-4 py-3 font-bold text-ink">床型</th>
          <th scope="col" class="px-4 py-3 font-bold text-ink">尺寸（寬 × 長 × 高）</th>
          <th scope="col" class="px-4 py-3 font-bold text-ink">人數上限</th>
          <th scope="col" class="px-4 py-3 font-bold text-ink">實際感受</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-line-soft">
        {
          specs.map((bed) => (
            <tr class="align-top transition-colors hover:bg-paper-deep/40">
              <th scope="row" class="px-4 py-3.5 text-left font-bold text-ink">
                {bed.name}
                <span class="mt-0.5 block text-2xs font-normal text-ink-faint">{bed.nameJa}</span>
              </th>
              <td class="px-4 py-3.5 whitespace-nowrap text-ink-soft tabular-nums">{bed.size}</td>
              <td class="px-4 py-3.5 text-ink-soft">{bed.capacity}</td>
              <td class="px-4 py-3.5 leading-relaxed text-ink-soft">{bed.note}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <p class="mt-3 text-xs leading-relaxed text-ink-faint">
    「不佔床孩童」指 11
    歲以下、與大人同床且不另計費的兒童。飯店的人數上限同時受床位數與房型定員限制，訂房時系統會擋掉超額的組合。
  </p>
</div>
