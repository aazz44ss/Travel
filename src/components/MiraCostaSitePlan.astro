---
import {
  FRONTAGE,
  HARBOUR,
  HOTEL_FOOTPRINT,
  SITE_SCALE_BAR,
  SITE_VIEW,
  type Point,
} from '~/data/dhm-site';
import { DEFAULT_LOCALE, type Locale } from '~/i18n/config';
import { explorer } from '~/i18n/explorer';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const copy = explorer(locale).site;

/**
 * Metres straight into SVG user units: one metre is one unit, so a distance on
 * screen is a distance on the ground and the scale bar means what it says.
 */
const width = SITE_VIEW.x1 - SITE_VIEW.x0;
const height = SITE_VIEW.y1 - SITE_VIEW.y0;
const path = (points: Point[]) =>
  points.map(([x, y]) => `${(x - SITE_VIEW.x0).toFixed(1)},${(y - SITE_VIEW.y0).toFixed(1)}`).join(' ');

/** Anchors for the labels, in the same metres. */
const at = (x: number, y: number) => ({ x: x - SITE_VIEW.x0, y: y - SITE_VIEW.y0 });
const harbourLabel = at(-190, 60);
const canalLabel = at(-26, 128);
const hotelLabel = at(-40, -60);
const bar = { x: 20, y: height - 26 };
---

<figure class="not-prose mt-6 rounded-xl border border-line bg-[#eef4f5] p-3">
  <svg
    viewBox={`0 0 ${width} ${height}`}
    class="h-auto w-full"
    role="img"
    aria-labelledby="dhm-site-title dhm-site-desc"
  >
    <title id="dhm-site-title">{copy.title}</title>
    <desc id="dhm-site-desc">{copy.desc}</desc>

    <polygon points={path(HARBOUR)} fill="#bfdde3" stroke="#8fbfc9" stroke-width="1.2" />
    <polygon points={path(HOTEL_FOOTPRINT)} fill="#e8ddc8" stroke="#a98c5f" stroke-width="1.6" />
    {
      FRONTAGE.map((stretch) => (
        <polyline
          points={path(stretch)}
          fill="none"
          stroke="#0f4c5c"
          stroke-width="4"
          stroke-linecap="round"
        />
      ))
    }

    <text x={harbourLabel.x} y={harbourLabel.y} font-size="15" font-weight="700" fill="#3f7d8a">
      {copy.harbour}
    </text>
    <text x={canalLabel.x} y={canalLabel.y} font-size="11" fill="#3f7d8a">{copy.lagoon}</text>
    <text x={at(-150, -34).x} y={at(-150, -34).y} font-size="11" font-weight="700" fill="#0f4c5c">
      {copy.frontage}
    </text>
    <text x={hotelLabel.x} y={hotelLabel.y} font-size="12" font-weight="700" fill="#7a6136">
      {copy.hotel}
    </text>

    <g>
      <line
        x1={bar.x}
        y1={bar.y}
        x2={bar.x + SITE_SCALE_BAR}
        y2={bar.y}
        stroke="#4f4739"
        stroke-width="2"
      />
      <line x1={bar.x} y1={bar.y - 5} x2={bar.x} y2={bar.y + 5} stroke="#4f4739" stroke-width="2" />
      <line
        x1={bar.x + SITE_SCALE_BAR}
        y1={bar.y - 5}
        x2={bar.x + SITE_SCALE_BAR}
        y2={bar.y + 5}
        stroke="#4f4739"
        stroke-width="2"
      />
      <text x={bar.x + SITE_SCALE_BAR / 2} y={bar.y - 9} font-size="12" fill="#4f4739" text-anchor="middle">
        {copy.scaleBar(SITE_SCALE_BAR)}
      </text>
    </g>
  </svg>

  <figcaption class="mt-2 text-xs leading-relaxed text-ink-faint">
    {copy.caption}
    <a
      href="https://www.openstreetmap.org/copyright"
      rel="noopener nofollow"
      target="_blank"
      class="text-brand underline decoration-brand/30 underline-offset-2 hover:text-gold"
    >
      © OpenStreetMap contributors
    </a>
  </figcaption>
</figure>
