---
import type { Room, RoomLayoutSet } from '~/data/hotel';

interface Props {
  room: Room;
  layouts: RoomLayoutSet;
}

const { room, layouts } = Astro.props;
const ref = layouts.refs[room.id];

/**
 * The hotel's own plan drawing for this room type, served from the resort's CDN
 * rather than copied here. Several official pages cover more than one of our
 * variants, in which case the drawing shows both plans side by side.
 */
const shared = ref
  ? Object.entries(layouts.refs).filter(
      ([, other]) => other.slug === ref.slug && (other.layout ?? 1) === (ref.layout ?? 1),
    ).length > 1
  : false;
---

{
  ref && (
    <figure class="not-prose mt-3 overflow-hidden rounded-lg border border-line-soft bg-white">
      <img
        src={layouts.imageUrl(ref)}
        width={layouts.imageSize.width}
        height={layouts.imageSize.height}
        loading="lazy"
        decoding="async"
        referrerpolicy="no-referrer"
        alt={`${room.name}的官方平面圖`}
        class="block h-auto w-full"
      />
      <figcaption class="flex flex-wrap items-center gap-x-2 gap-y-1 border-t border-line-soft px-3 py-2 text-2xs text-ink-faint">
        <span class="font-medium text-ink-soft">{room.size} m²</span>
        {shared && <span>官方同一頁涵蓋數種床型，圖上並列</span>}
        <a
          href={layouts.pageUrl(ref)}
          rel="noopener nofollow"
          target="_blank"
          class="ml-auto text-brand underline decoration-brand/30 underline-offset-2 hover:text-gold"
        >
          官方平面圖
        </a>
      </figcaption>
    </figure>
  )
}
