---
import { DEFAULT_LOCALE, type Locale } from '~/i18n/config';
import { explorer } from '~/i18n/explorer';

/**
 * The hotel's own plan drawing for one room type, served from the resort's CDN
 * rather than copied here, so the drawing is always the current official one.
 * Which drawing belongs to which room type is the hotel dataset's business, so
 * the caller resolves it and passes the result in.
 */
interface Props {
  /** Localised room name, used for the alt text. */
  name: string;
  size: string;
  src: string;
  /** Official room page the drawing came from. */
  href: string;
  width: number;
  height: number;
  /** Set when the official page's drawing covers more than one of our variants. */
  shared?: boolean;
  locale?: Locale;
}

const {
  name,
  size,
  src,
  href,
  width,
  height,
  shared = false,
  locale = DEFAULT_LOCALE,
} = Astro.props;
const ex = explorer(locale);
---

<figure class="not-prose mt-3 overflow-hidden rounded-lg border border-line-soft bg-white">
  <img
    src={src}
    width={width}
    height={height}
    loading="lazy"
    decoding="async"
    referrerpolicy="no-referrer"
    alt={`${name} — ${ex.layoutCaption.official}`}
    class="block h-auto w-full"
  />
  <figcaption
    class="flex flex-wrap items-center gap-x-2 gap-y-1 border-t border-line-soft px-3 py-2 text-2xs text-ink-faint"
  >
    <span class="font-medium text-ink-soft">{size} m²</span>
    {shared && <span>{ex.layoutCaption.shared}</span>}
    <a
      href={href}
      rel="noopener nofollow"
      target="_blank"
      class="ml-auto text-brand underline decoration-brand/30 underline-offset-2 hover:text-gold"
    >
      {ex.layoutCaption.official}
    </a>
  </figcaption>
</figure>
