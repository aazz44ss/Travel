---
import type { Room } from '~/data/hotel-schema';

interface Props {
  room: Room;
  /** Absolute URL of the hotel's own plan drawing, served from the resort CDN. */
  src?: string;
  /** Official room page the drawing came from. */
  href?: string;
  width: number;
  height: number;
  /** Set when the official page's drawing covers more than one of our variants. */
  shared?: boolean;
}

const { room, src, href, width, height, shared = false } = Astro.props;
---

{
  src && (
    <figure class="not-prose mt-3 overflow-hidden rounded-lg border border-line-soft bg-white">
      <img
        src={src}
        width={width}
        height={height}
        loading="lazy"
        decoding="async"
        referrerpolicy="no-referrer"
        alt={`${room.name}的官方平面圖`}
        class="block h-auto w-full"
      />
      <figcaption class="flex flex-wrap items-center gap-x-2 gap-y-1 border-t border-line-soft px-3 py-2 text-2xs text-ink-faint">
        <span class="font-medium text-ink-soft">{room.size} m²</span>
        {shared && <span>官方同一頁涵蓋數種床型，圖上並列</span>}
        {href && (
          <a
            href={href}
            rel="noopener nofollow"
            target="_blank"
            class="ml-auto text-brand underline decoration-brand/30 underline-offset-2 hover:text-gold"
          >
            官方平面圖
          </a>
        )}
      </figcaption>
    </figure>
  )
}
