---
import { DEFAULT_LOCALE, LOCALES, LOCALE_META, localePath, type Locale } from '~/i18n/config';
import { t } from '~/i18n/ui';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const ui = t(locale);

const links = [
  { label: ui.nav.home, href: '/' },
  { label: ui.nav.articles, href: '/articles' },
  { label: ui.nav.database, href: '/hotels' },
  { label: ui.nav.about, href: '/about' },
];

const current = Astro.url.pathname.replace(/\/+$/, '') || '/';

function isActive(href: string): boolean {
  const target = localePath(locale, href).replace(/\/+$/, '') || '/';
  const root = localePath(locale, '/').replace(/\/+$/, '') || '/';
  if (target === root) return current === root;
  return current.startsWith(target);
}

/** The same page in the other locales; falls back to their home page. */
const pagePath = (() => {
  const root = localePath(locale, '/').replace(/\/+$/, '');
  const rest = current.startsWith(root) ? current.slice(root.length) : '';
  return rest || '/';
})();
---

<header class="sticky top-0 z-50 border-b border-line/80 bg-paper/85 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-6 px-5 sm:px-8">
    <a href={localePath(locale, '/')} class="group flex shrink-0 items-center gap-2.5">
      <span
        class="flex h-9 w-9 items-center justify-center rounded-full bg-brand text-[15px] font-bold text-white transition-transform duration-300 group-hover:-rotate-12"
        style="font-family: var(--font-serif)"
        aria-hidden="true">{ui.site.name.charAt(0)}</span
      >
      <span class="flex flex-col leading-none">
        <span class="font-serif text-[17px] font-bold tracking-wide text-ink">{ui.site.name}</span>
        <span class="mt-0.5 text-2xs tracking-[0.18em] text-ink-faint uppercase">Trip Homework</span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 md:ml-auto md:flex" aria-label={ui.nav.primary}>
      {
        links.map((link) => (
          <a
            href={localePath(locale, link.href)}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={[
              'rounded-full px-3.5 py-2 text-sm transition-colors duration-200',
              isActive(link.href)
                ? 'bg-brand-soft font-medium text-brand-deep'
                : 'text-ink-soft hover:bg-paper-deep hover:text-ink',
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <nav class="ml-auto flex items-center gap-1 md:ml-3" aria-label={ui.common.languageLabel}>
      {
        LOCALES.map((code) => (
          <a
            href={localePath(code, pagePath)}
            hreflang={LOCALE_META[code].htmlLang}
            lang={LOCALE_META[code].htmlLang}
            aria-current={code === locale ? 'true' : undefined}
            class:list={[
              'rounded-full px-2.5 py-1.5 text-xs transition-colors duration-200',
              code === locale
                ? 'bg-ink/85 font-medium text-white'
                : 'text-ink-faint hover:bg-paper-deep hover:text-ink',
            ]}
          >
            {LOCALE_META[code].shortLabel}
          </a>
        ))
      }
    </nav>

    <details class="relative md:hidden">
      <summary
        class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-full border border-line text-ink-soft transition-colors hover:bg-paper-deep"
        aria-label={ui.nav.menu}
      >
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path
            d="M2 4.5h14M2 9h14M2 13.5h14"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"></path>
        </svg>
      </summary>
      <div
        class="absolute right-0 mt-3 w-52 overflow-hidden rounded-xl border border-line bg-card shadow-xl shadow-ink/5"
      >
        {
          links.map((link) => (
            <a
              href={localePath(locale, link.href)}
              class:list={[
                'block border-b border-line-soft px-4 py-3 text-sm last:border-0 transition-colors',
                isActive(link.href)
                  ? 'bg-brand-soft font-medium text-brand-deep'
                  : 'text-ink-soft hover:bg-paper-deep',
              ]}
            >
              {link.label}
            </a>
          ))
        }
      </div>
    </details>
  </div>
</header>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>
