---
import { formatYen } from '~/data/hotel';

/**
 * One room type, priced by view. Isolating a single room type makes the view
 * premium legible in a way the full price table cannot, because the only
 * variable left is the window.
 */

export type LadderTone = 'muted' | 'mid' | 'full';

export interface Rung {
  view: string;
  price: number;
  note: string;
  tone: LadderTone;
}

interface Props {
  title: string;
  caption: string;
  rungs: Rung[];
  footnote: string;
}

const { title, caption, rungs, footnote } = Astro.props;

const base = rungs[0]!.price;
const max = Math.max(...rungs.map((r) => r.price));

const toneStyle: Record<LadderTone, string> = {
  muted: 'bg-ink-faint/45',
  mid: 'bg-brand/55',
  full: 'bg-brand',
};
---

<figure class="not-prose my-10 rounded-xl border border-line bg-card p-5 sm:p-7">
  <figcaption class="mb-5">
    <p class="font-serif text-base font-bold text-ink">{title}</p>
    <p class="mt-1 text-xs leading-relaxed text-ink-faint">{caption}</p>
  </figcaption>

  <ul class="space-y-4">
    {
      rungs.map((rung) => (
        <li>
          <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
            <span class="text-sm font-bold text-ink">{rung.view}</span>
            <span class="text-sm font-bold text-brand-deep">
              {formatYen(rung.price)}
              {rung.price > base && (
                <span class="ml-1.5 text-xs font-normal text-gold">
                  ＋{formatYen(rung.price - base)}
                </span>
              )}
            </span>
          </div>
          <div class="mt-1.5 h-2.5 overflow-hidden rounded-full bg-paper-deep">
            <div
              class:list={['h-full rounded-full', toneStyle[rung.tone]]}
              style={`width: ${Math.round((rung.price / max) * 100)}%`}
            />
          </div>
          <p class="mt-1.5 text-xs text-ink-soft">{rung.note}</p>
        </li>
      ))
    }
  </ul>

  <p class="mt-5 border-t border-line-soft pt-4 text-[0.8125rem] leading-relaxed text-ink-soft">
    {footnote}
  </p>
</figure>
