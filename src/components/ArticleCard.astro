---
import type { CollectionEntry } from 'astro:content';
import { articleSlug } from '~/content.config';
import { DEFAULT_LOCALE, formatDateShort, localePath, type Locale } from '~/i18n/config';
import { t } from '~/i18n/ui';

interface Props {
  article: CollectionEntry<'articles'>;
  featured?: boolean;
  locale?: Locale;
}

const { article, featured = false, locale = DEFAULT_LOCALE } = Astro.props;
const ui = t(locale);
const { data } = article;

const accentClass = {
  teal: 'from-brand-deep to-brand',
  gold: 'from-[#8a6420] to-gold',
  berry: 'from-[#5f1f31] to-berry',
}[data.accent];
---

<article
  class:list={[
    'group relative flex flex-col overflow-hidden rounded-2xl border border-line bg-card transition-all duration-300 hover:-translate-y-0.5 hover:shadow-xl hover:shadow-ink/5',
    featured && 'md:flex-row',
  ]}
>
  <div
    class:list={[
      'relative flex shrink-0 flex-col justify-end bg-gradient-to-br p-6 text-white',
      accentClass,
      featured ? 'md:w-[42%] md:p-8' : 'h-40',
    ]}
  >
    <div
      class="pointer-events-none absolute inset-0 opacity-25"
      style="background-image: radial-gradient(circle at 22% 18%, rgba(255,255,255,.55), transparent 42%), radial-gradient(circle at 82% 72%, rgba(255,255,255,.3), transparent 46%)"
      aria-hidden="true"
    >
    </div>
    <p class="relative text-2xs font-bold tracking-[0.22em] uppercase opacity-80">
      {data.country}
    </p>
    <p class:list={['relative mt-1 font-serif font-bold', featured ? 'text-2xl' : 'text-lg']}>
      {data.destination}
    </p>
    {
      featured && data.heroKicker && (
        <p class="relative mt-3 max-w-xs text-sm leading-relaxed opacity-90">{data.heroKicker}</p>
      )
    }
  </div>

  <div class:list={['flex flex-1 flex-col p-6', featured && 'md:p-8']}>
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-ink-faint">
      <time datetime={data.publishedAt.toISOString()}>{formatDateShort(data.publishedAt, locale)}</time>
      <span aria-hidden="true">·</span>
      <span>{ui.common.readingTime(data.readingMinutes)}</span>
      {
        data.updatedAt && (
          <>
            <span aria-hidden="true">·</span>
            <span class="text-brand">{ui.common.updatedOn(formatDateShort(data.updatedAt, locale))}</span>
          </>
        )
      }
    </div>

    <h3
      class:list={[
        'mt-2.5 font-serif leading-snug font-bold text-ink',
        featured ? 'text-xl sm:text-2xl' : 'text-lg',
      ]}
    >
      <a href={localePath(locale, `/articles/${articleSlug(article.id)}`)} class="after:absolute after:inset-0">
        <span class="bg-gradient-to-r from-gold to-gold bg-[length:0%_1px] bg-bottom bg-no-repeat transition-[background-size] duration-300 group-hover:bg-[length:100%_1px]">
          {data.cardTitle ?? data.title}
        </span>
      </a>
    </h3>

    <p class="mt-3 text-sm leading-relaxed text-ink-soft">{data.description}</p>

    <ul class="mt-auto flex flex-wrap gap-1.5 pt-5">
      {
        data.tags.slice(0, featured ? 5 : 3).map((tag) => (
          <li class="rounded-full bg-paper-deep px-2.5 py-1 text-2xs text-ink-soft">#{tag}</li>
        ))
      }
    </ul>
  </div>
</article>
