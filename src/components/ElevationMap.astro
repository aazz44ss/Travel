---
import CourtPlan from '~/components/CourtPlan.astro';
import {
  jitter,
  spiral,
  TRIM,
  TRIM_LINE,
  WALL_DARK,
  WALL_LIGHT,
} from '~/components/elevation-draw';
import {
  ELEVATIONS,
  ROSE_ROOMS,
  ROSE_ROOM_COUNT,
  type ElevationFace,
  type RoseCategory,
} from '~/data/fsh-rose-court';
import { ROOMS } from '~/data/fantasy-springs-hotel';
import { DEFAULT_LOCALE, type Locale } from '~/i18n/config';
import { categoryLabel, roomName } from '~/i18n/rooms';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;

const COPY: Record<Locale, {
  heading: (n: number) => string;
  intro: string;
  /** Why the only view tier here is Park View, when the hotel publishes two. */
  viewNote: string;
  count: (n: number) => string;
  numberBand: (band: string) => string;
  floor: (n: number) => string;
  figureAlt: (face: string, n: number) => string;
  unlisted: string;
  unlistedWhy: string;
  tableCaption: (face: string) => string;
  roomHeader: string;
  typeHeader: string;
  plan: {
    alt: string;
    miniAlt: (face: string) => string;
    /** Short tags for the walls. The full face names are too long for a plan. */
    faces: Record<string, string>;
    court: string;
    springs: string;
    toPark: string;
    sights: Record<string, string>;
    north: string;
    scaleBar: string;
    note: string;
  };
  faces: Record<string, { label: string; outlook: string }>;
  photo: string;
  method: string;
  tracedAlt: string;
  tracedCaption: string;
  tracedLink: string;
  caveat: (positions: number) => string;
}> = {
