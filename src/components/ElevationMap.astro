    method:
      'These three elevations are measured off photographs rather than sketched. The room-by-room survey marked up three photographs of the courtyard, and once a photograph is corrected back to a head-on view its bay widths and storey heights can be read straight off. So the spacing of the windows, the height of the floors, and the one-bay step back between positions 208 and 209 on the Grand Chateau side are all measured, not assumed. The window frames, sills and the ornament above each head are traced from the hotel’s own exterior photography. The courtyard photographs belong to their author; each elevation links to them.',
    caveat: (positions) =>
      `Positions and categories come from fukufukusatoka’s room-by-room survey, which states that it contains the author’s inference. The reason to trust it anyway is that it reconciles: the ${positions} positions above split into exactly the six category totals the hotel publishes, and a single mislabelled cell would break that arithmetic. One position belongs nowhere — 8301, because the published Superior floor bands stop at the 7th floor and nothing says how the 8th-floor room is sold.`,
  },
};

const c = COPY[locale];

/**
 * The Rose Court Side drawn as what its source actually is: three elevations of
 * the courtyard, one window per room. The elevation is the honest shape here —
 * the survey marked up photographs of the three facades, not floor plans — and
 * it is also the shape the reader needs, because on this side the room number is
 * a coordinate: the leading digit is the floor and the last three fix the column.
 *
 * The proportions are measured (see `bays` in the data), so the drawing carries
 * information a uniform grid throws away: the Grand Chateau side really does
 * step back by a bay between 208 and 209, and the three positions beyond that
 * step really do stop a storey lower.
 */

const displayName = new Map(ROOMS.map((room) => [room.id, roomName(room, 'fsh', locale)]));
const tally = roseCourtTally();

/** Drawing units. One unit is one CSS pixel at the elevation's natural size. */
const BAY = 54; // horizontal pitch between window centres
const STOREY = 50; // vertical pitch between window centres
const WIN_W = 38;
const WIN_H = 30;
const FRAME = 4; // thickness of the window surround
const GUTTER = 30; // left margin holding the floor labels
const EDGE = 18; // wall that runs off the frame, because the facade turns a corner
const TOP = 74; // headroom for the parapet and its crest
const BASE = 28; // the courtyard rockwork

/**
 * Glass tints, dark enough for the room number to sit on them in white. The
 * measured colour of the real glazing is a mid sage, which the alcove rooms keep
 * because they are 118 of the 147 windows; the three rarer categories shift hue
 * from it far enough to separate at a glance.
 */
const GLASS: Record<RoseCategory, [string, string]> = {
  superior: ['#6d97b2', '#4f7791'],
  alcove: ['#7a8d81', '#5d6f66'],
  deluxe: ['#ae8b45', '#8a6a2e'],
  accessible: ['#96718a', '#77516a'],
};

/** The hotel's own photograph of a guest-room window, served from its CDN. */
const TRACED_PHOTO = 'https://media2.tokyodisneyresort.jp/home/hotel/fsh/gallery/fcu/fcu_facilities_03.jpg';
const TRACED_PAGE: Record<Locale, string> = {
  'zh-hant': 'https://www.tokyodisneyresort.jp/tc/hotel/fsh/fcu/gallery.html',
  ja: 'https://www.tokyodisneyresort.jp/hotel/fsh/fcu/gallery.html',
  en: 'https://www.tokyodisneyresort.jp/en/hotel/fsh/fcu/gallery.html',
};

const WALL_LIGHT = '#f1ddd6';
const WALL_DARK = '#e3c6bd';
const TRIM = '#fdf8f0';
const TRIM_LINE = '#d8bdae';

/** The window surround, traced from the hotel's own exterior photography: a soft
 *  Art Nouveau frame, wider on the upper left, with a gently domed head. */
function windowShape(w: number, h: number): string {
  const rl = w * 0.24;
  const rr = w * 0.13;
  const rb = 1.5;
  return [
    `M0,${h - rb}`,
    `Q0,${h} ${rb},${h}`,
    `L${w - rb},${h}`,
    `Q${w},${h} ${w},${h - rb}`,
    `L${w},${rr}`,
    `C${w},${rr * 0.35} ${w - rr * 0.35},0 ${w - rr},0`,
    `Q${w / 2},${-h * 0.03} ${rl},0`,
    `C${rl * 0.35},0 0,${rl * 0.35} 0,${rl}`,
    'Z',
  ].join(' ');
}

/** The little fan-topped corbel that hangs above every window head. */
const CORBEL =
  'M-7,0 Q-7,-4 -3.6,-4.6 L3.6,-4.6 Q7,-4 7,0 C3.8,0.2 2.2,1.4 1.7,5 L-1.7,5 C-2.2,1.4 -3.8,0.2 -7,0 Z';

/** The volute at the centre of the roofline, drawn as a spiral rather than an arc. */
function spiral(cx: number, cy: number, turns: number, outer: number, inner: number): string {
  const steps = 44;
  let d = '';
  for (let i = 0; i <= steps; i++) {
    const t = i / steps;
    const angle = t * turns * Math.PI * 2;
    const r = outer + (inner - outer) * t;
    d += `${i ? 'L' : 'M'}${(cx + Math.cos(angle) * r).toFixed(1)},${(cy + Math.sin(angle) * r).toFixed(1)}`;
  }
  return d;
}

/** Deterministic pseudo-randomness, so the drawing is identical every build. */
function jitter(i: number, seed: number): number {
  const n = Math.sin((i + 1) * 12.9898 + seed * 78.233) * 43758.5453;
  return n - Math.floor(n);
}

/**
 * The courtyard rockwork, as overlapping boulders rather than one silhouette.
 * It is kept low enough that it never reaches a room number.
 */
function boulders(width: number, y: number, seed: number) {
  return Array.from({ length: Math.round(width / 38) + 1 }, (_, i) => {
    const r = jitter(i, seed);
    const rw = 18 + r * 30;
    const rh = 8 + r * 14;
    const cx = i * 38 + r * 26 - 12;
    const cy = y + 18 - rh * 0.15;
    return {
      d: `M${cx - rw},${cy + rh}
          Q${cx - rw},${cy - rh * 0.35} ${cx - rw * 0.5},${cy - rh * 0.8}
          Q${cx - rw * 0.05},${cy - rh * 1.2} ${cx + rw * 0.45},${cy - rh * 0.7}
          Q${cx + rw},${cy - rh * 0.2} ${cx + rw},${cy + rh} Z`,
      facet: `M${cx - rw * 0.75},${cy + rh * 0.2}
              Q${cx - rw * 0.6},${cy - rh * 0.6} ${cx - rw * 0.1},${cy - rh * 0.85}`,
      tone: ['#dccbb6', '#cdb9a2', '#e4d7c6'][i % 3]!,
    };
  });
}

interface Cell {
  number: string;
  category: RoseCategory;
  parkView: boolean;
  /** Index into `TYPE_NAMES`; the click handler resolves it. Room type names are
   *  long and there are 147 windows, so they are not repeated into the markup. */
  type?: number;
  x: number;
  y: number;
  hasAbove: boolean;
}

const TYPE_NAMES = [
  ...new Set(
    ROSE_ROOMS.map((room) => room.roomType).filter((id): id is string => !!id),
  ),
].map((id) => displayName.get(id)!);
const typeIndex = new Map(
  [...new Set(ROSE_ROOMS.map((room) => room.roomType).filter((id): id is string => !!id))].map(
    (id, i) => [id, i],
  ),
);

function layout(face: ElevationFace) {
  const floors = [...new Set(face.columns.flatMap((col) => col.floors))].sort((a, b) => b - a);
  const rowOf = (floor: number) => floors.indexOf(floor);
  const originX = GUTTER + EDGE;
  const centreX = (i: number) => originX + face.bays[i]! * BAY + BAY / 2;
  const centreY = (floor: number) => TOP + rowOf(floor) * STOREY + STOREY / 2;

  // Columns whose bays touch belong to the same block of wall; a wider gap is a
  // step in the building, and each block carries its own roofline.
  const blocks: { first: number; last: number }[] = [];
  face.columns.forEach((_, i) => {
    const previous = blocks[blocks.length - 1];
    if (previous && face.bays[i]! - face.bays[i - 1]! <= 1.2) previous.last = i;
    else blocks.push({ first: i, last: i });
  });

  const walls = blocks.map((block, bi) => {
    const cols = face.columns.slice(block.first, block.last + 1);
    const topFloor = Math.max(...cols.flatMap((col) => col.floors));
    return {
      x0: originX + face.bays[block.first]! * BAY - (bi === 0 ? EDGE : 0),
      x1:
        originX +
        face.bays[block.last]! * BAY +
        BAY +
        (bi === blocks.length - 1 ? EDGE : 0),
      roofY: TOP + rowOf(topFloor) * STOREY,
      crest:
        face.crest >= face.bays[block.first]! && face.crest <= face.bays[block.last]! + 1
          ? originX + face.crest * BAY
          : null,
    };
  });

  // Where the facade steps back, the wall does not stop — it turns and carries on
  // behind, so the gap is drawn as wall in shadow rather than as sky.
  const returns = walls.slice(0, -1).map((wall, i) => ({
    x0: wall.x1,
    x1: walls[i + 1]!.x0,
    roofY: Math.max(wall.roofY, walls[i + 1]!.roofY),
  }));

  // Each column of windows sits on a shallow pilaster strip, the way the bays do
  // on the building; without it the wall reads as one flat plane.
  const strips = face.columns.map((_, i) => {
    const block = blocks.findIndex((b) => i >= b.first && i <= b.last);
    return {
      x: centreX(i) - (BAY - 10) / 2,
      y: walls[block]!.roofY,
      width: BAY - 10,
      height: TOP + floors.length * STOREY - walls[block]!.roofY,
    };
  });

  const cells: Cell[] = [];
  face.columns.forEach((column, i) => {
    for (const floor of column.floors) {
      const room = ROSE_ROOMS.find(
        (r) => r.face === face.key && r.position === column.position && r.floor === floor,
      )!;
      cells.push({
        number: room.number,
        category: categoryAt(column, floor),
        parkView: room.parkView,
        ...(room.roomType ? { type: typeIndex.get(room.roomType) } : {}),
        x: centreX(i),
        y: centreY(floor),
        hasAbove: column.floors.includes(floor + 1),
      });
    }
  });

  const groundY = TOP + floors.length * STOREY;
  const width = Math.round(originX + (Math.max(...face.bays) + 1) * BAY + EDGE);
  return {
    ...face,
    cells,
    walls,
    returns,
    strips,
    groundY,
    width,
    height: groundY + BASE,
    rows: floors.map((floor) => ({ floor, y: centreY(floor) })),
    rocks: boulders(width, groundY, face.key.length),
    tufts: Array.from({ length: Math.round(width / 58) }, (_, i) => {
      const r = jitter(i, 5);
      return { x: 16 + i * 58 + r * 24, w: 10 + r * 5, h: 8 + r * 6, base: 24 + r * 4 };
    }),
  };
}

const faces = ELEVATIONS.map(layout);
---

<section
  id="rose-court"
  class="not-prose scroll-mt-32"
  data-elevation
  data-strings={JSON.stringify({
    roomLabel: c.roomLabel('{n}'),
    noView: c.noView,
    parkView: c.parkView,
    bookedAs: c.bookedAs('{name}'),
    unassigned: c.unassigned,
    separator: locale === 'en' ? ', ' : '・',
    categories: c.categories,
    types: TYPE_NAMES,
  })}
>
  <div>
    <h2 class="font-serif text-2xl font-bold text-ink">{c.heading(ROSE_ROOM_COUNT)}</h2>
    <p class="mt-2 max-w-3xl text-[0.9375rem] leading-[1.9] text-ink-soft">{c.intro}</p>
  </div>

  <ul class="mt-5 flex flex-wrap gap-x-4 gap-y-2 text-xs">
    {
      (Object.keys(ROSE_CATEGORY_LABEL) as RoseCategory[]).map((key) => (
        <li class="flex items-center gap-1.5">
          <span
            class="h-3.5 w-3.5 rounded-[2px] ring-1 ring-black/10"
            style={`background:${GLASS[key][1]}`}
          />
          <span class="text-ink-soft">{c.categories[key]}</span>
          <span class="text-ink-faint">
            {c.count(tally.filter((t) => t.category === key).reduce((n, t) => n + t.count, 0))}
          </span>
        </li>
      ))
    }
    <li class="flex items-center gap-1.5">
      <span
        class="h-3.5 w-3.5 rounded-[2px] bg-berry/20 ring-1.5 ring-berry ring-inset"
        aria-hidden="true"></span>
      <span class="text-ink-soft">{c.parkView}</span>
      <span class="text-ink-faint">
        {c.count(tally.filter((t) => t.parkView).reduce((n, t) => n + t.count, 0))}
      </span>
    </li>
  </ul>

  <svg class="absolute h-0 w-0 overflow-hidden" aria-hidden="true" focusable="false">
    <defs>
      {/* Everything a window is made of, centred on its own origin, so each of the
          147 cells is a transform and a handful of references rather than a fresh
          copy of the geometry. Fills and strokes are left to CSS so they inherit. */}
      <g id="fsh-frame">
        <path
          d={windowShape(WIN_W, WIN_H)}
          transform={`translate(${-WIN_W / 2},${-WIN_H / 2})`}></path>
      </g>
      <g id="fsh-glass">
        <path
          d={windowShape(WIN_W - FRAME * 2, WIN_H - FRAME * 2)}
          transform={`translate(${-WIN_W / 2 + FRAME},${-WIN_H / 2 + FRAME})`}></path>
      </g>
      <g id="fsh-sill">
        <rect
          x={-WIN_W / 2 - 4}
          y={WIN_H / 2}
          width={WIN_W + 8}
          height="3.5"
          rx="1.4"></rect>
      </g>
      <g id="fsh-sill-corbel">
        <use href="#fsh-sill"></use>
        <path d={CORBEL} transform={`translate(0,${-WIN_H / 2 - 7})`}></path>
      </g>
      <rect id="fsh-hit" x={-BAY / 2} y={-STOREY / 2} width={BAY} height={STOREY}></rect>
      <linearGradient id="fsh-wall" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color={WALL_LIGHT}></stop>
        <stop offset="1" stop-color={WALL_DARK}></stop>
      </linearGradient>
      <linearGradient id="fsh-sky" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#dce9f2"></stop>
        <stop offset="1" stop-color="#f4f1ea"></stop>
      </linearGradient>
      {
        (Object.keys(GLASS) as RoseCategory[]).map((key) => (
          <linearGradient id={`fsh-glass-${key}`} x1="0" y1="0" x2="0.35" y2="1">
            <stop offset="0" stop-color={GLASS[key][0]} />
            <stop offset="1" stop-color={GLASS[key][1]} />
          </linearGradient>
        ))
      }
    </defs>
  </svg>

  <div class="mt-7 space-y-8">
    {
      faces.map((face) => (
        <figure class="overflow-hidden rounded-2xl border border-line bg-card">
          <figcaption class="border-b border-line bg-paper-deep/50 px-4 py-3 sm:px-5">
            <h3 class="flex flex-wrap items-baseline gap-x-2.5 font-serif text-base font-bold text-ink">
              {c.faces[face.key]!.label}
              <span class="font-sans text-2xs font-medium tracking-wider text-ink-faint">
                {c.numberBand(face.numberBand)}
              </span>
            </h3>
            <p class="mt-1.5 text-[0.8125rem] leading-relaxed text-ink-soft">
              {c.faces[face.key]!.outlook}
              <a
                href={face.source}
                rel="nofollow noopener"
                target="_blank"
                class="ml-1.5 whitespace-nowrap text-brand underline decoration-brand/30 underline-offset-2 hover:decoration-brand"
              >
                {c.photo}
              </a>
            </p>
          </figcaption>

          <div class="table-scroll">
            <svg
              class="elevation block h-auto w-full"
              style={`min-width:${face.width}px`}
              viewBox={`0 0 ${face.width} ${face.height}`}
              role="img"
              aria-label={c.figureAlt(c.faces[face.key]!.label, face.cells.length)}
            >
              <rect width={face.width} height={face.height} fill="url(#fsh-sky)" />

              {face.returns.map((ret) => (
                <rect
                  x={ret.x0}
                  y={ret.roofY}
                  width={ret.x1 - ret.x0}
                  height={face.groundY - ret.roofY}
                  fill="#cdb2ac"
                />
              ))}

              {face.walls.map((wall) => (
                <g>
                  <rect
                    x={wall.x0}
                    y={wall.roofY}
                    width={wall.x1 - wall.x0}
                    height={face.groundY - wall.roofY}
                    fill="url(#fsh-wall)"
                  />
                  {face.strips
                    .filter((strip) => strip.x >= wall.x0 && strip.x < wall.x1)
                    .map((strip) => (
                      <rect
                        x={strip.x}
                        y={strip.y}
                        width={strip.width}
                        height={strip.height}
                        fill="#ffffff"
                        opacity="0.22"
                      />
                    ))}
                  <path
                    d={`M${wall.x0},${wall.roofY} L${wall.x0},${wall.roofY - 8}
                        Q${wall.x0 + 10},${wall.roofY - 15} ${wall.x0 + 26},${wall.roofY - 15}
                        L${wall.x1 - 26},${wall.roofY - 15}
                        Q${wall.x1 - 10},${wall.roofY - 15} ${wall.x1},${wall.roofY - 8}
                        L${wall.x1},${wall.roofY} Z`}
                    fill={TRIM}
                    stroke={TRIM_LINE}
                    stroke-width="1"
                  />
                  <rect
                    x={wall.x0}
                    y={wall.roofY - 2}
                    width={wall.x1 - wall.x0}
                    height="4"
                    fill={TRIM}
                    stroke={TRIM_LINE}
                    stroke-width="0.9"
                  />
                  {wall.crest !== null && (
                    <g transform={`translate(${wall.crest},${wall.roofY - 14})`}>
                      <path
                        d="M-52,0 C-52,-16 -50,-26 -40,-33 C-28,-42 -16,-45 0,-45
                           C16,-45 28,-42 40,-33 C50,-26 52,-16 52,0 Z"
                        fill={WALL_LIGHT}
                        stroke={TRIM}
                        stroke-width="3.6"
                        stroke-linejoin="round"
                      />
                      <path
                        d="M-40,-14 C-36,-28 -22,-33 -6,-29"
                        fill="none"
                        stroke={TRIM}
                        stroke-width="2.8"
                        stroke-linecap="round"
                      />
                      <path
                        d={spiral(14, -27, 1.7, 17, 2)}
                        fill="none"
                        stroke={TRIM}
                        stroke-width="2.8"
                        stroke-linecap="round"
                      />
                      <path d="M-5,-22 q-4.5,12 2.5,26 q7,-14 2.5,-26 z" fill={TRIM} />
                      <circle cx="-52" cy="-3" r="4" fill={TRIM} stroke={TRIM_LINE} stroke-width="0.8" />
                      <circle cx="52" cy="-3" r="4" fill={TRIM} stroke={TRIM_LINE} stroke-width="0.8" />
                    </g>
                  )}
                </g>
              ))}

              {face.cells
                .filter((cell) => cell.parkView)
                .map((cell) => (
                  <rect
                    x={cell.x - BAY / 2}
                    y={cell.y - STOREY / 2}
                    width={BAY}
                    height={STOREY}
                    fill="#8c2f4a"
                    opacity="0.22"
                  />
                ))}

              {face.cells.map((cell) => (
                <g
                  class:list={['cell', cell.parkView && 'is-park']}
                  data-cell
                  data-n={cell.number}
                  data-c={cell.category}
                  data-t={cell.type}
                  role="button"
                  tabindex="0"
                  aria-label={c.ariaCell(cell.number, c.categories[cell.category], cell.parkView)}
                  transform={`translate(${cell.x},${cell.y})`}
                >
                  <use class="orn" href={cell.hasAbove ? '#fsh-sill-corbel' : '#fsh-sill'} />
                  <use class="frame" href="#fsh-frame" />
                  <use class:list={['glass', `g-${cell.category}`]} href="#fsh-glass" />
                  <use class="hit" href="#fsh-hit" />
                  <text class="num" y="0.5">
                    {cell.number}
                  </text>
                </g>
              ))}

              <rect
                x="0"
                y={face.groundY + 12}
                width={face.width}
                height={BASE - 12}
                fill="#cdb9a2"
              />
              {face.rocks.map((rock) => (
                <g>
                  <path d={rock.d} fill={rock.tone} />
                  <path d={rock.facet} fill="none" stroke="#ffffff" stroke-width="1.4" opacity="0.3" />
                </g>
              ))}
              {face.tufts.map((tuft) => (
                <path
                  d={`M${tuft.x},${face.groundY + tuft.base}
                      q${-tuft.w * 0.5},${-tuft.h * 0.7} ${-tuft.w * 0.1},${-tuft.h}
                      q${tuft.w * 0.3},${tuft.h * 0.35} ${tuft.w * 0.55},${-tuft.h * 0.8}
                      q${tuft.w * 0.1},${tuft.h * 0.6} ${tuft.w * 0.55},${tuft.h * 0.15}
                      q${-tuft.w * 0.3},${tuft.h * 0.5} ${-tuft.w},${tuft.h * 0.65} z`}
                  fill="#87995f"
                  opacity="0.6"
                />
              ))}

              {face.rows.map((row) => (
                <text class="floor" x={GUTTER - 8} y={row.y}>
                  {c.floor(row.floor)}
                </text>
              ))}
            </svg>
          </div>
        </figure>
      ))
    }
  </div>

  <div
    class="mt-6 rounded-xl border border-brand/30 bg-brand-soft/40 px-5 py-4"
    data-detail
    aria-live="polite"
  >
    <p class="text-sm text-ink-soft" data-detail-empty>{c.empty}</p>
    <div class="hidden" data-detail-body>
      <p class="font-serif text-lg font-bold text-ink" data-detail-number></p>
      <p class="mt-1 text-sm text-ink-soft" data-detail-meta></p>
      <p class="mt-2 text-sm text-brand-deep" data-detail-type></p>
    </div>
  </div>

  <div class="mt-6 gap-5 sm:flex sm:items-start">
    <figure class="shrink-0 overflow-hidden rounded-xl border border-line bg-card sm:w-72">
      {/* Cropped to the window group in the photograph's top right corner, which is
          the detail the elevations trace; the rest of the frame is the rockwork. */}
      <div class="relative overflow-hidden" style="aspect-ratio:3/2">
        <img
          src={TRACED_PHOTO}
          width="800"
          height="450"
          loading="lazy"
          decoding="async"
          referrerpolicy="no-referrer"
          alt={c.tracedAlt}
          class="absolute top-0 left-[-233.333%] w-[333.333%] max-w-none"
        />
      </div>
      <figcaption
        class="flex flex-wrap items-baseline gap-x-2 gap-y-1 border-t border-line-soft px-3 py-2 text-2xs leading-relaxed text-ink-faint"
      >
        <span>{c.tracedCaption}</span>
        <a
          href={TRACED_PAGE[locale]}
          rel="noopener nofollow"
          target="_blank"
          class="text-brand underline decoration-brand/30 underline-offset-2 hover:text-gold"
        >
          {c.tracedLink}
        </a>
      </figcaption>
    </figure>
    <div class="mt-4 sm:mt-0">
      <p class="text-xs leading-relaxed text-ink-faint">{c.method}</p>
      <p class="mt-2 text-xs leading-relaxed text-ink-faint">{c.caveat(ROSE_ROOM_COUNT)}</p>
    </div>
  </div>
</section>

<style is:global>
  /* Global rather than scoped: everything here is already namespaced under
     `.elevation`, and scoping would stamp an attribute onto all 147 windows. */
  .elevation .orn {
    fill: #fdf8f0;
    stroke: #d8bdae;
    stroke-width: 0.8;
  }

  .elevation .hit {
    fill: transparent;
  }

  .elevation .g-superior {
    fill: url(#fsh-glass-superior);
  }

  .elevation .g-alcove {
    fill: url(#fsh-glass-alcove);
  }

  .elevation .g-deluxe {
    fill: url(#fsh-glass-deluxe);
  }

  .elevation .g-accessible {
    fill: url(#fsh-glass-accessible);
  }

  .elevation .num {
    font-size: 10px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    fill: #ffffff;
    text-anchor: middle;
    dominant-baseline: middle;
    pointer-events: none;
  }

  .elevation .floor {
    font-size: 10px;
    font-weight: 600;
    fill: #8b8f99;
    text-anchor: end;
    dominant-baseline: middle;
  }

  .elevation .frame {
    fill: #fdf8f0;
    stroke: #e7d2c4;
    stroke-width: 0.8;
  }

  .elevation .cell {
    cursor: pointer;
  }

  .elevation .is-park .frame {
    stroke: #8c2f4a;
    stroke-width: 1.6;
  }

  .elevation .cell:hover .frame,
  .elevation .cell:focus-visible .frame {
    stroke: #0f4c5c;
    stroke-width: 2;
  }

  .elevation .cell:focus-visible {
    outline: none;
  }

  .elevation .cell.is-active .frame {
    stroke: #0f4c5c;
    stroke-width: 2.4;
  }

  .elevation .cell.is-active .frame {
    fill: #ffffff;
  }
</style>

<script>
  function initElevation(root: HTMLElement) {
    const strings = JSON.parse(root.dataset.strings!) as {
      roomLabel: string;
      noView: string;
      parkView: string;
      bookedAs: string;
      unassigned: string;
      separator: string;
      categories: Record<string, string>;
      types: string[];
    };
    const empty = root.querySelector<HTMLElement>('[data-detail-empty]');
    const body = root.querySelector<HTMLElement>('[data-detail-body]');
    const number = root.querySelector<HTMLElement>('[data-detail-number]');
    const meta = root.querySelector<HTMLElement>('[data-detail-meta]');
    const type = root.querySelector<HTMLElement>('[data-detail-type]');
    if (!empty || !body || !number || !meta || !type) return;

    const cells = root.querySelectorAll<SVGGElement>('[data-cell]');

    const select = (cell: SVGGElement) => {
      cells.forEach((other) => other.classList.toggle('is-active', other === cell));
      const parkView = cell.classList.contains('is-park');
      const typeName = cell.dataset.t ? strings.types[Number(cell.dataset.t)] : undefined;
      number.textContent = strings.roomLabel.replace('{n}', cell.dataset.n!);
      meta.textContent = [
        strings.categories[cell.dataset.c!],
        parkView ? strings.parkView : strings.noView,
      ].join(strings.separator);
      type.textContent = typeName
        ? strings.bookedAs.replace('{name}', typeName)
        : strings.unassigned;
      empty.classList.add('hidden');
      body.classList.remove('hidden');
    };

    cells.forEach((cell) => {
      cell.addEventListener('click', () => select(cell));
      cell.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        event.preventDefault();
        select(cell);
      });
    });
  }

  document.querySelectorAll<HTMLElement>('[data-elevation]').forEach((root) => initElevation(root));
</script>
