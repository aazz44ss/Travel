---
import type { Dining } from '~/data/hotel-schema';

interface Props {
  dining: Dining[];
}

const { dining } = Astro.props;
---

<div class="not-prose my-8 space-y-4">
  {
    dining.map((venue) => (
      <article class="rounded-xl border border-line bg-card p-5 sm:p-6">
        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <h4 class="font-serif text-base font-bold text-ink">{venue.name}</h4>
          <span class="text-2xs tracking-wide text-ink-faint uppercase">{venue.nameEn}</span>
          <span class="ml-auto rounded-full bg-brand-soft px-2.5 py-1 text-2xs font-medium text-brand-deep">
            {venue.type}
          </span>
        </div>

        <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1.5">
          {venue.hours.map((slot) => (
            <li class="flex items-center gap-1.5 text-[0.8125rem] text-ink-soft tabular-nums">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <circle cx="6" cy="6" r="5" stroke="currentColor" stroke-width="1.2" />
                <path d="M6 3.2V6l1.9 1.4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
              </svg>
              {slot}
            </li>
          ))}
        </ul>

        <p class="mt-3 text-[0.875rem] leading-[1.85] text-ink-soft">{venue.description}</p>

        <div class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-xs text-ink-faint">
          {venue.seats && <span>座位：{venue.seats}</span>}
          {venue.reservation && <span>訂位：{venue.reservation}</span>}
        </div>
      </article>
    ))
  }
</div>
