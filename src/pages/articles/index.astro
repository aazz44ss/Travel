---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import ArticleCard from '~/components/ArticleCard.astro';
import { SITE, withBase } from '~/consts';

const articles = (await getCollection('articles')).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);

const tags = [...new Set(articles.flatMap((article) => article.data.tags))].sort();

const description = `${SITE.name}目前收錄 ${articles.length} 篇深度旅遊指南，每一篇都標明資料來源與查證日期。`;
---

<BaseLayout title="所有文章" description={description}>
  <section class="border-b border-line bg-paper-deep/40">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
      <nav class="flex items-center gap-2 text-xs text-ink-faint" aria-label="麵包屑">
        <a href={withBase('/')} class="transition-colors hover:text-brand">首頁</a>
        <span aria-hidden="true">/</span>
        <span>所有文章</span>
      </nav>
      <h1 class="mt-6 font-serif text-3xl font-bold text-ink sm:text-4xl">所有文章</h1>
      <p class="mt-4 max-w-2xl text-[0.9375rem] leading-[1.95] text-ink-soft">
        {description}內容以住宿、交通與行程規劃為主，寫的都是那種「查了三小時還是不確定要選哪個」的題目。
      </p>
      {
        tags.length > 0 && (
          <ul class="mt-7 flex flex-wrap gap-2">
            {tags.map((tag) => (
              <li class="rounded-full border border-line bg-card px-3 py-1.5 text-xs text-ink-soft">
                #{tag}
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-16">
    {
      articles.length > 0 ? (
        <div class="grid gap-6 md:grid-cols-2">
          {articles.map((article) => (
            <ArticleCard article={article} />
          ))}
        </div>
      ) : (
        <p class="rounded-xl border border-dashed border-line px-6 py-16 text-center text-sm text-ink-soft">
          還沒有文章。
        </p>
      )
    }
  </section>
</BaseLayout>
