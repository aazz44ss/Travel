---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import ArticleCard from '~/components/ArticleCard.astro';
import { SITE, withBase } from '~/consts';
import { CATEGORIES, HOTEL, ROOMS } from '~/data/tokyo-disneyland-hotel';
import { roomsByCategory } from '~/data/hotel-schema';

const articles = (await getCollection('articles')).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);

const featured = articles.find((article) => article.data.featured) ?? articles[0];
const rest = articles.filter((article) => article.id !== featured?.id);

const principles = [
  {
    title: '官方資料是地基，不是全部',
    body: '規格、時間、價格一律回到官方頁面確認。但官方不會告訴你 3 樓和 8 樓的窗外差多少，那部分要靠住過的人。',
  },
  {
    title: '社群當作田野調查',
    body: 'TikTok 和 Instagram 上的開箱影片有大量細節，但也有大量倖存者偏差。我們把它們當線索，再回頭驗證。',
  },
  {
    title: '標明查證日期',
    body: '旅遊資訊會過期。每一篇都會寫清楚資料的時間點，並且在制度變動時回頭更新，而不是留一篇 2022 年的文章騙流量。',
  },
  {
    title: '把資料做成工具',
    body: '能整理成可篩選、可比較的資料，就不寫成一長串文字。你要的是做決定，不是讀完。',
  },
];

const upcoming = [
  { place: '東京迪士尼海洋觀海景大飯店', note: '威尼斯側與托斯卡尼側的房型與視野比較' },
  { place: '東京迪士尼度假區交通', note: '從成田、羽田到舞濱的四種走法與實際花費' },
  { place: '東京迪士尼樂園單日行程', note: '不買尊享卡的情況下，怎麼排才不會走冤枉路' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  alternateName: SITE.nameEn,
  description: SITE.description,
  inLanguage: 'zh-Hant-TW',
  url: Astro.site?.href,
};
---

<BaseLayout title={SITE.name} description={SITE.description} schema={schema}>
  <section class="relative overflow-hidden border-b border-line">
    <div
      class="pointer-events-none absolute inset-0 opacity-70"
      style="background-image: radial-gradient(ellipse 60% 50% at 12% 0%, rgba(15,76,92,.13), transparent 60%), radial-gradient(ellipse 50% 45% at 92% 20%, rgba(180,131,44,.14), transparent 60%)"
      aria-hidden="true"
    >
    </div>

    <div class="relative mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
      <p class="text-2xs font-bold tracking-[0.28em] text-gold uppercase">
        {SITE.nameEn}
      </p>
      <h1
        class="mt-5 max-w-3xl font-serif text-[2.1rem] leading-[1.32] font-bold text-ink sm:text-5xl sm:leading-[1.28]"
      >
        把功課做完，<br class="hidden sm:block" />剩下的交給旅行
      </h1>
      <p class="mt-7 max-w-2xl text-base leading-[1.95] text-ink-soft sm:text-lg">
        大部分旅遊文章告訴你「這裡很棒」。這裡想做的是另一件事：把官方資料、當地部落格與社群上的第一手分享全部攤開來交叉比對，整理成你在訂房頁面前面、真的按得下去的判斷依據。
      </p>

      <div class="mt-10 flex flex-wrap gap-3">
        {
          featured && (
            <a
              href={withBase(`/articles/${featured.id}`)}
              class="inline-flex items-center gap-2 rounded-full bg-brand px-6 py-3.5 text-sm font-medium text-white transition-colors hover:bg-brand-deep"
            >
              閱讀最新一篇
              <span aria-hidden="true">→</span>
            </a>
          )
        }
        <a
          href={withBase('/hotels/tokyo-disneyland-hotel')}
          class="inline-flex items-center gap-2 rounded-full border border-line bg-card px-6 py-3.5 text-sm font-medium text-ink transition-colors hover:bg-paper-deep"
        >
          打開房型資料庫
        </a>
      </div>

      <dl class="mt-14 flex flex-wrap gap-x-12 gap-y-6 border-t border-line pt-8">
        <div>
          <dt class="text-2xs tracking-[0.16em] text-ink-faint uppercase">已收錄房型</dt>
          <dd class="mt-1 font-serif text-2xl font-bold text-brand-deep">{ROOMS.length} 種</dd>
        </div>
        <div>
          <dt class="text-2xs tracking-[0.16em] text-ink-faint uppercase">目前文章</dt>
          <dd class="mt-1 font-serif text-2xl font-bold text-brand-deep">{articles.length} 篇</dd>
        </div>
        <div>
          <dt class="text-2xs tracking-[0.16em] text-ink-faint uppercase">交叉查證來源</dt>
          <dd class="mt-1 font-serif text-2xl font-bold text-brand-deep">
            {articles.reduce((sum, article) => sum + article.data.sources.length, 0)} 筆
          </dd>
        </div>
      </dl>
    </div>
  </section>

  {
    featured && (
      <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
        <div class="flex items-baseline justify-between gap-4">
          <h2 class="font-serif text-xl font-bold text-ink sm:text-2xl">最新一篇</h2>
          <a
            href={withBase('/articles')}
            class="text-sm text-ink-soft transition-colors hover:text-brand"
          >
            所有文章 →
          </a>
        </div>
        <div class="mt-6">
          <ArticleCard article={featured} featured />
        </div>

        {rest.length > 0 && (
          <div class="mt-6 grid gap-5 md:grid-cols-2">
            {rest.map((article) => (
              <ArticleCard article={article} />
            ))}
          </div>
        )}
      </section>
    )
  }

  <section class="border-y border-line bg-paper-deep/40">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
      <div class="grid gap-10 lg:grid-cols-[1fr_1.4fr] lg:gap-16">
        <div>
          <h2 class="font-serif text-xl font-bold text-ink sm:text-2xl">這裡怎麼寫東西</h2>
          <p class="mt-4 text-[0.9375rem] leading-[1.95] text-ink-soft">
            旅遊內容最大的問題不是寫得不好，是過期。制度改了、價格調了、房型重新分類了，文章還停在三年前。這裡的做法是把可以結構化的資料抽出來單獨維護，讓更新這件事變得可行。
          </p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          {
            principles.map((principle, index) => (
              <div class="rounded-xl border border-line bg-card p-5">
                <span class="font-serif text-sm font-bold text-gold">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <h3 class="mt-2 font-serif text-[0.9375rem] font-bold text-ink">
                  {principle.title}
                </h3>
                <p class="mt-2 text-[0.8125rem] leading-[1.85] text-ink-soft">{principle.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
    <div
      class="overflow-hidden rounded-2xl border border-line bg-gradient-to-br from-brand-deep to-brand text-white"
    >
      <div class="grid gap-8 p-8 sm:p-12 lg:grid-cols-[1.3fr_1fr] lg:items-center">
        <div>
          <p class="text-2xs font-bold tracking-[0.22em] uppercase opacity-80">工具</p>
          <h2 class="mt-3 font-serif text-2xl leading-snug font-bold sm:text-3xl">
            {HOTEL.name}房型資料庫
          </h2>
          <p class="mt-4 max-w-lg text-[0.9375rem] leading-[1.9] opacity-90">
            {ROOMS.length}
            種房型的面積、床型配置、人數上限、景觀分級與參考價，全部整理成可以篩選的清單。訂房前打開它，用你的條件把不適合的濾掉。
          </p>
          <a
            href={withBase('/hotels/tokyo-disneyland-hotel')}
            class="mt-7 inline-flex items-center gap-2 rounded-full bg-white px-6 py-3.5 text-sm font-medium text-brand-deep transition-transform duration-300 hover:-translate-y-0.5"
          >
            打開資料庫 <span aria-hidden="true">→</span>
          </a>
        </div>
        <ul class="grid grid-cols-2 gap-px overflow-hidden rounded-xl bg-white/20">
          {
            CATEGORIES.map((category) => (
              <li class="bg-brand-deep/60 px-5 py-6 backdrop-blur-sm">
                <p class="text-2xs tracking-[0.14em] uppercase opacity-70">{category.label}</p>
                <p class="mt-1.5 font-serif text-xl font-bold">
                  {roomsByCategory(ROOMS, category.key).length} 種
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-20 sm:px-8">
    <h2 class="font-serif text-xl font-bold text-ink sm:text-2xl">接下來在查什麼</h2>
    <p class="mt-3 text-sm text-ink-soft">下面這幾篇正在整理資料。順序會依查證的進度調整。</p>
    <ol class="mt-6 divide-y divide-line overflow-hidden rounded-xl border border-line bg-card">
      {
        upcoming.map((item, index) => (
          <li class="flex flex-wrap items-baseline gap-x-4 gap-y-1 px-5 py-4">
            <span class="font-serif text-sm font-bold text-ink-faint tabular-nums">
              {String(index + 1).padStart(2, '0')}
            </span>
            <span class="font-serif text-[0.9375rem] font-bold text-ink">{item.place}</span>
            <span class="text-[0.8125rem] text-ink-soft">{item.note}</span>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>
