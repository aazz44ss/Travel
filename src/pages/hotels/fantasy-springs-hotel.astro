---
import { getEntry } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import HotelFacts from '~/components/HotelFacts.astro';
import ElevationMap from '~/components/ElevationMap.astro';
import RateTable from '~/components/RateTable.astro';
import RoomExplorer from '~/components/RoomExplorer.astro';
import BedTable from '~/components/BedTable.astro';
import FacilityGrid from '~/components/FacilityGrid.astro';
import DiningList from '~/components/DiningList.astro';
import BenefitList from '~/components/BenefitList.astro';
import FaqList from '~/components/FaqList.astro';
import { withBase } from '~/consts';
import { roomsByCategory } from '~/data/hotel-schema';
import {
  BED_SPECS,
  BENEFITS,
  CATEGORIES,
  DINING,
  FACILITIES,
  FACTS,
  FAQS,
  HOTEL,
  ROOMS,
  VIEWS,
} from '~/data/fantasy-springs-hotel';
import { ROSE_ROOM_COUNT, roseNumbersFor } from '~/data/fsh-rose-court';
import {
  LAYOUT_IMAGE_SIZE,
  ROOM_LAYOUTS,
  layoutImageUrl,
  layoutIsShared,
  layoutPageUrl,
} from '~/data/fsh-room-layouts';

const article = await getEntry('articles', 'fantasy-springs-hotel');

const title = `${HOTEL.name} 房型資料庫`;
const description = `${HOTEL.name}全 ${ROOMS.length} 種房型的面積、床型、人數上限、景觀分級與同一天的完整價目，整理成可篩選的清單。另有玫瑰庭區 ${ROSE_ROOM_COUNT} 間客房的位置圖，房號對應的樓層、分類與景觀一目瞭然。`;

const sections = [
  { id: 'overview', label: '基本資料' },
  { id: 'sides', label: '四區與豪華館' },
  { id: 'views', label: '景觀分級' },
  { id: 'rose-court', label: '玫瑰庭區位置圖' },
  { id: 'room-explorer', label: '房型探索器' },
  { id: 'rates', label: '完整價目' },
  { id: 'beds', label: '床型尺寸' },
  { id: 'facilities', label: '館內設施' },
  { id: 'dining', label: '餐廳' },
  { id: 'benefits', label: '住宿禮遇' },
  { id: 'faq', label: '常見問題' },
];

const viewStyle: Record<string, string> = {
  grand: 'bg-brand text-white',
  park: 'bg-brand-soft text-brand-deep',
  partial: 'bg-gold-soft text-gold',
  none: 'bg-paper-deep text-ink-faint',
  allpark: 'bg-berry-soft text-berry',
};

const categoryStyle: Record<string, string> = {
  springs: 'border-brand/30 text-brand',
  rose: 'border-gold/40 text-gold',
  bay: 'border-line text-ink-soft',
  entrance: 'border-line text-ink-soft',
  grand: 'border-berry/30 text-berry',
};

const explorerIntro = `${ROOMS.length} 種房型，用你在意的條件篩掉不適合的。價格是同一個住宿日的參考價，這樣才比得出房型之間的相對關係。`;
const explorerFootnote = `名稱依官方繁體中文客房頁，玫瑰庭區採用 2026 年 10 月起適用的分類。房號只有玫瑰庭區有——那一側的 ${ROSE_ROOM_COUNT} 間客房位置已被逐間整理出來，其他三區與豪華館沒有這樣的資料。`;

function fshLayout(id: string) {
  const ref = ROOM_LAYOUTS[id];
  if (!ref) return undefined;
  return {
    src: layoutImageUrl(ref),
    href: layoutPageUrl(ref),
    width: LAYOUT_IMAGE_SIZE.width,
    height: LAYOUT_IMAGE_SIZE.height,
    shared: layoutIsShared(id),
  };
}

function fshNumbers(id: string) {
  const numbers = roseNumbersFor(id);
  if (numbers.length === 0) return undefined;
  return {
    numbers,
    complete: true,
    note: '房號的第一位是樓層，後三位是位置。來源是逐間調查，含作者推測。',
  };
}

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Hotel',
    name: HOTEL.name,
    alternateName: [HOTEL.nameEn, HOTEL.nameJa],
    description,
    url: HOTEL.officialUrl,
    numberOfRooms: HOTEL.totalRooms,
    checkinTime: HOTEL.checkIn,
    checkoutTime: HOTEL.checkOut,
    address: {
      '@type': 'PostalAddress',
      addressCountry: 'JP',
      addressRegion: '千葉縣',
      addressLocality: '浦安市',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: FAQS.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  },
];
---

<BaseLayout title={title} description={description} schema={schema}>
  <header class="border-b border-line bg-gradient-to-br from-berry to-brand-deep text-white">
    <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-20">
      <nav class="flex items-center gap-2 text-xs opacity-80" aria-label="麵包屑">
        <a href={withBase('/')} class="transition-opacity hover:opacity-100">首頁</a>
        <span aria-hidden="true">/</span>
        <a href={withBase('/hotels')} class="transition-opacity hover:opacity-100">飯店資料庫</a>
        <span aria-hidden="true">/</span>
        <span>夢幻泉鄉大飯店</span>
      </nav>
      <p class="mt-8 text-2xs font-bold tracking-[0.22em] uppercase opacity-85">
        日本・千葉縣浦安市
      </p>
      <h1 class="mt-3 font-serif text-3xl leading-tight font-bold sm:text-[2.6rem]">
        {HOTEL.name}<span class="block text-xl font-medium opacity-80 sm:text-2xl">房型資料庫</span>
      </h1>
      <p class="mt-5 max-w-2xl text-[0.9375rem] leading-[1.9] opacity-90">
        兩館 {ROOMS.length} 種房型的規格與參考價，加上玫瑰庭區 {ROSE_ROOM_COUNT} 間客房的位置圖。
        訂房頁面開著的時候，把這一頁放在旁邊對照。
      </p>
      {
        article && (
          <a
            href={withBase(`/articles/${article.id}`)}
            class="mt-8 inline-flex items-center gap-2 rounded-full bg-white px-5 py-3 text-sm font-medium text-brand-deep transition-transform duration-300 hover:-translate-y-0.5"
          >
            先讀完整攻略 <span aria-hidden="true">→</span>
          </a>
        )
      }
    </div>
  </header>

  <nav
    class="sticky top-16 z-40 border-b border-line bg-paper/90 backdrop-blur-md"
    aria-label="頁面章節"
  >
    <div class="table-scroll mx-auto max-w-6xl px-5 sm:px-8">
      <ul class="flex gap-1 py-2.5 whitespace-nowrap">
        {
          sections.map((section) => (
            <li>
              <a
                href={`#${section.id}`}
                class="block rounded-full px-3.5 py-1.5 text-sm text-ink-soft transition-colors hover:bg-paper-deep hover:text-ink"
              >
                {section.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>

  <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-16">
    <section id="overview" class="scroll-mt-32">
      <h2 class="font-serif text-2xl font-bold text-ink">基本資料</h2>
      <HotelFacts facts={FACTS} />
      <p class="text-sm leading-relaxed text-ink-faint">
        房型、面積、床型與樓層區間取自官方繁體中文客房頁；價格是每室每晚、2
        位大人的參考價，來自開賣日價格調查的二手整理。實際金額依日期大幅浮動，請以官方訂房系統為準。
      </p>
    </section>

    <section id="sides" class="mt-20 scroll-mt-32">
      <h2 class="font-serif text-2xl font-bold text-ink">四區與豪華館</h2>
      <p class="mt-3 max-w-3xl text-[0.9375rem] leading-[1.9] text-ink-soft">
        房名的第一段就是位置。夢幻館的 {HOTEL.fantasyChateauRooms} 間客房分成四區，區域決定窗外朝哪一邊、
        有沒有景觀分級，也決定價格；豪華館是另一個館別，不用這套分區。
      </p>
      <figure class="mt-6 overflow-hidden rounded-xl border border-line bg-white">
        <img
          src={HOTEL.sideMapUrl}
          width={HOTEL.sideMapSize.width}
          height={HOTEL.sideMapSize.height}
          loading="lazy"
          decoding="async"
          referrerpolicy="no-referrer"
          alt="官方的客房位置圖，標出夢幻館的灣岸區、飯店入口區、玫瑰庭區、泉鄉區與豪華館"
          class="block h-auto w-full"
        />
        <figcaption class="border-t border-line px-4 py-2.5 text-2xs text-ink-faint">
          官方客房頁的位置圖。
          <a
            href={HOTEL.roomsUrl}
            rel="noopener nofollow"
            target="_blank"
            class="text-brand underline decoration-brand/30 underline-offset-2 hover:text-gold"
            >客房簡介（官方繁體中文）</a
          >
        </figcaption>
      </figure>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {
          CATEGORIES.map((category) => (
            <article class="rounded-xl border border-line bg-card p-5">
              <div class="flex items-baseline justify-between gap-3">
                <h3 class="font-serif text-base font-bold text-ink">{category.label}</h3>
                <span class="rounded-full bg-paper-deep px-2.5 py-1 text-2xs text-ink-soft">
                  {roomsByCategory(ROOMS, category.key).length} 種
                </span>
              </div>
              <p class="mt-2.5 text-[0.875rem] leading-[1.85] text-ink-soft">{category.summary}</p>
              <ul class="mt-3 flex flex-wrap gap-1.5">
                {category.perks.map((perk) => (
                  <li class="rounded-full border border-line px-2.5 py-1 text-2xs text-ink-soft">
                    {perk}
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <section id="views" class="mt-20 scroll-mt-32">
      <h2 class="font-serif text-2xl font-bold text-ink">景觀分級</h2>
      <p class="mt-3 max-w-3xl text-[0.9375rem] leading-[1.9] text-ink-soft">
        房名括號裡寫的就是景觀等級，沒有括號代表沒有景觀保證。四個等級不會同時出現在同一區——
        樂園全景觀與景隅景觀只在泉鄉區，樂園景觀只在玫瑰庭區。
      </p>
      <div class="mt-6 grid gap-4 lg:grid-cols-3">
        {
          VIEWS.map((view, index) => (
            <article
              class:list={[
                'rounded-xl border p-5',
                index === 0 ? 'border-brand/30 bg-brand-soft/50' : 'border-line bg-card',
              ]}
            >
              <div class="flex items-baseline justify-between gap-2">
                <h3 class="font-serif text-base font-bold text-ink">{view.label}</h3>
                <span class="text-2xs whitespace-nowrap text-ink-faint">
                  {ROOMS.filter((room) => room.view === view.key).length} 種房型
                </span>
              </div>
              <p class="mt-1 text-xs text-ink-faint">
                {view.labelJa}／{view.labelEn}
              </p>
              <p class="mt-3 text-sm font-medium text-brand-deep">{view.summary}</p>
              <p class="mt-2.5 text-[0.875rem] leading-[1.85] text-ink-soft">{view.detail}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="mt-20">
      <ElevationMap />
    </section>

    <section class="mt-20">
      <RoomExplorer
        rooms={ROOMS}
        categories={CATEGORIES}
        views={VIEWS}
        viewStyle={viewStyle}
        categoryStyle={categoryStyle}
        intro={explorerIntro}
        footnote={explorerFootnote}
        layout={fshLayout}
        numbers={fshNumbers}
      />
    </section>

    <section class="mt-20">
      <RateTable />
    </section>

    <section id="beds" class="mt-20 scroll-mt-32">
      <h2 class="font-serif text-2xl font-bold text-ink">床型尺寸</h2>
      <p class="mt-3 max-w-3xl text-[0.9375rem] leading-[1.9] text-ink-soft">
        這間飯店的加床有四種，而且尺寸差很多。房型名稱只寫「附凹室」「附陽台」，實際睡幾個人、睡得舒不舒服看這張表。
      </p>
      <BedTable specs={BED_SPECS} caption={`${HOTEL.name}床型尺寸與可睡人數`} />
    </section>

    <section id="facilities" class="mt-20 scroll-mt-32">
      <h2 class="font-serif text-2xl font-bold text-ink">館內設施</h2>
      <FacilityGrid facilities={FACILITIES} />
    </section>

    <section id="dining" class="mt-20 scroll-mt-32">
      <h2 class="font-serif text-2xl font-bold text-ink">餐廳</h2>
      <DiningList dining={DINING} />
    </section>

    <section id="benefits" class="mt-20 scroll-mt-32">
      <h2 class="font-serif text-2xl font-bold text-ink">住宿禮遇</h2>
      <BenefitList benefits={BENEFITS} />
    </section>

    <section id="faq" class="mt-20 scroll-mt-32">
      <h2 class="font-serif text-2xl font-bold text-ink">常見問題</h2>
      <FaqList faqs={FAQS} />
    </section>

    {
      article && (
        <section class="mt-20 rounded-2xl border border-line bg-paper-deep/50 p-7 sm:p-10">
          <h2 class="font-serif text-xl font-bold text-ink">想知道這些數字背後的判斷？</h2>
          <p class="mt-3 max-w-2xl text-[0.9375rem] leading-[1.9] text-ink-soft">
            完整攻略裡有訂房難度的實測數字、「樂園景觀」為什麼不是這裡最好的景、玫瑰庭區的樓層問題怎麼變成價格問題，
            以及豪華館那 56 間房到底買到了什麼。
          </p>
          <a
            href={withBase(`/articles/${article.id}`)}
            class="mt-6 inline-flex items-center gap-2 rounded-full bg-brand px-6 py-3.5 text-sm font-medium text-white transition-colors hover:bg-brand-deep"
          >
            閱讀完整攻略 <span aria-hidden="true">→</span>
          </a>
        </section>
      )
    }
  </div>
</BaseLayout>
