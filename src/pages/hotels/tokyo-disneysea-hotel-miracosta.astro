---
import { getEntry } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import HotelFacts from '~/components/HotelFacts.astro';
import PriceSeasons from '~/components/PriceSeasons.astro';
import RoomExplorer from '~/components/RoomExplorer.astro';
import MiraCostaRoomIndex from '~/components/MiraCostaRoomIndex.astro';
import BedTable from '~/components/BedTable.astro';
import FacilityGrid from '~/components/FacilityGrid.astro';
import DiningList from '~/components/DiningList.astro';
import BenefitList from '~/components/BenefitList.astro';
import FaqList from '~/components/FaqList.astro';
import { withBase } from '~/consts';
import {
  BED_SPECS,
  BENEFITS,
  CATEGORIES,
  DINING,
  FACILITIES,
  FAQS,
  FLAGS,
  HOTEL,
  HOTEL_FACTS,
  ROOMS,
  VIEWS,
  roomsByCategory,
} from '~/data/tokyo-disneysea-hotel-miracosta';
import { MONTHLY_RATES, RATE_YEAR_2026_MONTHS } from '~/data/dhm-rates';
import { CONNECTING_PAIRS, NUMBER_BLOCKS, ROOM_NUMBERS } from '~/data/dhm-room-numbers';
import { LAYOUTS } from '~/data/dhm-room-layouts';

const viewStyle = {
  'harbour-grand': 'bg-brand-deep text-white',
  harbour: 'bg-brand text-white',
  'piazza-grand': 'bg-brand-soft text-brand-deep',
  piazza: 'bg-gold-soft text-[#6f4e18]',
  canal: 'bg-berry-soft text-berry',
  aqua: 'bg-[#e4f2f7] text-[#285f72]',
  partial: 'bg-paper-deep text-ink-soft',
  none: 'bg-paper-deep text-ink-faint',
};

const categoryStyle = {
  tuscany: 'border-line text-ink-soft',
  venice: 'border-berry/30 text-berry',
  porto: 'border-brand/30 text-brand',
  speciale: 'border-gold/40 text-gold',
};

const article = await getEntry('articles', 'tokyo-disneysea-hotel-miracosta');

const title = `${HOTEL.name}房型資料庫`;
const description = `${HOTEL.name}全 ${ROOMS.length} 種可訂組合的面積、床型、人數、景觀與 2026 參考價；另整理海港區逐間房號索引、官方格局圖、設施、餐廳與住宿禮遇。`;

const sections = [
  { id: 'overview', label: '基本資料' },
  { id: 'sides', label: '三區怎麼分' },
  { id: 'views', label: '八種景觀' },
  { id: 'room-index', label: '海港區房號' },
  { id: 'room-explorer', label: '房型探索器' },
  { id: 'price-seasons', label: '逐月價格' },
  { id: 'beds', label: '床型尺寸' },
  { id: 'facilities', label: '設施' },
  { id: 'dining', label: '餐廳' },
  { id: 'benefits', label: '住宿禮遇' },
  { id: 'faq', label: '常見問題' },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Hotel',
    name: HOTEL.name,
    alternateName: [HOTEL.nameEn, HOTEL.nameJa],
    description,
    url: HOTEL.officialUrl,
    numberOfRooms: HOTEL.totalRooms,
    checkinTime: HOTEL.checkIn,
    checkoutTime: HOTEL.checkOut,
    address: {
      '@type': 'PostalAddress',
      addressCountry: 'JP',
      addressRegion: HOTEL.region,
      addressLocality: HOTEL.locality,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: FAQS.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  },
];
---

<BaseLayout title={title} description={description} schema={schema}>
  <header class="border-b border-line bg-gradient-to-br from-[#3b1822] via-berry to-[#9a6840] text-white">
    <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-20">
      <nav class="flex items-center gap-2 text-xs opacity-80" aria-label="麵包屑">
        <a href={withBase('/')} class="transition-opacity hover:opacity-100">首頁</a>
        <span aria-hidden="true">/</span>
        <span>房型資料庫</span>
      </nav>
      <p class="mt-8 text-2xs font-bold tracking-[0.22em] uppercase opacity-85">
        日本・千葉縣浦安市
      </p>
      <h1 class="mt-3 max-w-4xl font-serif text-3xl leading-tight font-bold sm:text-[2.6rem]">
        {HOTEL.name}<span class="block text-xl font-medium opacity-80 sm:text-2xl">房型資料庫</span>
      </h1>
      <p class="mt-5 max-w-2xl text-[0.9375rem] leading-[1.9] opacity-90">
        {`${ROOMS.length} 種可訂組合`}、八種景觀、官方客房格局與海港區逐間房號，放在同一頁對照。這間飯店最貴的不是房間大小，是窗外那一格。
      </p>
      {
        article && (
          <a
            href={withBase(`/articles/${article.id}`)}
            class="mt-8 inline-flex items-center gap-2 rounded-full bg-white px-5 py-3 text-sm font-medium text-[#5f1f31] transition-transform duration-300 hover:-translate-y-0.5"
          >
            先讀完整攻略 <span aria-hidden="true">→</span>
          </a>
        )
      }
    </div>
  </header>

  <nav
    class="sticky top-16 z-40 border-b border-line bg-paper/90 backdrop-blur-md"
    aria-label="頁面章節"
  >
    <div class="table-scroll mx-auto max-w-6xl px-5 sm:px-8">
      <ul class="flex gap-1 py-2.5 whitespace-nowrap">
        {
          sections.map((section) => (
            <li>
              <a
                href={`#${section.id}`}
                class="block rounded-full px-3.5 py-1.5 text-sm text-ink-soft transition-colors hover:bg-paper-deep hover:text-ink"
              >
                {section.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>

  <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-16">
    <section id="overview" class="scroll-mt-32">
      <h2 class="font-serif text-2xl font-bold text-ink">基本資料</h2>
      <HotelFacts facts={HOTEL_FACTS} />
      <p class="text-sm leading-relaxed text-ink-faint">
        房型名稱、面積、定員、床型與格局圖取自官方繁體中文及日文客房頁。價格是每室每晚、2
        位大人的公開費率二手整理，不是報價；房號只涵蓋有逐間調查的海港區，實際房價與房間分配以官方為準。
      </p>
    </section>

    <section id="sides" class="mt-20 scroll-mt-32">
      <h2 class="font-serif text-2xl font-bold text-ink">三個區，加上一個服務等級</h2>
      <p class="mt-3 max-w-3xl text-[0.9375rem] leading-[1.9] text-ink-soft">
        托斯卡納、威尼斯、海港描述的是建築朝向；「尊榮客房＆套房」則是跨威尼斯與海港的服務等級。先決定要看哪一側，再決定要不要為貴賓室與早餐加價。
      </p>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {
          CATEGORIES.map((category) => (
            <article class="rounded-xl border border-line bg-card p-5">
              <div class="flex items-baseline justify-between gap-3">
                <h3 class="font-serif text-base font-bold text-ink">{category.label}</h3>
                <span class="rounded-full bg-paper-deep px-2.5 py-1 text-2xs text-ink-soft">
                  {roomsByCategory(category.key).length} 種
                </span>
              </div>
              <p class="mt-1 text-xs text-ink-faint">{category.labelEn}</p>
              <p class="mt-3 text-[0.875rem] leading-[1.85] text-ink-soft">{category.summary}</p>
              <ul class="mt-3 flex flex-wrap gap-1.5">
                {category.perks.map((perk) => (
                  <li class="rounded-full border border-line px-2.5 py-1 text-2xs text-ink-soft">
                    {perk}
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <section id="views" class="mt-20 scroll-mt-32">
      <h2 class="font-serif text-2xl font-bold text-ink">八種景觀名稱，不能只看「哪一區」</h2>
      <p class="mt-3 max-w-3xl text-[0.9375rem] leading-[1.9] text-ink-soft">
        海港區不等於港灣全景，威尼斯區也不等於運河景。真正的景觀承諾寫在房名最後一個括號；房名沒有景觀後綴，就沒有保證。
      </p>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          VIEWS.map((view) => (
            <article
              class:list={[
                'rounded-xl border p-5',
                view.key === 'harbour-grand'
                  ? 'border-brand/30 bg-brand-soft/50'
                  : 'border-line bg-card',
              ]}
            >
              <div class="flex items-baseline justify-between gap-2">
                <h3 class="font-serif text-base font-bold text-ink">{view.label}</h3>
                <span class="shrink-0 text-2xs text-ink-faint">
                  {ROOMS.filter((room) => room.view === view.key).length} 種
                </span>
              </div>
              <p class="mt-1 text-xs text-ink-faint">{view.labelJa}</p>
              <p class="mt-3 text-sm font-medium text-brand-deep">{view.summary}</p>
              <p class="mt-2.5 text-[0.8125rem] leading-[1.8] text-ink-soft">{view.detail}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="mt-20">
      <MiraCostaRoomIndex
        rooms={ROOMS}
        views={VIEWS}
        roomNumbers={ROOM_NUMBERS}
        blocks={NUMBER_BLOCKS}
        connecting={CONNECTING_PAIRS}
        sourceUrl="https://dhoteloo.com/%e3%83%9d%e3%83%ab%e3%83%88%e3%83%bb%e3%83%91%e3%83%a9%e3%83%87%e3%82%a3%e3%83%bc%e3%82%be%e3%83%bb%e3%82%b5%e3%82%a4%e3%83%89%e5%ae%a2%e5%ae%a4%e4%bd%8d%e7%bd%ae%e5%9b%b3%e3%80%90%e3%83%9f%e3%83%a9/"
      />
    </section>

    <section class="mt-20">
      <RoomExplorer
        rooms={ROOMS}
        categories={CATEGORIES}
        views={VIEWS}
        flags={FLAGS}
        rates={MONTHLY_RATES}
        roomNumbers={ROOM_NUMBERS}
        layouts={LAYOUTS}
        jpyPerTwd={HOTEL.jpyPerTwd}
        viewStyle={viewStyle}
        categoryStyle={categoryStyle}
        provenance="名稱依官方繁中頁，「・」之後是本站為拆開床型或定員所加。房號收錄海港區 {numbered} 間；托斯卡納與威尼斯區沒有可靠的逐間調查，故不填號碼。"
      />
    </section>

    <section class="mt-20">
      <PriceSeasons
        rooms={ROOMS}
        categories={CATEGORIES}
        rates={MONTHLY_RATES}
        currentYearMonths={RATE_YEAR_2026_MONTHS}
        years={{ current: '2026', carried: '2025' }}
        defaultRoomId="porto-superior-harbour-twin"
        source={{ label: 'CASTEL 的逐月費率表', url: 'https://castel.jp/p/5614' }}
        bargainNote="暑假同時有低價日和全年的高價日，能不能移動入住日期，比月份名稱更重要。"
      />
    </section>

    <section id="beds" class="mt-20 scroll-mt-32">
      <h2 class="font-serif text-2xl font-bold text-ink">床型尺寸</h2>
      <p class="mt-3 max-w-3xl text-[0.9375rem] leading-[1.9] text-ink-soft">
        「最多 4 位」常代表第四位要睡 84 × 182 公分的郵輪床；「頂樓陽台客房」的雙人床又比一般雙人床窄 20
        公分。人數上限相同，不代表四個人的睡眠品質相同。
      </p>
      <BedTable beds={BED_SPECS} caption={`${HOTEL.name}床型尺寸與可睡人數`} />
    </section>

    <section id="facilities" class="mt-20 scroll-mt-32">
      <h2 class="font-serif text-2xl font-bold text-ink">設施與園區動線</h2>
      <FacilityGrid facilities={FACILITIES} />
    </section>

    <section id="dining" class="mt-20 scroll-mt-32">
      <h2 class="font-serif text-2xl font-bold text-ink">餐廳</h2>
      <DiningList dining={DINING} />
    </section>

    <section id="benefits" class="mt-20 scroll-mt-32">
      <h2 class="font-serif text-2xl font-bold text-ink">住宿禮遇</h2>
      <BenefitList benefits={BENEFITS} />
    </section>

    <section id="faq" class="mt-20 scroll-mt-32">
      <h2 class="font-serif text-2xl font-bold text-ink">常見問題</h2>
      <FaqList faqs={FAQS} />
    </section>

    {
      article && (
        <section class="mt-20 rounded-2xl border border-line bg-paper-deep/50 p-7 sm:p-10">
          <h2 class="font-serif text-xl font-bold text-ink">資料都在這裡，選房邏輯在完整攻略</h2>
          <p class="mt-3 max-w-2xl text-[0.9375rem] leading-[1.9] text-ink-soft">
            完整攻略會把三區與四級海港景觀的價差拆開，說明房內看水上表演的限制、陽台與頂樓露天陽台的差別，以及歡樂入園和飯店通路該怎麼排進行程。
          </p>
          <a
            href={withBase(`/articles/${article.id}`)}
            class="mt-6 inline-flex items-center gap-2 rounded-full bg-brand px-6 py-3.5 text-sm font-medium text-white transition-colors hover:bg-brand-deep"
          >
            閱讀完整攻略 <span aria-hidden="true">→</span>
          </a>
        </section>
      )
    }
  </div>
</BaseLayout>
