---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import { articleLocale, articleSlug } from '~/content.config';
import BaseLayout from '~/layouts/BaseLayout.astro';
import ArticleCard from '~/components/ArticleCard.astro';
import { LOCALE_META, localeParams, localePath } from '~/i18n/config';
import { t } from '~/i18n/ui';
import { page } from '~/i18n/pages';
import { hotelCopy } from '~/i18n/hotel';
import { CATEGORY_LABELS } from '~/i18n/rooms';
import { CATEGORIES, ROOMS, roomsByCategory } from '~/data/tokyo-disneyland-hotel';

export const getStaticPaths = (() => localeParams()) satisfies GetStaticPaths;

const { locale } = Astro.props;
const ui = t(locale);
const copy = page(locale).home;
const hotel = hotelCopy(locale);

const articles = (await getCollection('articles'))
  .filter((article) => articleLocale(article.id) === locale)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const featured = articles.find((article) => article.data.featured) ?? articles[0];
const rest = articles.filter((article) => article.id !== featured?.id);

const principles = copy.method;

const upcoming = copy.pipeline;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: ui.site.name,
  alternateName: 'Trip Homework',
  description: ui.site.description,
  inLanguage: LOCALE_META[locale].htmlLang,
  url: new URL(localePath(locale, '/'), Astro.site ?? 'https://example.com').href,
};
---

<BaseLayout title={ui.site.name} description={ui.site.description} schema={schema} locale={locale} path="/">
  <section class="relative overflow-hidden border-b border-line">
    <div
      class="pointer-events-none absolute inset-0 opacity-70"
      style="background-image: radial-gradient(ellipse 60% 50% at 12% 0%, rgba(15,76,92,.13), transparent 60%), radial-gradient(ellipse 50% 45% at 92% 20%, rgba(180,131,44,.14), transparent 60%)"
      aria-hidden="true"
    >
    </div>

    <div class="relative mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
      <p class="text-2xs font-bold tracking-[0.28em] text-gold uppercase">
        Trip Homework
      </p>
      <h1
        class="mt-5 max-w-3xl font-serif text-[2.1rem] leading-[1.32] font-bold text-ink sm:text-5xl sm:leading-[1.28]"
      >
        {copy.heroLead}<br class="hidden sm:block" />{copy.heroTail}
      </h1>
      <p class="mt-7 max-w-2xl text-base leading-[1.95] text-ink-soft sm:text-lg">
        {copy.intro}
      </p>

      <div class="mt-10 flex flex-wrap gap-3">
        {
          featured && (
            <a
              href={localePath(locale, `/articles/${articleSlug(featured.id)}`)}
              class="inline-flex items-center gap-2 rounded-full bg-brand px-6 py-3.5 text-sm font-medium text-white transition-colors hover:bg-brand-deep"
            >
              {copy.ctaArticle}
              <span aria-hidden="true">→</span>
            </a>
          )
        }
        <a
          href={localePath(locale, '/hotels/tokyo-disneyland-hotel')}
          class="inline-flex items-center gap-2 rounded-full border border-line bg-card px-6 py-3.5 text-sm font-medium text-ink transition-colors hover:bg-paper-deep"
        >
          {copy.ctaDatabase}
        </a>
      </div>

      <dl class="mt-14 flex flex-wrap gap-x-12 gap-y-6 border-t border-line pt-8">
        <div>
          <dt class="text-2xs tracking-[0.16em] text-ink-faint uppercase">{copy.statRooms}</dt>
          <dd class="mt-1 font-serif text-2xl font-bold text-brand-deep">{copy.countRooms(ROOMS.length)}</dd>
        </div>
        <div>
          <dt class="text-2xs tracking-[0.16em] text-ink-faint uppercase">{copy.statArticles}</dt>
          <dd class="mt-1 font-serif text-2xl font-bold text-brand-deep">{copy.countArticles(articles.length)}</dd>
        </div>
        <div>
          <dt class="text-2xs tracking-[0.16em] text-ink-faint uppercase">{copy.statSources}</dt>
          <dd class="mt-1 font-serif text-2xl font-bold text-brand-deep">
            {copy.countSources(articles.reduce((sum, article) => sum + article.data.sources.length, 0))}
          </dd>
        </div>
      </dl>
    </div>
  </section>

  {
    featured && (
      <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
        <div class="flex items-baseline justify-between gap-4">
          <h2 class="font-serif text-xl font-bold text-ink sm:text-2xl">{copy.latest}</h2>
          <a
            href={localePath(locale, '/articles')}
            class="text-sm text-ink-soft transition-colors hover:text-brand"
          >
            {copy.allArticles}
          </a>
        </div>
        <div class="mt-6">
          <ArticleCard article={featured} featured locale={locale} />
        </div>

        {rest.length > 0 && (
          <div class="mt-6 grid gap-5 md:grid-cols-2">
            {rest.map((article) => (
              <ArticleCard article={article} locale={locale} />
            ))}
          </div>
        )}
      </section>
    )
  }

  <section class="border-y border-line bg-paper-deep/40">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
      <div class="grid gap-10 lg:grid-cols-[1fr_1.4fr] lg:gap-16">
        <div>
          <h2 class="font-serif text-xl font-bold text-ink sm:text-2xl">{copy.methodHeading}</h2>
          <p class="mt-4 text-[0.9375rem] leading-[1.95] text-ink-soft">
            {copy.methodIntro}
          </p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          {
            principles.map((principle, index) => (
              <div class="rounded-xl border border-line bg-card p-5">
                <span class="font-serif text-sm font-bold text-gold">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <h3 class="mt-2 font-serif text-[0.9375rem] font-bold text-ink">
                  {principle.title}
                </h3>
                <p class="mt-2 text-[0.8125rem] leading-[1.85] text-ink-soft">{principle.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
    <div
      class="overflow-hidden rounded-2xl border border-line bg-gradient-to-br from-brand-deep to-brand text-white"
    >
      <div class="grid gap-8 p-8 sm:p-12 lg:grid-cols-[1.3fr_1fr] lg:items-center">
        <div>
          <p class="text-2xs font-bold tracking-[0.22em] uppercase opacity-80">{copy.toolLabel}</p>
          <h2 class="mt-3 font-serif text-2xl leading-snug font-bold sm:text-3xl">
            {hotel.hotelName}{hotel.titleSuffix}
          </h2>
          <p class="mt-4 max-w-lg text-[0.9375rem] leading-[1.9] opacity-90">
            {hotel.heroIntro(ROOMS.length)}
          </p>
          <a
            href={localePath(locale, '/hotels/tokyo-disneyland-hotel')}
            class="mt-7 inline-flex items-center gap-2 rounded-full bg-white px-6 py-3.5 text-sm font-medium text-brand-deep transition-transform duration-300 hover:-translate-y-0.5"
          >
            {copy.toolCta} <span aria-hidden="true">→</span>
          </a>
        </div>
        <ul class="grid grid-cols-2 gap-px overflow-hidden rounded-xl bg-white/20">
          {
            CATEGORIES.map((category) => (
              <li class="bg-brand-deep/60 px-5 py-6 backdrop-blur-sm">
                <p class="text-2xs tracking-[0.14em] uppercase opacity-70">{CATEGORY_LABELS[locale][category.key]}</p>
                <p class="mt-1.5 font-serif text-xl font-bold">
                  {copy.countRooms(roomsByCategory(category.key).length)}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-20 sm:px-8">
    <h2 class="font-serif text-xl font-bold text-ink sm:text-2xl">{copy.pipelineHeading}</h2>
    <p class="mt-3 text-sm text-ink-soft">{copy.pipelineIntro}</p>
    <ol class="mt-6 divide-y divide-line overflow-hidden rounded-xl border border-line bg-card">
      {
        upcoming.map((item, index) => (
          <li class="flex flex-wrap items-baseline gap-x-4 gap-y-1 px-5 py-4">
            <span class="font-serif text-sm font-bold text-ink-faint tabular-nums">
              {String(index + 1).padStart(2, '0')}
            </span>
            <span class="font-serif text-[0.9375rem] font-bold text-ink">{item.title}</span>
            <span class="text-[0.8125rem] text-ink-soft">{item.body}</span>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>
