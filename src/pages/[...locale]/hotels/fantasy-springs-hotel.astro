---
import type { GetStaticPaths } from 'astro';
import { getEntry } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import HotelFacts from '~/components/HotelFacts.astro';
import ElevationMap from '~/components/ElevationMap.astro';
import SpringsElevation from '~/components/SpringsElevation.astro';
import SightlineMap from '~/components/SightlineMap.astro';
import RateTable from '~/components/RateTable.astro';
import RoomExplorer from '~/components/RoomExplorer.astro';
import BedTable from '~/components/BedTable.astro';
import FacilityGrid from '~/components/FacilityGrid.astro';
import DiningList from '~/components/DiningList.astro';
import BenefitList from '~/components/BenefitList.astro';
import FaqList from '~/components/FaqList.astro';
import { formatYen, lowestRate } from '~/data/hotel';
import { localeParams, localePath } from '~/i18n/config';
import { t } from '~/i18n/ui';
import { hotelCopy } from '~/i18n/hotel';
import { categoryLabel, names, viewLabel } from '~/i18n/rooms';
import { localizeHotelContent } from '~/i18n/content';
import {
  BED_SPECS,
  BENEFITS,
  CATEGORIES,
  DINING,
  FACILITIES,
  FAQS,
  FLAGS,
  HOTEL,
  ROOMS,
  VIEWS,
  roomsByCategory,
} from '~/data/fantasy-springs-hotel';
import { ROOM_NUMBERS as ROSE_ROOM_NUMBERS, ROSE_ROOM_COUNT } from '~/data/fsh-rose-court';
import { ROOM_NUMBERS as SPRINGS_ROOM_NUMBERS } from '~/data/fsh-springs-side';
import { LAYOUTS } from '~/data/fsh-room-layouts';

export const getStaticPaths = (() => localeParams()) satisfies GetStaticPaths;

const { locale } = Astro.props;
const ui = t(locale);
const copy = hotelCopy(locale, 'fsh');
const text = names('fsh');
const L = localizeHotelContent('fsh', locale);

const viewStyle = {
  grand: 'bg-brand text-white',
  park: 'bg-brand-soft text-brand-deep',
  partial: 'bg-gold-soft text-[#6f4e18]',
  none: 'bg-paper-deep text-ink-faint',
  allpark: 'bg-berry-soft text-berry',
};

const categoryStyle = {
  springs: 'border-brand/30 text-brand',
  rose: 'border-gold/40 text-gold',
  bay: 'border-line text-ink-soft',
  entrance: 'border-line text-ink-soft',
  grand: 'border-berry/30 text-berry',
};

const article = await getEntry('articles', `${locale}/fantasy-springs-hotel`);
const articlePath = localePath(locale, '/articles/fantasy-springs-hotel');

/**
 * The price list, the facility, dining, benefit and FAQ lists and the per-room
 * verdicts are editorial rather than official data and exist in Traditional
 * Chinese only, so the Japanese and English versions drop those sections rather
 * than show them untranslated; their guides cover the same ground in prose.
 */
const editorialOnly = ['rates', 'facilities', 'dining', 'benefits', 'faq'];
const sections = copy.sections.filter(
  (section) => locale === 'zh-hant' || !editorialOnly.includes(section.id),
);

const title = `${copy.hotelName}${copy.titleSuffix}`;
const description = copy.pageDescription(ROOMS.length, ROSE_ROOM_COUNT);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Hotel',
    name: copy.hotelName,
    alternateName: [HOTEL.nameEn, HOTEL.nameJa],
    description,
    url: HOTEL.officialUrl,
    numberOfRooms: HOTEL.totalRooms,
    checkinTime: HOTEL.checkIn,
    checkoutTime: HOTEL.checkOut,
    address: {
      '@type': 'PostalAddress',
      addressCountry: 'JP',
      addressRegion: HOTEL.region,
      addressLocality: HOTEL.locality,
    },
  },
  /* Only claim FAQ structured data where the answers are actually on the page. */
  ...(locale === 'zh-hant'
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'FAQPage',
          mainEntity: FAQS.map((faq) => ({
            '@type': 'Question',
            name: faq.question,
            acceptedAnswer: { '@type': 'Answer', text: faq.answer },
          })),
        },
      ]
    : []),
];
---

<BaseLayout
  title={title}
  description={description}
  schema={schema}
  locale={locale}
  path="/hotels/fantasy-springs-hotel"
>
  <header class="border-b border-line bg-gradient-to-br from-berry via-[#5a3a63] to-brand-deep text-white">
    <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-20">
      <nav class="flex items-center gap-2 text-xs opacity-80" aria-label={ui.common.breadcrumb}>
        <a href={localePath(locale, '/')} class="transition-opacity hover:opacity-100"
          >{ui.common.home}</a
        >
        <span aria-hidden="true">/</span>
        <a href={localePath(locale, '/hotels')} class="transition-opacity hover:opacity-100"
          >{copy.databaseLabel}</a
        >
      </nav>
      <p class="mt-8 text-2xs font-bold tracking-[0.22em] uppercase opacity-85">
        {copy.regionLabel}
      </p>
      <h1 class="mt-3 max-w-4xl font-serif text-3xl leading-tight font-bold sm:text-[2.6rem]">
        {copy.hotelName}<span class="block text-xl font-medium opacity-80 sm:text-2xl"
          >{copy.databaseLabel}</span
        >
      </h1>
      <p class="mt-5 max-w-2xl text-[0.9375rem] leading-[1.9] opacity-90">
        {copy.heroIntro(ROOMS.length)}
      </p>
      {
        article && (
          <a
            href={articlePath}
            class="mt-8 inline-flex items-center gap-2 rounded-full bg-white px-5 py-3 text-sm font-medium text-brand-deep transition-transform duration-300 hover:-translate-y-0.5"
          >
            {copy.readArticle} <span aria-hidden="true">→</span>
          </a>
        )
      }
    </div>
  </header>

  <nav
    class="sticky top-16 z-40 border-b border-line bg-paper/90 backdrop-blur-md"
    aria-label={ui.common.tableOfContents}
  >
    <div class="table-scroll mx-auto max-w-6xl px-5 sm:px-8">
      <ul class="flex gap-1 py-2.5 whitespace-nowrap">
        {
          sections.map((section) => (
            <li>
              <a
                href={`#${section.id}`}
                class="block rounded-full px-3.5 py-1.5 text-sm text-ink-soft transition-colors hover:bg-paper-deep hover:text-ink"
              >
                {section.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>

  <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-16">
    <section id="overview" class="scroll-mt-32">
      <h2 class="font-serif text-2xl font-bold text-ink">{copy.headings.overview}</h2>
      <HotelFacts
        facts={copy.facts({
          rooms: HOTEL.totalRooms,
          types: ROOMS.length,
          from: formatYen(lowestRate(ROOMS)),
        })}
      />
      <p class="text-sm leading-relaxed text-ink-faint">{copy.provenance}</p>
    </section>

    <section id="sides" class="mt-20 scroll-mt-32">
      <h2 class="font-serif text-2xl font-bold text-ink">{copy.headings.sides}</h2>
      <p class="mt-3 max-w-3xl text-[0.9375rem] leading-[1.9] text-ink-soft">
        {copy.categoriesIntro}
      </p>
      <figure class="mt-6 overflow-hidden rounded-xl border border-line bg-white">
        <img
          src={HOTEL.sideMap[locale]}
          width={HOTEL.sideMapSize.width}
          height={HOTEL.sideMapSize.height}
          loading="lazy"
          decoding="async"
          referrerpolicy="no-referrer"
          alt={title}
          class="block h-auto w-full"
        />
        <figcaption class="border-t border-line px-4 py-2.5 text-2xs text-ink-faint">
          <a
            href={HOTEL.rooms[locale]}
            rel="noopener nofollow"
            target="_blank"
            class="text-brand underline decoration-brand/30 underline-offset-2 hover:text-gold"
          >
            {HOTEL.nameEn}
          </a>
        </figcaption>
      </figure>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {
          CATEGORIES.map((category) => (
            <article class="rounded-xl border border-line bg-card p-5">
              <div class="flex items-baseline justify-between gap-3">
                <h3 class="font-serif text-base font-bold text-ink">
                  {categoryLabel('fsh', locale, category.key)}
                </h3>
                <span class="rounded-full bg-paper-deep px-2.5 py-1 text-2xs text-ink-soft">
                  {copy.typeCount(roomsByCategory(category.key).length)}
                </span>
              </div>
              {locale !== 'en' && <p class="mt-1 text-xs text-ink-faint">{category.labelEn}</p>}
              <p class="mt-3 text-[0.875rem] leading-[1.85] text-ink-soft">
                {text.categorySummary[locale][category.key] ?? category.summary}
              </p>
              <ul class="mt-3 flex flex-wrap gap-1.5">
                {(text.categoryPerks[locale][category.key] ?? category.perks).map((perk) => (
                  <li class="rounded-full border border-line px-2.5 py-1 text-2xs text-ink-soft">
                    {perk}
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <section id="views" class="mt-20 scroll-mt-32">
      <h2 class="font-serif text-2xl font-bold text-ink">{copy.headings.views}</h2>
      <p class="mt-3 max-w-3xl text-[0.9375rem] leading-[1.9] text-ink-soft">{copy.viewsIntro}</p>
      <div class="mt-6 grid gap-4 lg:grid-cols-3">
        {
          VIEWS.map((view) => (
            <article
              class:list={[
                'rounded-xl border p-5',
                view.key === 'grand' ? 'border-brand/30 bg-brand-soft/50' : 'border-line bg-card',
              ]}
            >
              <div class="flex items-baseline justify-between gap-2">
                <h3 class="font-serif text-base font-bold text-ink">
                  {viewLabel('fsh', locale, view.key)}
                </h3>
                <span class="text-2xs whitespace-nowrap text-ink-faint">
                  {copy.typeCount(ROOMS.filter((room) => room.view === view.key).length)}
                </span>
              </div>
              <p class="mt-1 text-xs text-ink-faint">
                {view.labelJa}／{view.labelEn}
              </p>
              <p class="mt-3 text-sm font-medium text-brand-deep">
                {text.viewSummary[locale][view.key] ?? view.summary}
              </p>
              <p class="mt-2.5 text-[0.875rem] leading-[1.85] text-ink-soft">
                {text.viewDetail[locale][view.key] ?? view.detail}
              </p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="mt-20">
      <SightlineMap locale={locale} />
      <div class="mt-14">
        <ElevationMap locale={locale} />
      </div>
    </section>

    <section class="mt-20">
      <SpringsElevation locale={locale} />
    </section>

    <section class="mt-20">
      <RoomExplorer
        hotel="fsh"
        rooms={L.rooms(ROOMS)}
        categories={CATEGORIES}
        views={VIEWS}
        flags={FLAGS}
        rates={{}}
        roomNumbers={{ ...ROSE_ROOM_NUMBERS, ...SPRINGS_ROOM_NUMBERS }}
        layouts={LAYOUTS}
        viewStyle={viewStyle}
        categoryStyle={categoryStyle}
        provenance={copy.explorerProvenance}
        locale={locale}
      />
    </section>

    {
      locale === 'zh-hant' && (
        <section class="mt-20">
          <RateTable />
        </section>
      )
    }

    <section id="beds" class="mt-20 scroll-mt-32">
      <h2 class="font-serif text-2xl font-bold text-ink">{copy.headings.beds}</h2>
      <p class="mt-3 max-w-3xl text-[0.9375rem] leading-[1.9] text-ink-soft">{copy.bedsIntro}</p>
      <BedTable beds={L.beds(BED_SPECS)} caption={copy.bedTableCaption} locale={locale} />
    </section>

    {
      locale === 'zh-hant' && (
        <>
          <section id="facilities" class="mt-20 scroll-mt-32">
            <h2 class="font-serif text-2xl font-bold text-ink">{copy.headings.facilities}</h2>
            <FacilityGrid facilities={FACILITIES} guestOnlyLabel={L.label('住客限定')} />
          </section>

          <section id="dining" class="mt-20 scroll-mt-32">
            <h2 class="font-serif text-2xl font-bold text-ink">{copy.headings.dining}</h2>
            <DiningList dining={DINING} />
          </section>

          <section id="benefits" class="mt-20 scroll-mt-32">
            <h2 class="font-serif text-2xl font-bold text-ink">{copy.headings.benefits}</h2>
            <BenefitList benefits={BENEFITS} />
          </section>

          <section id="faq" class="mt-20 scroll-mt-32">
            <h2 class="font-serif text-2xl font-bold text-ink">{copy.headings.faq}</h2>
            <FaqList faqs={FAQS} />
          </section>
        </>
      )
    }

    {
      article && (
        <section class="mt-20 rounded-2xl border border-line bg-paper-deep/50 p-7 sm:p-10">
          <h2 class="font-serif text-xl font-bold text-ink">{copy.articleTeaseHeading}</h2>
          <p class="mt-3 max-w-2xl text-[0.9375rem] leading-[1.9] text-ink-soft">
            {copy.articleTease}
          </p>
          <a
            href={articlePath}
            class="mt-6 inline-flex items-center gap-2 rounded-full bg-brand px-6 py-3.5 text-sm font-medium text-white transition-colors hover:bg-brand-deep"
          >
            {copy.readArticle} <span aria-hidden="true">→</span>
          </a>
        </section>
      )
    }
  </div>
</BaseLayout>
