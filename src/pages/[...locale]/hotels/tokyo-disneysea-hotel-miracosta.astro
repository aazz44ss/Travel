---
import type { GetStaticPaths } from 'astro';
import { getEntry } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import HotelFacts from '~/components/HotelFacts.astro';
import PriceSeasons from '~/components/PriceSeasons.astro';
import RoomExplorer from '~/components/RoomExplorer.astro';
import MiraCostaRoomIndex from '~/components/MiraCostaRoomIndex.astro';
import BedTable from '~/components/BedTable.astro';
import FacilityGrid from '~/components/FacilityGrid.astro';
import DiningList from '~/components/DiningList.astro';
import BenefitList from '~/components/BenefitList.astro';
import FaqList from '~/components/FaqList.astro';
import { formatYen } from '~/data/hotel';
import { localeParams, localePath } from '~/i18n/config';
import { t } from '~/i18n/ui';
import { hotelCopy } from '~/i18n/hotel';
import { localizeHotelContent } from '~/i18n/content';
import { categoryLabel, names, viewLabel } from '~/i18n/rooms';
import {
  BED_SPECS,
  BENEFITS,
  CATEGORIES,
  DINING,
  FACILITIES,
  FAQS,
  FLAGS,
  HOTEL,
  ROOMS,
  VIEWS,
  roomsByCategory,
  cheapestRoom,
} from '~/data/tokyo-disneysea-hotel-miracosta';
import { MONTHLY_RATES, RATE_YEAR_2026_MONTHS } from '~/data/dhm-rates';
import { CONNECTING_PAIRS, KNOWN_ROOM_NUMBERS, NUMBER_BLOCKS, ROOM_NUMBERS } from '~/data/dhm-room-numbers';
import { LAYOUTS } from '~/data/dhm-room-layouts';

export const getStaticPaths = (() => localeParams()) satisfies GetStaticPaths;

const { locale } = Astro.props;
const ui = t(locale);
const copy = hotelCopy(locale, 'dhm');
const L = localizeHotelContent('dhm', locale);
const text = names('dhm');

const viewStyle = {
  'harbour-grand': 'bg-brand-deep text-white',
  harbour: 'bg-brand text-white',
  'piazza-grand': 'bg-brand-soft text-brand-deep',
  piazza: 'bg-gold-soft text-[#6f4e18]',
  canal: 'bg-berry-soft text-berry',
  aqua: 'bg-[#e4f2f7] text-[#285f72]',
  partial: 'bg-paper-deep text-ink-soft',
  none: 'bg-paper-deep text-ink-faint',
};

const categoryStyle = {
  tuscany: 'border-line text-ink-soft',
  venice: 'border-berry/30 text-berry',
  porto: 'border-brand/30 text-brand',
  speciale: 'border-gold/40 text-gold',
};

const article = await getEntry('articles', `${locale}/tokyo-disneysea-hotel-miracosta`);
const articlePath = localePath(locale, '/articles/tokyo-disneysea-hotel-miracosta');

/**
 * The rate analysis, the facility, dining, benefit and FAQ lists and the
 * per-room verdicts are editorial rather than official data and exist in
 * Traditional Chinese only, so the Japanese and English versions drop those
 * sections rather than show them untranslated; their guides cover the same
 * ground in prose.
 */
const sections = copy.sections;

const title = `${copy.hotelName}${copy.titleSuffix}`;
const description = copy.pageDescription(ROOMS.length, KNOWN_ROOM_NUMBERS.length);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Hotel',
    name: copy.hotelName,
    alternateName: [HOTEL.nameEn, HOTEL.nameJa],
    description,
    url: HOTEL.officialUrl,
    numberOfRooms: HOTEL.totalRooms,
    checkinTime: HOTEL.checkIn,
    checkoutTime: HOTEL.checkOut,
    address: {
      '@type': 'PostalAddress',
      addressCountry: 'JP',
      addressRegion: HOTEL.region,
      addressLocality: HOTEL.locality,
    },
  },
  /* Only claim FAQ structured data where the answers are actually on the page. */
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: L.faqs(FAQS).map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  },
];
---

<BaseLayout
  title={title}
  description={description}
  schema={schema}
  locale={locale}
  path="/hotels/tokyo-disneysea-hotel-miracosta"
>
  <header
    class="border-b border-line bg-gradient-to-br from-[#3b1822] via-berry to-[#9a6840] text-white"
  >
    <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-20">
      <nav class="flex items-center gap-2 text-xs opacity-80" aria-label={ui.common.breadcrumb}>
        <a href={localePath(locale, '/')} class="transition-opacity hover:opacity-100"
          >{ui.common.home}</a
        >
        <span aria-hidden="true">/</span>
        <a href={localePath(locale, '/hotels')} class="transition-opacity hover:opacity-100"
          >{copy.databaseLabel}</a
        >
      </nav>
      <p class="mt-8 text-2xs font-bold tracking-[0.22em] uppercase opacity-85">
        {copy.regionLabel}
      </p>
      <h1 class="mt-3 max-w-4xl font-serif text-3xl leading-tight font-bold sm:text-[2.6rem]">
        {copy.hotelName}<span class="block text-xl font-medium opacity-80 sm:text-2xl"
          >{copy.databaseLabel}</span
        >
      </h1>
      <p class="mt-5 max-w-2xl text-[0.9375rem] leading-[1.9] opacity-90">
        {copy.heroIntro(ROOMS.length)}
      </p>
      {
        article && (
          <a
            href={articlePath}
            class="mt-8 inline-flex items-center gap-2 rounded-full bg-white px-5 py-3 text-sm font-medium text-[#5f1f31] transition-transform duration-300 hover:-translate-y-0.5"
          >
            {copy.readArticle} <span aria-hidden="true">→</span>
          </a>
        )
      }
    </div>
  </header>

  <nav
    class="sticky top-16 z-40 border-b border-line bg-paper/90 backdrop-blur-md"
    aria-label={ui.common.tableOfContents}
  >
    <div class="table-scroll mx-auto max-w-6xl px-5 sm:px-8">
      <ul class="flex gap-1 py-2.5 whitespace-nowrap">
        {
          sections.map((section) => (
            <li>
              <a
                href={`#${section.id}`}
                class="block rounded-full px-3.5 py-1.5 text-sm text-ink-soft transition-colors hover:bg-paper-deep hover:text-ink"
              >
                {section.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>

  <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-16">
    <section id="overview" class="scroll-mt-32">
      <h2 class="font-serif text-2xl font-bold text-ink">{copy.headings.overview}</h2>
      <HotelFacts
        facts={copy.facts({
          rooms: HOTEL.totalRooms,
          types: ROOMS.length,
          from: formatYen(cheapestRoom().priceFrom),
        })}
      />
      <p class="text-sm leading-relaxed text-ink-faint">{copy.provenance}</p>
    </section>

    <section id="categories" class="mt-20 scroll-mt-32">
      <h2 class="font-serif text-2xl font-bold text-ink">{copy.headings.categories}</h2>
      <p class="mt-3 max-w-3xl text-[0.9375rem] leading-[1.9] text-ink-soft">
        {copy.categoriesIntro}
      </p>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {
          CATEGORIES.map((category) => (
            <article class="rounded-xl border border-line bg-card p-5">
              <div class="flex items-baseline justify-between gap-3">
                <h3 class="font-serif text-base font-bold text-ink">
                  {categoryLabel('dhm', locale, category.key)}
                </h3>
                <span class="rounded-full bg-paper-deep px-2.5 py-1 text-2xs text-ink-soft">
                  {copy.typeCount(roomsByCategory(category.key).length)}
                </span>
              </div>
              {locale !== 'en' && <p class="mt-1 text-xs text-ink-faint">{category.labelEn}</p>}
              <p class="mt-3 text-[0.875rem] leading-[1.85] text-ink-soft">
                {text.categorySummary[locale][category.key]}
              </p>
              <ul class="mt-3 flex flex-wrap gap-1.5">
                {text.categoryPerks[locale][category.key]!.map((perk) => (
                  <li class="rounded-full border border-line px-2.5 py-1 text-2xs text-ink-soft">
                    {perk}
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <section id="views" class="mt-20 scroll-mt-32">
      <h2 class="font-serif text-2xl font-bold text-ink">{copy.headings.views}</h2>
      <p class="mt-3 max-w-3xl text-[0.9375rem] leading-[1.9] text-ink-soft">{copy.viewsIntro}</p>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          VIEWS.map((view) => (
            <article
              class:list={[
                'rounded-xl border p-5',
                view.key === 'harbour-grand'
                  ? 'border-brand/30 bg-brand-soft/50'
                  : 'border-line bg-card',
              ]}
            >
              <div class="flex items-baseline justify-between gap-2">
                <h3 class="font-serif text-base font-bold text-ink">
                  {viewLabel('dhm', locale, view.key)}
                </h3>
                <span class="shrink-0 text-2xs text-ink-faint">
                  {copy.typeCount(ROOMS.filter((room) => room.view === view.key).length)}
                </span>
              </div>
              {locale !== 'ja' && <p class="mt-1 text-xs text-ink-faint">{view.labelJa}</p>}
              <p class="mt-3 text-sm font-medium text-brand-deep">
                {text.viewSummary[locale][view.key]}
              </p>
              <p class="mt-2.5 text-[0.8125rem] leading-[1.8] text-ink-soft">
                {locale === 'zh-hant' ? view.detail : text.viewDetail[locale][view.key]}
              </p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="mt-20">
      <MiraCostaRoomIndex
        rooms={L.rooms(ROOMS)}
        views={VIEWS}
        roomNumbers={ROOM_NUMBERS}
        blocks={NUMBER_BLOCKS}
        connecting={CONNECTING_PAIRS}
        locale={locale}
        sourceUrl="https://dhoteloo.com/%e3%83%9d%e3%83%ab%e3%83%88%e3%83%bb%e3%83%91%e3%83%a9%e3%83%87%e3%82%a3%e3%83%bc%e3%82%be%e3%83%bb%e3%82%b5%e3%82%a4%e3%83%89%e5%ae%a2%e5%ae%a4%e4%bd%8d%e7%bd%ae%e5%9b%b3%e3%80%90%e3%83%9f%e3%83%a9/"
      />
    </section>

    <section class="mt-20">
      <RoomExplorer
        hotel="dhm"
        rooms={L.rooms(ROOMS)}
        categories={CATEGORIES}
        views={VIEWS}
        flags={FLAGS}
        rates={MONTHLY_RATES}
        roomNumbers={ROOM_NUMBERS}
        layouts={LAYOUTS}
        viewStyle={viewStyle}
        categoryStyle={categoryStyle}
        provenance={copy.explorerProvenance}
        locale={locale}
      />
    </section>

      <section class="mt-20">
        <PriceSeasons
      rooms={L.rooms(ROOMS)}
      categories={CATEGORIES}
      rates={MONTHLY_RATES}
      currentYearMonths={RATE_YEAR_2026_MONTHS}
      years={{ current: '2026', carried: '2025' }}
      defaultRoomId="porto-superior-harbour-twin"
      source={{ label: copy.rateSourceLabel, url: 'https://castel.jp/p/5614' }}
          bargainNote={copy.bargainNote}
          locale={locale}
          hotel="dhm"
        />
      </section>

    <section id="beds" class="mt-20 scroll-mt-32">
      <h2 class="font-serif text-2xl font-bold text-ink">{copy.headings.beds}</h2>
      <p class="mt-3 max-w-3xl text-[0.9375rem] leading-[1.9] text-ink-soft">{copy.bedsIntro}</p>
      <BedTable
        beds={L.beds(BED_SPECS)}
        caption={`${copy.hotelName}${copy.bedTableCaption}`}
        locale={locale}
      />
    </section>

        <section id="facilities" class="mt-20 scroll-mt-32">
          <h2 class="font-serif text-2xl font-bold text-ink">{copy.headings.facilities}</h2>
          <FacilityGrid facilities={L.facilities(FACILITIES)} guestOnlyLabel={L.label('住客限定')} />
        </section>

        <section id="dining" class="mt-20 scroll-mt-32">
          <h2 class="font-serif text-2xl font-bold text-ink">{copy.headings.dining}</h2>
          <DiningList dining={L.dining(DINING)} />
        </section>

        <section id="benefits" class="mt-20 scroll-mt-32">
          <h2 class="font-serif text-2xl font-bold text-ink">{copy.headings.benefits}</h2>
          <BenefitList benefits={L.benefits(BENEFITS)} />
        </section>

        <section id="faq" class="mt-20 scroll-mt-32">
          <h2 class="font-serif text-2xl font-bold text-ink">{copy.headings.faq}</h2>
          <FaqList faqs={L.faqs(FAQS)} />
        </section>

    {
      article && (
        <section class="mt-20 rounded-2xl border border-line bg-paper-deep/50 p-7 sm:p-10">
          <h2 class="font-serif text-xl font-bold text-ink">{copy.articleTeaseHeading}</h2>
          <p class="mt-3 max-w-2xl text-[0.9375rem] leading-[1.9] text-ink-soft">
            {copy.articleTease}
          </p>
          <a
            href={articlePath}
            class="mt-6 inline-flex items-center gap-2 rounded-full bg-brand px-6 py-3.5 text-sm font-medium text-white transition-colors hover:bg-brand-deep"
          >
            {copy.readArticle} <span aria-hidden="true">→</span>
          </a>
        </section>
      )
    }
  </div>
</BaseLayout>
