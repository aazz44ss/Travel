---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { localeParams, localePath } from '~/i18n/config';
import { t } from '~/i18n/ui';
import { hotelCopy, hotelIndexCopy, type HotelKey } from '~/i18n/hotel';
import {
  CATEGORIES as TDH_CATEGORIES,
  ROOMS as TDH_ROOMS,
} from '~/data/tokyo-disneyland-hotel';
import {
  CATEGORIES as DHM_CATEGORIES,
  ROOMS as DHM_ROOMS,
} from '~/data/tokyo-disneysea-hotel-miracosta';

export const getStaticPaths = (() => localeParams()) satisfies GetStaticPaths;

const { locale } = Astro.props;
const ui = t(locale);
const copy = hotelIndexCopy(locale);

/** Newest hotel first, which is also the order the cards are written for. */
const hotels: {
  key: HotelKey;
  slug: string;
  rooms: typeof TDH_ROOMS;
  categories: typeof TDH_CATEGORIES;
  gradient: string;
}[] = [
  {
    key: 'dhm',
    slug: 'tokyo-disneysea-hotel-miracosta',
    rooms: DHM_ROOMS,
    categories: DHM_CATEGORIES,
    gradient: 'from-[#4c1826] via-berry to-[#9a6840]',
  },
  {
    key: 'tdh',
    slug: 'tokyo-disneyland-hotel',
    rooms: TDH_ROOMS,
    categories: TDH_CATEGORIES,
    gradient: 'from-brand-deep to-brand',
  },
];

const cards = hotels.map((hotel) => ({
  ...hotel,
  hotelCopy: hotelCopy(locale, hotel.key),
  card: copy.cards[hotel.key],
}));

const totalTypes = hotels.reduce((sum, hotel) => sum + hotel.rooms.length, 0);
const description = copy.intro(hotels.length, totalTypes);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: copy.heading,
  description,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: cards.map((entry, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: entry.hotelCopy.hotelName,
      url: new URL(
        localePath(locale, `/hotels/${entry.slug}`),
        Astro.site ?? 'https://example.com',
      ).href,
    })),
  },
};
---

<BaseLayout
  title={copy.heading}
  description={description}
  schema={schema}
  locale={locale}
  path="/hotels"
>
  <header class="border-b border-line bg-paper-deep/40">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
      <nav class="flex items-center gap-2 text-xs text-ink-faint" aria-label={ui.common.breadcrumb}>
        <a href={localePath(locale, '/')} class="transition-colors hover:text-brand"
          >{ui.common.home}</a
        >
        <span aria-hidden="true">/</span>
        <span>{copy.heading}</span>
      </nav>
      <p class="mt-8 text-2xs font-bold tracking-[0.22em] text-gold uppercase">{copy.kicker}</p>
      <h1 class="mt-3 font-serif text-3xl font-bold text-ink sm:text-4xl">{copy.heading}</h1>
      <p class="mt-4 max-w-2xl text-[0.9375rem] leading-[1.95] text-ink-soft">{description}</p>
      <dl class="mt-9 flex flex-wrap gap-x-12 gap-y-5 border-t border-line pt-6">
        <div>
          <dt class="text-2xs tracking-[0.14em] text-ink-faint uppercase">{copy.statHotels}</dt>
          <dd class="mt-1 font-serif text-2xl font-bold text-brand-deep">{hotels.length}</dd>
        </div>
        <div>
          <dt class="text-2xs tracking-[0.14em] text-ink-faint uppercase">{copy.statTypes}</dt>
          <dd class="mt-1 font-serif text-2xl font-bold text-brand-deep">{totalTypes}</dd>
        </div>
        <div>
          <dt class="text-2xs tracking-[0.14em] text-ink-faint uppercase">{copy.statPrinciple}</dt>
          <dd class="mt-1 font-serif text-lg font-bold text-brand-deep">
            {copy.statPrincipleValue}
          </dd>
        </div>
      </dl>
    </div>
  </header>

  <main class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-16">
    <div class="grid gap-7 lg:grid-cols-2">
      {
        cards.map((entry) => (
          <article class="flex h-full flex-col overflow-hidden rounded-2xl border border-line bg-card">
            <div class:list={['bg-gradient-to-br p-7 text-white sm:p-8', entry.gradient]}>
              <p class="text-2xs font-bold tracking-[0.18em] uppercase opacity-75">
                {entry.card.kicker}
              </p>
              <h2 class="mt-3 font-serif text-2xl leading-snug font-bold">
                {entry.hotelCopy.hotelName}
              </h2>
              <p class="mt-4 text-sm leading-[1.9] opacity-90">{entry.card.description}</p>
            </div>

            <div class="flex flex-1 flex-col p-7 sm:p-8">
              <ul class="grid grid-cols-2 gap-2">
                {entry.card.facts.map((fact) => (
                  <li class="rounded-lg bg-paper-deep/60 px-3 py-2.5 text-xs font-medium text-ink-soft">
                    {fact}
                  </li>
                ))}
              </ul>

              <dl class="mt-6 grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-line bg-line">
                {entry.categories.map((category) => (
                  <div class="bg-card px-4 py-4">
                    <dt class="text-2xs leading-snug text-ink-faint">{category.label}</dt>
                    <dd class="mt-1 font-serif text-lg font-bold text-ink">
                      {entry.hotelCopy.typeCount(
                        entry.rooms.filter((room) => room.category === category.key).length,
                      )}
                    </dd>
                  </div>
                ))}
              </dl>

              <div class="mt-auto flex flex-wrap gap-2 pt-7">
                <a
                  href={localePath(locale, `/hotels/${entry.slug}`)}
                  class="inline-flex items-center gap-2 rounded-full bg-brand px-5 py-3 text-sm font-medium text-white transition-colors hover:bg-brand-deep"
                >
                  {copy.openDatabase} <span aria-hidden="true">→</span>
                </a>
                <a
                  href={localePath(locale, `/articles/${entry.slug}`)}
                  class="inline-flex items-center rounded-full border border-line px-5 py-3 text-sm font-medium text-ink-soft transition-colors hover:bg-paper-deep hover:text-ink"
                >
                  {copy.readArticle}
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <p class="mt-10 text-sm leading-relaxed text-ink-faint">{copy.countNote}</p>
  </main>
</BaseLayout>
