---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import { articleLocale, articleSlug } from '~/content.config';
import ArticleLayout from '~/layouts/ArticleLayout.astro';
import { DEFAULT_LOCALE } from '~/i18n/config';

/**
 * One route for every locale of every article. A translation is a file with the
 * same name under a different locale directory, so the slug is shared and the
 * language switcher can move between them without a lookup table.
 */
export const getStaticPaths = (async () => {
  const articles = await getCollection('articles');
  return articles.map((article) => {
    const locale = articleLocale(article.id);
    return {
      params: {
        locale: locale === DEFAULT_LOCALE ? undefined : locale,
        slug: articleSlug(article.id),
      },
      props: { article, locale },
    };
  });
}) satisfies GetStaticPaths;

const { article, locale } = Astro.props;
const { Content, headings } = await render(article);
---

<ArticleLayout article={article} headings={headings} locale={locale}>
  <Content />
</ArticleLayout>
